diff --git a/lk2nd/hw/bdev/mmc_sdhci.c b/lk2nd/hw/bdev/mmc_sdhci.c
index 730a9c3..3d20eb7 100644
--- a/lk2nd/hw/bdev/mmc_sdhci.c
+++ b/lk2nd/hw/bdev/mmc_sdhci.c
@@ -55,6 +55,30 @@ static ssize_t lk2nd_mmc_sdhci_bdev_read_block(struct bdev *bdev, void *buf, bnu
 	return count * block_size;
 }
 
+/* Cheip OS: scrittura sulla microSD per l'installer via fastboot */
+static ssize_t lk2nd_mmc_sdhci_bdev_write_block(struct bdev *bdev, const void *buf, bnum_t block, uint count)
+{
+	struct mmc_bdev *dev = container_of(bdev, struct mmc_bdev, dev);
+	uint32_t block_size = dev->dev.block_size;
+	uint32_t max = SDHCI_ADMA_MAX_TRANS_SZ / block_size;
+	uint8_t *sptr = (uint8_t *)buf;
+	uint64_t blk = block;
+	uint left = count;
+
+	arch_clean_invalidate_cache_range((addr_t)buf, count * block_size);
+
+	while (left) {
+		uint n = left > max ? max : left;
+		if (mmc_sdhci_write(dev->mmc, sptr, blk, n))
+			return ERR_IO;
+		sptr += n * block_size;
+		blk += n;
+		left -= n;
+	}
+
+	return count * block_size;
+}
+
 void lk2nd_mmc_sdhci_bio_register(void)
 {
 	struct mmc_bdev *bdev = malloc(sizeof(*bdev));
