diff --git a/lk2nd/fastboot/cheip.c b/lk2nd/fastboot/cheip.c
new file mode 100644
index 0000000..6d38d67
--- /dev/null
+++ b/lk2nd/fastboot/cheip.c
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Cheip OS: installazione sulla microSD interna dal sito, via WebUSB fastboot */
+
+#include <debug.h>
+#include <fastboot.h>
+#include <lib/bio.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <lk2nd/hw/bdev.h>
+
+static bdev_t *sd_open(void)
+{
+	static bool init_done;
+	bdev_t *b = bio_open("mmc2");
+
+	if (!b && !init_done) {
+		init_done = true;
+		lk2nd_bdev_init();
+		b = bio_open("mmc2");
+	}
+	return b;
+}
+
+/* fastboot oem sd-info  ->  "<blocchi> <dimensione blocco>" */
+static void cmd_oem_sd_info(const char *arg, void *data, unsigned sz)
+{
+	char resp[64];
+	bdev_t *b = sd_open();
+
+	if (!b) {
+		fastboot_fail("no sd card");
+		return;
+	}
+	snprintf(resp, sizeof(resp), "%u %u", (unsigned)b->block_count, (unsigned)b->block_size);
+	bio_close(b);
+	fastboot_info(resp);
+	fastboot_okay(resp);
+}
+FASTBOOT_REGISTER("oem sd-info", cmd_oem_sd_info);
+
+/* fastboot oem sd-write <settore esadecimale>: scrive i dati scaricati */
+static void cmd_oem_sd_write(const char *arg, void *data, unsigned sz)
+{
+	unsigned long sector;
+	unsigned count;
+	bdev_t *b;
+	ssize_t ret;
+
+	while (*arg == ' ')
+		arg++;
+	if (!*arg || !sz) {
+		fastboot_fail("usage: download, then oem sd-write <sector-hex>");
+		return;
+	}
+	sector = strtoul(arg, NULL, 16);
+
+	b = sd_open();
+	if (!b) {
+		fastboot_fail("no sd card");
+		return;
+	}
+
+	count = (sz + b->block_size - 1) / b->block_size;
+	if (count * b->block_size != sz)
+		memset((uint8_t *)data + sz, 0, count * b->block_size - sz);
+
+	if (sector + count > b->block_count) {
+		bio_close(b);
+		fastboot_fail("beyond end of sd card");
+		return;
+	}
+
+	ret = bio_write_block(b, data, sector, count);
+	bio_close(b);
+
+	if (ret != (ssize_t)(count * b->block_size)) {
+		fastboot_fail("sd write failed");
+		return;
+	}
+	fastboot_okay("");
+}
+FASTBOOT_REGISTER("oem sd-write", cmd_oem_sd_write);
