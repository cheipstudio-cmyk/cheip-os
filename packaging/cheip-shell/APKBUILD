# Maintainer: Eugenio Casale <cheipstudio@gmail.com>
pkgname=cheip-shell
pkgver=0.3.0
pkgrel=0
pkgdesc="Shell di Cheip OS: home, controlli, app di sistema, OTA"
url="https://cheipstudio.org"
arch="armv7 aarch64 x86_64"
license="GPL-3.0-or-later"
depends="cloud-utils-growpart e2fsprogs-extra lsblk findmnt doas mesa-dri-gallium mesa-egl mesa-gbm mesa-utils busybox-extras networkmanager-cli util-linux-misc modemmanager bluez alsa-utils
	gst-plugins-base gst-plugins-good gst-libav mupdf-tools"
makedepends="linux-firmware-qcom cargo eudev-dev libinput-dev libdrm-dev mesa-dev libxkbcommon-dev fontconfig-dev libseat-dev
	gstreamer-dev gst-plugins-base-dev"
install="$pkgname.post-install"
options="net"
# Il tarball lo crea la CI con git archive dal tag
source="cheip-os-$pkgver.tar.gz"
builddir="$srcdir/cheip-os-$pkgver"

prepare() {
	default_prepare
	cd shell
	cargo fetch --locked
}

build() {
	cd shell
	cargo build --frozen --release --no-default-features --features device --bin cheip-shell
}

check() {
	cd shell
	cargo test --frozen --release --no-default-features --features device --lib
}

package() {
	install -Dm755 shell/target/release/cheip-shell "$pkgdir"/usr/bin/cheip-shell
	install -Dm755 system/cheip-session "$pkgdir"/usr/libexec/cheip/cheip-session
	install -Dm755 system/cheip-helper "$pkgdir"/usr/libexec/cheip/cheip-helper
	install -Dm755 system/cheip-preinstall "$pkgdir"/usr/libexec/cheip/cheip-preinstall
	install -Dm755 system/cheip-shell.initd "$pkgdir"/etc/init.d/cheip-shell
	install -Dm755 system/cheip-bootcheck "$pkgdir"/etc/init.d/cheip-bootcheck
	install -Dm755 system/cheip-firmware "$pkgdir"/usr/libexec/cheip/cheip-firmware
	install -Dm755 system/cheip-firmware.initd "$pkgdir"/etc/init.d/cheip-firmware
	install -Dm755 system/cheip-usb "$pkgdir"/usr/libexec/cheip/cheip-usb
	install -Dm755 system/cheip-usb.initd "$pkgdir"/etc/init.d/cheip-usb
	install -Dm755 system/cheip-gpu "$pkgdir"/usr/libexec/cheip/cheip-gpu
	install -Dm644 system/www/index.html "$pkgdir"/usr/share/cheip/www/index.html
	install -Dm755 system/cheip-report "$pkgdir"/usr/libexec/cheip/cheip-report
	install -Dm644 system/cheip-gpu.modprobe "$pkgdir"/etc/modprobe.d/cheip-gpu.conf
	# Adreno 305B microcode (the A305B uses the A330 one). In firmware/updates so
	# it never clashes with a linux-firmware package in the image
	for f in a330_pm4.fw a330_pfp.fw; do
		src=$(ls /lib/firmware/qcom/$f* 2>/dev/null | head -n 1)
		if [ -n "$src" ]; then
			install -Dm644 "$src" "$pkgdir"/lib/firmware/updates/qcom/"$(basename "$src")"
		else
			echo "warning: $f not found in linux-firmware-qcom" >&2
		fi
	done
	install -Dm600 system/cheip.doas.conf "$pkgdir"/etc/doas.d/cheip.conf
	install -Dm644 system/90-cheip.rules "$pkgdir"/usr/lib/udev/rules.d/90-cheip.rules
	install -Dm644 system/update.json "$pkgdir"/etc/cheip/update.json
}

sha512sums="SKIP"
