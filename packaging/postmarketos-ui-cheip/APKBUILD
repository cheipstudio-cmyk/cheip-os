# Maintainer: Eugenio Casale <cheipstudio@gmail.com>
# Pacchetto UI per pmbootstrap: "pmbootstrap config ui cheip"
pkgname=postmarketos-ui-cheip
pkgver=0.3.0
pkgrel=0
pkgdesc="Cheip OS: interfaccia leggera per telefoni con 1 GB di RAM"
url="https://cheipstudio.org"
arch="noarch"
license="GPL-3.0-or-later"
depends="cheip-shell networkmanager networkmanager-wifi wpa_supplicant waydroid"
install="$pkgname.post-install"
# Repository OTA firmato e chiave pubblica per verificarlo
source="cheip-os.rsa.pub"
options="!check"

package() {
	install -Dm644 "$srcdir"/cheip-os.rsa.pub "$pkgdir"/etc/apk/keys/cheip-os.rsa.pub
	# Lumia: the screen is the UEFI framebuffer (simple-framebuffer), simpledrm
	# must be in the initramfs so the boot splash and the console show up
	mkdir -p "$pkgdir"/usr/share/mkinitfs/modules
	echo simpledrm > "$pkgdir"/usr/share/mkinitfs/modules/10-cheip-display.modules
	# App Android preinstallate, aggiunte dalla CI se disponibili
	for apk in "$srcdir"/*.apk; do
		[ -f "$apk" ] && install -Dm644 "$apk" "$pkgdir"/usr/share/cheip/preinstall/"$(basename "$apk")"
	done
	return 0
}

sha512sums="SKIP"
