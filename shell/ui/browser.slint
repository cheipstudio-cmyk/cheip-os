import { Theme } from "theme.slint";
import { Web } from "data.slint";
import { Icon, Icons, StatusBar, RoundButton, Title, ListRow } from "components.slint";

export component BrowserApp inherits Rectangle {
    background: Theme.surface;
    property <bool> show-tabs: false;
    property <int> reset: Web.scroll-reset;
    changed reset => { page.content-y = 0; }

    StatusBar { y: 0; width: parent.width; }

    // Barra indirizzo
    if Web.can-back: RoundButton { x: 8px; y: 30px; icon: Icons.back; outlined: false; clicked => { Web.back(); } }
    bar := Rectangle {
        x: Web.can-back ? 56px : 12px; y: 30px; height: 46px;
        width: parent.width - self.x - 108px;
        border-radius: 23px; background: addr.has-focus ? Theme.container-highest : Theme.container-high;
        border-width: addr.has-focus ? 2px : 0px; border-color: Theme.primary;
        animate background { duration: Theme.fast; }
        animate x, width { duration: Theme.fast; easing: Theme.ease; }
        Icon { x: 14px; d: Icons.globe; size: 16px; tint: Theme.muted; }
        Text {
            x: 38px; width: parent.width - 50px; height: parent.height;
            text: Web.url == "" ? "Search or type a URL" : Web.url;
            visible: !addr.has-focus;
            color: Web.url == "" ? Theme.faint : Theme.muted; font-family: Theme.body; font-size: 14px;
            vertical-alignment: center; overflow: elide;
        }
        addr := TextInput {
            x: 38px; width: parent.width - 50px; height: parent.height;
            color: Theme.text; font-family: Theme.body; font-size: 14px;
            vertical-alignment: center; single-line: true;
            opacity: self.has-focus ? 1 : 0;
            input-type: InputType.text;
            accepted => { Web.go(self.text); self.text = ""; self.clear-focus(); }
        }
    }
    RoundButton {
        x: parent.width - 100px; y: 30px; outlined: false;
        icon: Icons.star; tint: Web.bookmarked ? Theme.accent : Theme.muted;
        clicked => { Web.toggle-bookmark(); }
    }
    Rectangle {
        x: parent.width - 52px; y: 30px; width: 44px; height: 44px; border-radius: 22px;
        background: tabs-ta.pressed ? Theme.raised : transparent;
        Rectangle {
            width: 22px; height: 22px; border-radius: 6px; border-width: 2px; border-color: Theme.text;
            Text { text: Web.tabs.length; color: Theme.text; font-family: Theme.body; font-size: 11px; font-weight: 600; }
        }
        tabs-ta := TouchArea { clicked => { root.show-tabs = !root.show-tabs; } }
    }

    // Caricamento: segmento che scorre
    if Web.loading: Rectangle {
        y: 80px; height: 2px; clip: true;
        Rectangle {
            width: 90px;
            x: (mod(animation-tick() / 1ms, 1100) / 1100) * (parent.width + 90px) - 90px;
            background: Theme.accent;
        }
    }

    // Pagina
    page := Flickable {
        x: 0; y: 86px; width: parent.width; height: parent.height - 86px - 24px;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: page.width;
            padding-left: 20px; padding-right: 20px; padding-bottom: 32px;
            spacing: 10px;
            if Web.url != "" && Web.title != "": Text {
                text: Web.title; color: Theme.muted; font-family: Theme.body; font-size: 12px; overflow: elide;
            }
            for b in Web.blocks: Rectangle {
                height: b.kind == 6 ? code.preferred-height + 20px : t.preferred-height;
                if b.kind == 6: Rectangle { border-radius: 10px; background: Theme.raised; }
                t := Text {
                    x: b.kind == 4 ? 16px : (b.kind == 7 ? 14px : 0px);
                    width: parent.width - self.x;
                    visible: b.kind != 6;
                    text: b.text;
                    wrap: word-wrap;
                    color: b.kind == 5 ? Theme.accent : (b.kind == 7 ? Theme.muted : Theme.text);
                    font-family: b.kind <= 2 ? Theme.display : Theme.body;
                    font-weight: b.kind <= 2 ? 700 : (b.kind == 5 ? 600 : 400);
                    font-size: b.kind == 0 ? 26px : (b.kind == 1 ? 21px : (b.kind == 2 ? 17px : 15px));
                    font-italic: b.kind == 7;
                }
                if b.kind == 4: Rectangle { x: 2px; y: 8px; width: 5px; height: 5px; border-radius: 2.5px; background: Theme.muted; }
                if b.kind == 7: Rectangle { x: 0; width: 3px; border-radius: 1.5px; background: Theme.line; }
                code := Text {
                    x: 12px; y: 10px; width: parent.width - 24px;
                    visible: b.kind == 6;
                    text: b.kind == 6 ? b.text : "";
                    wrap: word-wrap;
                    color: Theme.text; font-family: Theme.body; font-size: 12px;
                }
                if b.kind == 5: TouchArea { clicked => { Web.go(b.href); } }
            }
        }
    }

    // Pagina iniziale: logo, ricerca grande, scorciatoie a tessere e preferiti
    if Web.url == "" && !Web.loading: Flickable {
        y: 86px; height: parent.height - 86px;
        content-height: 480px + Web.bookmarks.length * 70px;
        Rectangle {
            x: (parent.width - 88px) / 2; y: 28px; width: 88px; height: 88px; border-radius: 30px;
            background: Theme.primary-container;
            Icon { d: Icons.globe; size: 44px; tint: Theme.on-primary-container; weight: 1.6px; }
        }
        Text {
            y: 128px; width: parent.width; text: "Browse the web";
            color: Theme.on-surface; font-family: Theme.display; font-size: 26px; font-weight: 500; horizontal-alignment: center;
        }
        Rectangle {
            x: 20px; y: 176px; width: parent.width - 40px; height: 56px; border-radius: 28px;
            background: big-ta.pressed ? Theme.container-highest : Theme.container-high;
            Icon { x: 20px; d: Icons.search; size: 20px; tint: Theme.on-surface-variant; }
            Text { x: 52px; text: "Search or type a URL"; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 16px; vertical-alignment: center; height: parent.height; }
            big-ta := TouchArea { clicked => { addr.focus(); } }
        }
        if Web.bookmarks.length > 0: Text {
            x: 24px; y: 256px; text: "Shortcuts";
            color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; font-weight: 600;
        }
        for bm[i] in Web.bookmarks: Rectangle {
            property <length> cw: (root.width - 40px) / 4;
            x: 20px + mod(i, 4) * self.cw; y: 284px + floor(i / 4) * 96px;
            width: self.cw; height: 92px;
            Rectangle {
                x: (parent.width - 56px) / 2; y: 4px; width: 56px; height: 56px;
                border-radius: sta.pressed ? 16px : 28px;
                background: mod(i, 3) == 0 ? Theme.primary-container : mod(i, 3) == 1 ? Theme.secondary-container : Theme.tertiary-container;
                animate border-radius { duration: 300ms; easing: spring(0.35); }
                Text {
                    text: bm.title == "" ? "?" : bm.initial;
                    color: mod(i, 3) == 0 ? Theme.on-primary-container : mod(i, 3) == 1 ? Theme.on-secondary-container : Theme.on-tertiary-container;
                    font-family: Theme.display; font-size: 22px; font-weight: 600;
                }
            }
            Text {
                y: 66px; width: parent.width; text: bm.title;
                color: Theme.on-surface; font-family: Theme.body; font-size: 12px; horizontal-alignment: center; overflow: elide;
            }
            sta := TouchArea { clicked => { Web.go(bm.url); } }
        }
    }

    if Web.error != "" && !Web.loading: VerticalLayout {
        y: 200px; spacing: 14px; alignment: start;
        Text { text: Web.error; color: Theme.muted; font-family: Theme.body; font-size: 14px; horizontal-alignment: center; }
        HorizontalLayout { alignment: center; RoundButton { icon: Icons.refresh; clicked => { Web.reload(); } } }
    }

    // Schede
    if root.show-tabs: Rectangle {
        background: Theme.surface;
        TouchArea { }
        StatusBar { y: 0; width: parent.width; }
        Title { x: 16px; y: 34px; text: Web.tabs.length + (Web.tabs.length == 1 ? " tab" : " tabs"); }
        RoundButton {
            x: parent.width - 60px; y: 32px; icon: Icons.plus; fill: Theme.accent; tint: Theme.on-primary; outlined: false;
            clicked => { Web.new-tab(); root.show-tabs = false; }
        }
        Flickable {
            x: 16px; y: 92px; width: parent.width - 32px; height: parent.height - 120px;
            content-height: Web.tabs.length * 72px;
            for tb[i] in Web.tabs: Rectangle {
                y: i * 72px; height: 64px; border-radius: 16px;
                background: i == Web.current-tab ? Theme.raised : Theme.bg;
                border-width: 1px; border-color: i == Web.current-tab ? Theme.accent : Theme.line;
                VerticalLayout {
                    x: 16px; width: parent.width - 72px; alignment: center; spacing: 2px;
                    Text { text: tb.title == "" ? "New tab" : tb.title; color: Theme.text; font-family: Theme.body; font-size: 14px; overflow: elide; }
                    Text { text: tb.url; color: Theme.muted; font-family: Theme.body; font-size: 11px; overflow: elide; }
                }
                TouchArea { clicked => { Web.select-tab(i); root.show-tabs = false; } }
                RoundButton {
                    x: parent.width - 52px; y: 10px; icon: Icons.close; outlined: false; tint: Theme.muted;
                    clicked => { Web.close-tab(i); }
                }
            }
        }
    }
}
