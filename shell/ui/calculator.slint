import { Theme } from "theme.slint";
import { Calc } from "data.slint";
import { StatusBar } from "components.slint";

// Tasto: pillola che diventa squadrata alla pressione
component CKey inherits Rectangle {
    in property <string> label;
    in property <int> kind; // 0 numero, 1 operatore, 2 funzione, 3 uguale
    border-radius: ta.pressed ? 20px : min(self.width, self.height) / 2;
    background: root.kind == 3 ? Theme.primary
        : root.kind == 1 ? Theme.secondary-container
        : root.kind == 2 ? Theme.tertiary-container
        : (ta.pressed ? Theme.container-highest : Theme.container-high);
    animate border-radius { duration: 300ms; easing: spring(0.35); }
    Text {
        text: root.label;
        color: root.kind == 3 ? Theme.on-primary
            : root.kind == 1 ? Theme.on-secondary-container
            : root.kind == 2 ? Theme.on-tertiary-container
            : Theme.on-surface;
        font-family: Theme.display; font-weight: 500;
        font-size: root.kind == 0 ? 30px : 28px;
    }
    ta := TouchArea { clicked => { Calc.key(root.label); } }
}

export component CalculatorApp inherits Rectangle {
    background: Theme.surface;
    property <length> gap: 10px;
    property <length> pad-top: root.height - 5 * root.key-h - 4 * root.gap - 24px;
    property <length> key-w: (root.width - 32px - 3 * root.gap) / 4;
    property <length> key-h: min(root.key-w * 0.86, (root.height - 230px) / 5);

    StatusBar { y: 0; width: parent.width; }

    // Display: espressione grande, anteprima del risultato sotto
    Rectangle {
        x: 16px; y: 44px; width: parent.width - 32px; height: root.pad-top - 60px;
        border-radius: 28px; background: Theme.container;
        Text {
            x: 20px; y: parent.height - 112px; width: parent.width - 40px; height: 64px;
            text: Calc.expr != "" ? Calc.expr : "0";
            color: Theme.on-surface; font-family: Theme.display; font-weight: 400;
            font-size: Calc.expr.character-count > 14 ? 30px : Calc.expr.character-count > 9 ? 40px : 56px;
            horizontal-alignment: right; vertical-alignment: center; overflow: elide;
        }
        Text {
            x: 20px; y: parent.height - 48px; width: parent.width - 40px; height: 32px;
            text: Calc.result;
            color: Calc.result == "Error" ? Theme.error : Theme.on-surface-variant;
            font-family: Theme.display; font-size: 26px;
            horizontal-alignment: right; vertical-alignment: center; overflow: elide;
        }
    }

    for k[i] in [
        {l: "AC", t: 2}, {l: "⌫", t: 2}, {l: "%", t: 2}, {l: "÷", t: 1},
        {l: "7", t: 0}, {l: "8", t: 0}, {l: "9", t: 0}, {l: "×", t: 1},
        {l: "4", t: 0}, {l: "5", t: 0}, {l: "6", t: 0}, {l: "−", t: 1},
        {l: "1", t: 0}, {l: "2", t: 0}, {l: "3", t: 0}, {l: "+", t: 1},
        {l: "±", t: 0}, {l: "0", t: 0}, {l: ".", t: 0}, {l: "=", t: 3}
    ]: CKey {
        x: 16px + mod(i, 4) * (root.key-w + root.gap);
        y: root.pad-top + floor(i / 4) * (root.key-h + root.gap);
        width: root.key-w; height: root.key-h;
        label: k.l; kind: k.t;
    }
}
