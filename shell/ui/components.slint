export component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.text;
    in property <length> size: 20px;
    in property <length> weight: 2px;
    width: self.size;
    height: self.size;
    commands: self.d;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.tint;
    stroke-width: self.weight;
    fill: transparent;
}

// Contenuto della batteria: fulmine opzionale e numero, centrati.
// Identico nei due strati di colore, cosi combaciano al pixel.
component BatLabel inherits Rectangle {
    in property <string> label;
    in property <bool> charging;
    in property <color> tint;
    property <length> bolt-w: root.charging ? 7.5px : 0px;
    property <length> total: t.preferred-width + root.bolt-w;
    if root.charging: Path {
        x: (root.width - root.total) / 2;
        y: (root.height - 9px) / 2;
        width: 6.5px; height: 9px;
        commands: Icons.bolt;
        viewbox-x: 4; viewbox-y: 2; viewbox-width: 15; viewbox-height: 20;
        fill: root.tint;
    }
    t := Text {
        x: (root.width - root.total) / 2 + root.bolt-w;
        y: (root.height - self.height) / 2 + 0.2px;
        text: root.label;
        color: root.tint;
        font-family: Theme.body;
        font-size: 9.5px;
        font-weight: 800;
    }
}

// Batteria stile Pixel: pillola orizzontale, numero dentro, testo a due colori
// che cambia tinta dove passa il riempimento. Verde in carica, giallo in
// risparmio, rosso sotto il 20%.
export component Battery inherits Rectangle {
    in property <int> level: Sys.battery;
    in property <bool> charging: Sys.charging;
    in property <bool> saver: Sys.eco-on;
    property <bool> low: root.level <= 20 && !root.charging;
    property <color> fill: root.charging ? #5ee08a : root.saver ? #ffcf3d : root.low ? #ff5449 : #f2f2f2;
    property <length> body-w: 27px;
    property <length> inner: root.body-w - 4px;
    property <length> fill-w: max(3px, root.inner * clamp(root.level, 0, 100) / 100);
    property <string> label: root.level;
    width: root.body-w + 3px;
    height: 14px;

    // corpo
    body := Rectangle {
        x: 0; y: 0;
        width: root.body-w;
        height: root.height;
        border-radius: 4.5px;
        background: #ffffff38;
        clip: true;

        // riempimento
        fillr := Rectangle {
            x: 2px; y: 2px;
            width: root.fill-w;
            height: parent.height - 4px;
            border-radius: 2.5px;
            background: root.fill;
            clip: true;
            animate width { duration: 700ms; easing: cubic-bezier(0.2,0.9,0.1,1); }
            animate background { duration: 400ms; }

            // riflesso che scorre durante la carica
            if root.charging: Rectangle {
                width: 10px;
                height: parent.height;
                x: -10px + (parent.width + 10px) * mod(animation-tick() / 1600ms, 1.0);
                background: @linear-gradient(90deg, #ffffff00 0%, #ffffff90 50%, #ffffff00 100%);
            }

            // testo scuro sopra il riempimento, allineato al testo chiaro
            BatLabel {
                x: -2px;
                y: -2px;
                width: root.body-w;
                height: root.height;
                label: root.label;
                charging: root.charging;
                tint: #0a0a0a;
            }
        }

        // testo chiaro nella parte vuota (coperto dal riempimento)
        Rectangle {
            x: 2px + root.fill-w;
            width: max(0px, root.body-w - self.x);
            height: parent.height;
            clip: true;
            animate x { duration: 700ms; easing: cubic-bezier(0.2,0.9,0.1,1); }
            BatLabel {
                x: -parent.x;
                y: 0px;
                width: root.body-w;
                height: root.height;
                label: root.label;
                charging: root.charging;
                tint: #f2f2f2;
            }
        }
    }

    // polo
    Rectangle {
        x: root.body-w + 1px;
        y: (root.height - self.height) / 2;
        width: 2px;
        height: 5px;
        border-radius: 1px;
        background: root.level >= 99 ? root.fill : #ffffff38;
    }
}

export component StatusBar inherits Rectangle {
    in property <bool> show-time: true;
    height: 24px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        if root.show-time: Text {
            text: Sys.time;
            color: #d0d0d0;
            font-family: Theme.body;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { }
        Icon { d: Icons.signal; size: 14px; tint: #d0d0d0; y: 5px; }
        Battery { y: (24px - self.height) / 2; }
    }
}

export component Badge inherits Rectangle {
    background: Theme.accent;
    border-radius: 3px;
    width: 14px;
    height: 14px;
    Text {
        text: "A";
        color: #000;
        font-family: Theme.body;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Icona tonda dell'app, senza testo. Le app Android mostrano la loro immagine.
export component AppIcon inherits Rectangle {
    in property <AppEntry> app;
    in property <length> size: 56px;
    in property <bool> interactive: true;
    in property <bool> pressed;
    callback activated(length, length, length);
    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    background: (root.pressed || ta.pressed) ? #262626 : Theme.raised;
    clip: true;
    transform-scale: (root.pressed || ta.pressed) ? 0.88 : 1;
    animate transform-scale { duration: 260ms; easing: spring(0.35); }
    animate background { duration: Theme.fast; }
    if !root.app.has-picture && root.app.glyph != "": Icon { d: root.app.glyph; size: root.size * 0.43; weight: 1.8px; }
    if !root.app.has-picture && root.app.glyph == "": Text {
        text: root.app.initial;
        color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: root.size * 0.36;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.app.has-picture: Image { source: root.app.picture; width: root.size; height: root.size; image-fit: cover; }
    ta := TouchArea {
        enabled: root.interactive;
        clicked => { root.activated(root.absolute-position.x, root.absolute-position.y, root.size); }
    }
}

// Pallino di notifica sopra un'icona
export component Dot inherits Rectangle {
    in property <int> count;
    visible: self.count > 0;
    width: 18px; height: 18px; border-radius: 9px;
    background: Theme.accent;
    border-width: 2px; border-color: Theme.bg;
    Text { text: root.count > 9 ? "9+" : root.count; color: #000; font-family: Theme.body; font-size: 9px; font-weight: 600; }
}

export component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <color> fill: transparent;
    in property <color> tint: Theme.text;
    in property <bool> outlined: true;
    in property <length> size: 44px;
    in property <length> icon-size: 20px;
    callback clicked();
    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    background: ta.pressed ? Theme.raised : self.fill;
    border-width: self.outlined ? 1px : 0px;
    border-color: Theme.line;
    transform-scale: ta.pressed ? 0.88 : 1;
    animate transform-scale { duration: 260ms; easing: spring(0.35); }
    animate background { duration: Theme.fast; }
    Icon { d: root.icon; tint: root.tint; size: root.icon-size; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> solid: false;
    in property <length> pad: 14px;
    callback clicked();
    height: 34px;
    width: txt.preferred-width + 2 * self.pad;
    border-radius: self.height / 2;
    background: root.solid ? Theme.accent : (root.active ? Theme.text : transparent);
    border-width: (root.active || root.solid) ? 0px : 1px;
    border-color: Theme.line;
    transform-scale: ta.pressed ? 0.92 : 1;
    animate transform-scale { duration: 260ms; easing: spring(0.35); }
    animate background { duration: Theme.fast; }
    txt := Text {
        text: root.label;
        color: (root.active || root.solid) ? #000 : Theme.text;
        font-family: Theme.body;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component Card inherits Rectangle {
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.bg;
}

export component Title inherits Text {
    color: Theme.text;
    font-family: Theme.display;
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.5px;
}

// Avatar con iniziale, per contatti e conversazioni
export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <length> size: 44px;
    width: self.size; height: self.size; border-radius: self.size / 2;
    background: Theme.raised;
    Text { text: root.initial; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: root.size * 0.4; }
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <bool> multi: false;
    in property <InputType> kind: InputType.text;
    callback accepted(string);
    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    animate border-color { duration: Theme.fast; }
    Text {
        x: 12px; y: root.multi ? 12px : 0px;
        height: root.multi ? self.preferred-height : parent.height;
        text: root.placeholder;
        visible: input.text == "";
        color: Theme.faint; font-family: Theme.body; font-size: 14px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 12px; y: root.multi ? 12px : 0px;
        width: parent.width - 24px;
        height: root.multi ? parent.height - 24px : parent.height;
        color: Theme.text; font-family: Theme.body; font-size: 14px;
        vertical-alignment: root.multi ? top : center;
        single-line: !root.multi;
        wrap: word-wrap;
        input-type: root.kind;
        accepted => { root.accepted(self.text); }
    }
    public function clear() { input.text = ""; }
}

// Riga di elenco con icona a sinistra
export component ListRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> detail;
    in property <bool> chevron: true;
    callback clicked();
    height: 56px;
    background: ta.pressed ? Theme.raised : transparent;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: 0; width: 36px; height: 36px; border-radius: 18px; background: Theme.raised;
        Icon { d: root.icon; size: 18px; }
    }
    VerticalLayout {
        x: 50px; width: parent.width - 80px;
        alignment: center; spacing: 2px;
        Text { text: root.label; color: Theme.text; font-family: Theme.body; font-size: 15px; overflow: elide; }
        if root.detail != "": Text { text: root.detail; color: Theme.muted; font-family: Theme.body; font-size: 12px; overflow: elide; }
    }
    if root.chevron: Icon { x: parent.width - 20px; d: Icons.fwd; size: 16px; tint: Theme.faint; }
    ta := TouchArea { clicked => { root.clicked(); } }
}
