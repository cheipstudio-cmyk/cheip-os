import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Shapes } from "shapes.slint";
import { Sys, AppEntry, Style } from "data.slint";

export { Icons, Shapes }

// Icona Material Symbols piena o a contorno
export component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.on-surface;
    in property <length> size: 24px;
    in property <length> weight: 0px;
    width: self.size;
    height: self.size;
    commands: self.d;
    viewbox-x: 0;
    viewbox-y: -960;
    viewbox-width: 960;
    viewbox-height: 960;
    fill: self.tint;
    animate fill { duration: Theme.fast; }
}

// Contenuto della batteria: fulmine opzionale e numero, centrati.
// Identico nei due strati di colore, cosi combaciano al pixel.
component BatLabel inherits Rectangle {
    in property <string> label;
    in property <bool> charging;
    in property <color> tint;
    property <length> bolt-w: root.charging ? 7.5px : 0px;
    property <length> total: t.preferred-width + root.bolt-w;
    if root.charging: Path {
        x: (root.width - root.total) / 2;
        y: (root.height - 9px) / 2;
        width: 6.5px; height: 9px;
        commands: "M13 2 4 14h7l-1 8 9-12h-7z";
        viewbox-x: 4; viewbox-y: 2; viewbox-width: 15; viewbox-height: 20;
        fill: root.tint;
    }
    t := Text {
        x: (root.width - root.total) / 2 + root.bolt-w;
        y: (root.height - self.height) / 2 + 0.2px;
        text: root.label;
        color: root.tint;
        font-family: Theme.body;
        font-size: 9.5px;
        font-weight: 700;
    }
}

// Batteria stile Pixel: pillola orizzontale, numero dentro, testo a due colori
// che cambia tinta dove passa il riempimento. Verde in carica, giallo in
// risparmio, rosso sotto il 20%.
export component Battery inherits Rectangle {
    in property <int> level: Sys.battery;
    in property <bool> charging: Sys.charging;
    in property <bool> saver: Sys.eco-on;
    in property <color> fg: Theme.on-surface;
    property <bool> fg-light: root.fg.to-hsv().value > 0.5;
    property <bool> low: root.level <= 20 && !root.charging;
    property <color> fill: root.charging ? (root.fg-light ? #5ee08a : #1e8e4a) : root.saver ? (root.fg-light ? #ffcf3d : #b07d00) : root.low ? (root.fg-light ? #ff5449 : #ba1a1a) : root.fg;
    property <color> ink: root.fill.to-hsv().value > 0.6 && (root.fill.to-hsv().saturation < 0.5 || root.charging || root.saver) ? #0a0a0a : #ffffff;
    property <length> body-w: 27px;
    property <length> inner: root.body-w - 4px;
    property <length> fill-w: max(3px, root.inner * clamp(root.level, 0, 100) / 100);
    property <string> label: root.level;
    width: root.body-w + 3px;
    height: 14px;

    Rectangle {
        x: 0; y: 0;
        width: root.body-w;
        height: root.height;
        border-radius: 4.5px;
        background: root.fg.with-alpha(0.24);
        clip: true;

        Rectangle {
            x: 2px; y: 2px;
            width: root.fill-w;
            height: parent.height - 4px;
            border-radius: 2.5px;
            background: root.fill;
            clip: true;
            animate width { duration: 700ms; easing: Theme.ease; }
            animate background { duration: 400ms; }

            // The moving shine redraws the whole screen every frame: never in lite mode
            if root.charging && !Theme.lite: Rectangle {
                width: 10px;
                height: parent.height;
                x: -10px + (parent.width + 10px) * mod(animation-tick() / 1600ms, 1.0);
                background: @linear-gradient(90deg, #ffffff00 0%, #ffffff90 50%, #ffffff00 100%);
            }

            BatLabel {
                x: -2px; y: -2px;
                width: root.body-w; height: root.height;
                label: root.label; charging: root.charging; tint: root.ink;
            }
        }

        Rectangle {
            x: 2px + root.fill-w;
            width: max(0px, root.body-w - self.x);
            height: parent.height;
            clip: true;
            animate x { duration: 700ms; easing: Theme.ease; }
            BatLabel {
                x: -parent.x; y: 0px;
                width: root.body-w; height: root.height;
                label: root.label; charging: root.charging; tint: root.fg;
            }
        }
    }

    Rectangle {
        x: root.body-w + 1px;
        y: (root.height - self.height) / 2;
        width: 2px;
        height: 5px;
        border-radius: 1px;
        background: root.level >= 99 ? root.fill : root.fg.with-alpha(0.24);
    }
}

export component StatusBar inherits Rectangle {
    in property <bool> show-time: true;
    in property <color> fg: Theme.on-surface;
    height: 28px;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 18px;
        spacing: 6px;
        if root.show-time: Text {
            text: Sys.time;
            color: root.fg;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { }
        if Sys.ringer == 1: Icon { d: Icons.vibrate-f; size: 15px; tint: root.fg; y: 6.5px; }
        if Sys.ringer == 2: Icon { d: Icons.bell-off-f; size: 15px; tint: root.fg; y: 6.5px; }
        if Sys.wifi-on && Sys.has-wifi: Icon { d: Icons.wifi-f; size: 15px; tint: root.fg; y: 6.5px; }
        if Sys.has-cell: Icon { d: Icons.signal-f; size: 15px; tint: root.fg; y: 6.5px; }
        if Sys.has-battery: Battery { y: (28px - self.height) / 2; fg: root.fg; }
    }
}

export component Badge inherits Rectangle {
    background: Theme.tertiary;
    border-radius: 4px;
    width: 14px;
    height: 14px;
    Icon { d: Icons.android-f; size: 11px; tint: Theme.on-tertiary; }
}

// Forma dell'icona scelta in Stile
export global IconShape {
    out property <string> path: Style.icon-shape == 0 ? Shapes.circle : Style.icon-shape == 1 ? Shapes.squircle : Style.icon-shape == 2 ? Shapes.cookie : Style.icon-shape == 3 ? Shapes.clover : Shapes.sunny;
}

// Icona dell'app: forma Material, pacchetto icone dallo Stile, nessun testo.
export component AppIcon inherits Rectangle {
    in property <AppEntry> app;
    in property <length> size: 56px;
    in property <bool> interactive: true;
    in property <bool> pressed;
    callback activated(length, length, length);
    property <bool> down: root.pressed || ta.pressed;
    property <int> pack: Style.icon-pack;
    property <color> bg: root.pack == 0 ? Theme.primary-container : root.pack == 1 ? root.app.tone : root.pack == 2 ? Theme.container-highest : transparent;
    property <color> fg: root.pack == 0 ? Theme.on-primary-container : root.pack == 1 ? root.app.tone-on : Theme.on-surface;
    width: self.size;
    height: self.size;
    transform-scale: root.down ? 0.86 : 1;
    transform-rotation: root.down && Style.icon-shape >= 2 ? 12deg : 0deg;
    animate transform-scale { duration: 380ms; easing: spring(0.45); }
    animate transform-rotation { duration: 520ms; easing: spring(0.4); }

    if !root.app.has-picture: Path {
        width: root.size; height: root.size;
        commands: IconShape.path;
        viewbox-width: 100; viewbox-height: 100;
        fill: root.pack == 1 ? @linear-gradient(170deg, root.bg.brighter(0.18) 0%, root.bg 55%, root.bg.darker(0.12) 100%) : root.bg;
        stroke: root.pack == 3 ? Theme.outline : transparent;
        stroke-width: root.pack == 3 ? 1.5px : 0px;
        animate fill { duration: Theme.slow; }
    }
    if !root.app.has-picture && root.app.glyph != "": Icon {
        d: root.app.glyph; size: root.size * 0.46; tint: root.fg;
    }
    if !root.app.has-picture && root.app.glyph == "": Text {
        text: root.app.initial;
        color: root.fg; font-family: Theme.display; font-weight: 700; font-size: root.size * 0.38;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.app.has-picture: Rectangle {
        width: root.size; height: root.size;
        border-radius: Style.icon-shape == 0 ? root.size / 2 : root.size * 0.32;
        clip: true;
        Image { source: root.app.picture; width: root.size; height: root.size; image-fit: cover; }
    }
    // velo di pressione
    if root.down: Path {
        width: root.size; height: root.size;
        commands: IconShape.path;
        viewbox-width: 100; viewbox-height: 100;
        fill: #00000022;
    }
    ta := TouchArea {
        enabled: root.interactive;
        clicked => { root.activated(root.absolute-position.x, root.absolute-position.y, root.size); }
    }
}

// Pallino di notifica sopra un'icona
export component Dot inherits Rectangle {
    in property <int> count;
    visible: self.count > 0;
    width: max(18px, t.preferred-width + 10px); height: 18px; border-radius: 9px;
    background: Theme.error;
    t := Text { text: root.count > 99 ? "99+" : root.count; color: Theme.on-error; font-family: Theme.body; font-size: 10px; font-weight: 700; }
}

// Pulsante icona M3: standard, tonale o pieno. La forma si stringe alla pressione.
export component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <color> fill: transparent;
    in property <color> tint: Theme.on-surface-variant;
    in property <bool> outlined: false;
    in property <length> size: 44px;
    in property <length> icon-size: 24px;
    callback clicked();
    width: self.size;
    height: self.size;
    border-radius: ta.pressed ? self.size * 0.3 : self.size / 2;
    background: ta.pressed ? (root.fill == transparent ? Theme.state-pressed : root.fill.darker(0.08)) : self.fill;
    border-width: self.outlined ? 1px : 0px;
    border-color: Theme.outline-variant;
    animate border-radius { duration: 300ms; easing: spring(0.3); }
    animate background { duration: Theme.fast; }
    Icon { d: root.icon; tint: root.tint; size: root.icon-size; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Pulsante M3: pieno (solid), tonale (active) o a contorno
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> solid: false;
    in property <bool> danger: false;
    in property <length> pad: 20px;
    callback clicked();
    height: 40px;
    width: txt.preferred-width + 2 * self.pad + (root.icon != "" ? 26px : 0px);
    border-radius: ta.pressed ? 10px : self.height / 2;
    background: root.danger ? Theme.error : root.solid ? Theme.primary : (root.active ? Theme.secondary-container : transparent);
    border-width: (root.active || root.solid || root.danger) ? 0px : 1px;
    border-color: Theme.outline-variant;
    animate border-radius { duration: 320ms; easing: spring(0.3); }
    animate background { duration: Theme.fast; }
    property <color> ink: root.danger ? Theme.on-error : root.solid ? Theme.on-primary : (root.active ? Theme.on-secondary-container : Theme.primary);
    if root.icon != "": Icon { x: root.pad - 4px; d: root.icon; size: 18px; tint: root.ink; }
    txt := Text {
        x: root.pad + (root.icon != "" ? 22px : 0px);
        text: root.label;
        color: root.ink;
        font-family: Theme.body;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        height: parent.height;
    }
    if ta.pressed: Rectangle { border-radius: parent.border-radius; background: Theme.state-pressed; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component Card inherits Rectangle {
    border-radius: Theme.r-xl;
    background: Theme.container-low;
}

export component Title inherits Text {
    color: Theme.on-surface;
    font-family: Theme.display;
    font-weight: 500;
    font-size: 32px;
}

// Avatar con iniziale, colori tonali
export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <length> size: 44px;
    in property <int> hue: 0;
    width: self.size; height: self.size; border-radius: self.size / 2;
    background: mod(root.hue, 3) == 0 ? Theme.primary-container : mod(root.hue, 3) == 1 ? Theme.tertiary-container : Theme.secondary-container;
    Text {
        text: root.initial;
        color: mod(root.hue, 3) == 0 ? Theme.on-primary-container : mod(root.hue, 3) == 1 ? Theme.on-tertiary-container : Theme.on-secondary-container;
        font-family: Theme.display; font-weight: 500; font-size: root.size * 0.42;
    }
}

// Campo di testo pieno, angoli arrotondati, anello primario a fuoco
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <bool> multi: false;
    in property <InputType> kind: InputType.text;
    callback accepted(string);
    height: 52px;
    border-radius: Theme.r-lg;
    background: Theme.container-highest;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.primary;
    Text {
        x: 16px; y: root.multi ? 14px : 0px;
        height: root.multi ? self.preferred-height : parent.height;
        text: root.placeholder;
        visible: input.text == "";
        color: Theme.on-surface-variant; font-family: Theme.body; font-size: 16px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 16px; y: root.multi ? 14px : 0px;
        width: parent.width - 32px;
        height: root.multi ? parent.height - 28px : parent.height;
        color: Theme.on-surface; font-family: Theme.body; font-size: 16px;
        vertical-alignment: root.multi ? top : center;
        single-line: !root.multi;
        wrap: word-wrap;
        input-type: root.kind;
        selection-background-color: Theme.primary.with-alpha(0.35);
        accepted => { root.accepted(self.text); }
    }
    public function clear() { input.text = ""; }
    public function focus-it() { input.focus(); }
}

// Riga di elenco M3 con icona tonale a sinistra
export component ListRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> detail;
    in property <bool> chevron: false;
    in property <bool> danger: false;
    callback clicked();
    height: root.detail != "" ? 72px : 56px;
    border-radius: Theme.r-lg;
    background: ta.pressed ? Theme.state-pressed : transparent;
    animate background { duration: Theme.fast; }
    if root.icon != "": Rectangle {
        x: 4px; width: 40px; height: 40px; border-radius: 20px;
        background: root.danger ? Theme.error-container : Theme.secondary-container;
        Icon { d: root.icon; size: 22px; tint: root.danger ? Theme.on-error-container : Theme.on-secondary-container; }
    }
    VerticalLayout {
        x: root.icon != "" ? 60px : 4px; width: parent.width - self.x - (root.chevron ? 36px : 8px);
        alignment: center; spacing: 2px;
        Text { text: root.label; color: root.danger ? Theme.error : Theme.on-surface; font-family: Theme.body; font-size: 16px; overflow: elide; }
        if root.detail != "": Text { text: root.detail; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
    }
    if root.chevron: Icon { x: parent.width - 30px; d: Icons.chevron; size: 22px; tint: Theme.on-surface-variant; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Interruttore M3 Expressive: pollice che cresce, icona spunta quando acceso
export component Switch inherits Rectangle {
    in-out property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 52px; height: 32px;
    border-radius: 16px;
    background: root.on ? Theme.primary : Theme.container-highest;
    border-width: root.on ? 0px : 2px;
    border-color: Theme.outline;
    opacity: root.enabled ? 1 : 0.38;
    animate background { duration: 220ms; }
    thumb := Rectangle {
        property <length> s: ta.pressed ? 28px : (root.on ? 24px : 16px);
        width: self.s; height: self.s; border-radius: self.s / 2;
        x: root.on ? root.width - self.s - 4px : (ta.pressed ? 2px : 8px);
        y: (root.height - self.s) / 2;
        background: root.on ? Theme.on-primary : Theme.outline;
        animate x, width, height { duration: 380ms; easing: spring(0.35); }
        animate background { duration: 220ms; }
        if root.on: Icon { d: Icons.check; size: 16px; tint: Theme.on-primary-container; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.on = !root.on; root.toggled(root.on); }
    }
}

// Cursore M3 Expressive: traccia spessa, maniglia a barra con spazio, punto di arresto
export component Slider inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <string> icon;
    in property <length> track: 16px;
    callback changed(float);
    height: max(44px, root.track + 12px);
    property <length> handle-x: (root.width - 4px) * root.value;
    property <length> gap: 6px;
    // parte attiva
    Rectangle {
        x: 0; y: (root.height - root.track) / 2;
        width: max(0px, root.handle-x - root.gap);
        height: root.track;
        border-radius: root.track / 2;
        background: Theme.primary;
        if root.icon != "" && self.width > 34px: Icon { d: root.icon; size: root.track > 30px ? 24px : 18px; tint: Theme.on-primary; x: root.track > 30px ? 14px : 8px; }
    }
    // parte inattiva
    Rectangle {
        x: root.handle-x + 4px + root.gap; y: (root.height - root.track) / 2;
        width: max(0px, root.width - self.x);
        height: root.track;
        border-radius: root.track / 2;
        background: Theme.secondary-container;
        Rectangle { x: parent.width - 10px; width: 4px; height: 4px; border-radius: 2px; background: Theme.on-secondary-container; }
    }
    // maniglia
    Rectangle {
        x: root.handle-x; y: (root.height - self.height) / 2;
        width: ta.pressed ? 2px : 4px; height: root.height;
        border-radius: 2px;
        background: Theme.primary;
        animate width { duration: 160ms; }
    }
    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.value = clamp(self.mouse-x / root.width, 0, 1); root.changed(root.value); }
        }
        moved => {
            if self.pressed { root.value = clamp(self.mouse-x / root.width, 0, 1); root.changed(root.value); }
        }
    }
}

// Pulsanti segmentati / gruppo di pulsanti connessi Expressive
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    callback picked(int);
    height: 44px;
    HorizontalLayout {
        spacing: 2px;
        for it[i] in root.items: Rectangle {
            property <bool> sel: i == root.selected;
            border-radius: self.sel ? 22px : (sa.pressed ? 14px : 8px);
            background: self.sel ? Theme.secondary : Theme.container-highest;
            animate border-radius { duration: 360ms; easing: spring(0.3); }
            animate background { duration: 200ms; }
            Text {
                text: it; color: sel ? Theme.on-secondary : Theme.on-surface;
                font-family: Theme.body; font-size: 14px; font-weight: 600;
            }
            sa := TouchArea { clicked => { root.selected = i; root.picked(i); } }
        }
    }
}

// Chip filtro
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    width: t.preferred-width + (root.selected ? 52px : 32px);
    border-radius: 8px;
    background: root.selected ? Theme.secondary-container : (ta.pressed ? Theme.state-pressed : transparent);
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.outline-variant;
    animate width { duration: 300ms; easing: spring(0.3); }
    if root.selected: Icon { x: 10px; d: Icons.check; size: 18px; tint: Theme.on-secondary-container; }
    t := Text {
        x: root.selected ? 34px : 16px;
        text: root.label; color: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
        font-family: Theme.body; font-size: 14px; font-weight: 600; height: parent.height; vertical-alignment: center;
        animate x { duration: 300ms; easing: spring(0.3); }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Pulsante d'azione flottante, forma che si stringe alla pressione
export component Fab inherits Rectangle {
    in property <string> icon: Icons.plus;
    in property <string> label;
    in property <bool> large: false;
    callback clicked();
    height: root.large ? 96px : 56px;
    width: root.label != "" ? lt.preferred-width + 72px : self.height;
    border-radius: ta.pressed ? self.height * 0.22 : (root.large ? 28px : 16px);
    background: Theme.primary-container;
    drop-shadow-blur: Theme.lite ? 0px : 10px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #0000004d;
    transform-scale: ta.pressed ? 0.94 : 1;
    animate border-radius, transform-scale { duration: 360ms; easing: spring(0.35); }
    Icon {
        x: root.label != "" ? 18px : (root.width - self.width) / 2;
        d: root.icon; size: root.large ? 36px : 24px; tint: Theme.on-primary-container;
    }
    lt := Text {
        x: 52px; visible: root.label != "";
        text: root.label; color: Theme.on-primary-container;
        font-family: Theme.body; font-size: 16px; font-weight: 600; height: parent.height; vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Barra superiore: indietro, titolo grande, azioni a destra
export component TopBar inherits Rectangle {
    in property <string> title;
    in property <bool> back: true;
    in property <length> collapse: 0px;
    callback go-back();
    height: 112px;
    if root.back: RoundButton { x: 8px; y: 6px; icon: Icons.back; tint: Theme.on-surface; clicked => { root.go-back(); } }
    Text {
        x: 20px; y: 56px;
        text: root.title;
        color: Theme.on-surface;
        font-family: Theme.display;
        font-size: 30px;
        font-weight: 500;
        overflow: elide;
        width: parent.width - 40px;
    }
    @children
}

// Barra di navigazione M3 con indicatore a pillola
export component NavBar inherits Rectangle {
    in property <[{label: string, icon: string, icon-f: string}]> items;
    in-out property <int> selected;
    callback picked(int);
    height: 80px;
    background: Theme.container;
    HorizontalLayout {
        for it[i] in root.items: Rectangle {
            property <bool> sel: i == root.selected;
            Rectangle {
                y: 12px; width: sel ? 64px : 32px; height: 32px; border-radius: 16px;
                background: sel ? Theme.secondary-container : transparent;
                animate width { duration: 380ms; easing: spring(0.35); }
                Icon { d: sel ? it.icon-f : it.icon; size: 24px; tint: sel ? Theme.on-secondary-container : Theme.on-surface-variant; }
            }
            Text {
                y: 50px; text: it.label;
                color: sel ? Theme.on-surface : Theme.on-surface-variant;
                font-family: Theme.body; font-size: 12px; font-weight: sel ? 700 : 500;
            }
            TouchArea { clicked => { root.selected = i; root.picked(i); } }
        }
    }
}

// Stato vuoto: icona in un riquadro tonale e testo, centrati nell'area
export component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> hint;
    Rectangle {
        x: (root.width - 96px) / 2; y: root.height / 2 - 96px;
        width: 96px; height: 96px; border-radius: 32px;
        background: Theme.container-high;
        Icon { d: root.icon; size: 44px; tint: Theme.on-surface-variant; weight: 1.5px; }
    }
    Text {
        x: 32px; y: root.height / 2 + 16px; width: root.width - 64px;
        text: root.title; color: Theme.on-surface; font-family: Theme.display; font-size: 20px; font-weight: 500;
        horizontal-alignment: center; wrap: word-wrap;
    }
    if root.hint != "": Text {
        x: 32px; y: root.height / 2 + 48px; width: root.width - 64px;
        text: root.hint; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px;
        horizontal-alignment: center; wrap: word-wrap;
    }
}
