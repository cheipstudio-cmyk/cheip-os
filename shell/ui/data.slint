// Strutture e global riempiti dal codice Rust

export struct AppEntry { id: string, name: string, initial: string, android: bool, glyph: string, picture: image, has-picture: bool, badge: int, tone: color, tone-on: color }
export struct NotifItem { id: int, app: string, app-id: string, glyph: string, time: string, text: string, android: bool }
export struct ToggleItem { id: string, label: string, glyph: string, on: bool }
export struct RecentItem { id: string, name: string, glyph: string, mem: int, state: string, android: bool }
export struct DayCell { n: int, col: int, row: int, in-month: bool, today: bool, selected: bool, has-events: bool }
export struct EventItem { time: string, title: string }
export struct NoteItem { id: int, title: string, body: string, pinned: bool, col: int, row: int }
export struct CallRow { name: string, number: string, when: string, dir: string }
export struct ContactRow { name: string, number: string, initial: string }
export struct ThreadRow { number: string, name: string, last: string, when: string, unread: int, initial: string }
export struct Bubble { text: string, when: string, out: bool }
export struct WebBlock { kind: int, text: string, href: string }
export struct TabRow { title: string, url: string }
export struct FileRow { name: string, info: string, kind: int, thumb: image, has-thumb: bool }
export struct CatRow { id: string, label: string, glyph: string, detail: string }
export struct WifiRow { ssid: string, signal: int, secure: bool, active: bool }

export struct AlarmRow { id: int, time: string, label: string, days: string, on: bool, next: string, mask: int }
export struct CityRow { city: string, time: string, diff: string, night: bool }
export struct LapRow { n: int, lap: string, total: string }
// Riga di impostazioni: 0 titolo sezione, 1 pagina, 2 interruttore, 3 valore, 4 cursore, 5 scelta, 6 azione, 7 azione pericolosa, 8 testo
export struct SRow { kind: int, key: string, title: string, subtitle: string, glyph: string, on: bool, value: float }
export struct Swatch { id: int, label: string, primary: color, secondary: color, tertiary: color, selected: bool }

export enum ScreenId { lock, home, switcher }

export global Sys {
    in property <string> time: "22:51";
    in property <string> hours: "22";
    in property <string> minutes: "51";
    in property <string> date: "Wednesday, November 25";
    in property <int> battery: 78;
    in property <bool> charging: false;
    // Real hardware present? On the phone they stay false until read from sysfs
    in property <bool> has-battery: true;
    in property <bool> has-wifi: true;
    in property <bool> has-cell: true;
    in property <bool> has-backlight: true;
    in property <bool> has-audio: true;
    // Display & touch
    in-out property <int> display-size: 1;
    in-out property <int> screen-timeout: 1;
    callback set-display-size(int);
    callback set-screen-timeout(int);
    // System sounds and keyboard (saved by Rust through pref)
    in-out property <int> notif-tone: 0;
    in-out property <bool> snd-charge: true;
    in-out property <bool> snd-lowbat: true;
    in-out property <bool> snd-lock: true;
    in-out property <bool> kbd-vibrate: true;
    in-out property <bool> boost: false;
    // System navigation: true = Back/Home/Recents buttons, false = gestures
    in-out property <bool> nav-buttons: true;
    // Home widget: which tiles it shows (Settings > Wallpaper & style)
    in-out property <bool> w-show: true;
    in-out property <bool> w-ram: true;
    in-out property <bool> w-bat: true;
    in-out property <bool> w-disk: false;
    in-out property <bool> w-weather: false;
    in-out property <string> weather-city: "";
    in property <string> weather-temp: "";
    in property <string> weather-desc: "";
    in property <string> disk-used: "";
    in property <float> disk-frac: 0;
    callback set-weather-city(string);
    // Date & time page: values being edited, then applied with set-datetime
    in-out property <[int]> dt: [2026, 1, 1, 12, 0];
    callback load-datetime();
    callback set-datetime(int, int, int, int, int);
    in-out property <bool> h24-on: true;
    callback set-h24(bool);
    callback pref(string, int);
    callback preview-tone(int);
    // Diagnostic line on the lock screen (empty = hidden)
    in property <string> diag: "";
    // Log app: one entry per line of the diagnostics, newest kernel lines too
    in property <[string]> log-lines;
    callback refresh-log();
    in property <int> mem-used: 612;
    in property <int> mem-total: 1024;
    in property <int> mem-android: 0;
    in property <string> android-state: "Not installed";
    in property <bool> android-running: false;
    in property <bool> eco-on: false;
    in property <bool> wifi-on: true;
    in property <bool> data-on: false;
    in property <bool> bt-on: false;
    in property <[NotifItem]> notifications;
    // Suoni: 0 squillo, 1 vibrazione, 2 silenzioso
    in-out property <int> ringer: 0;
    in-out property <int> ringtone: 0;
    in-out property <bool> vibrate-on-ring: true;
    in property <bool> demo: false;
    callback set-ringer(int);
    callback set-ringtone(int);
    in property <[ToggleItem]> toggles;
    in-out property <float> brightness: 0.55;
    in-out property <float> volume: 0.6;
    in property <string> model: "Nokia Lumia 735";
    in property <string> kernel: "";
    in property <string> version: "0.2.0";
    in property <string> update-state: "";
    in property <bool> update-available: false;
    in property <string> update-version: "";
    callback toggle(string);
    callback brightness-changed(float);
    callback volume-changed(float);
    callback check-update();
    callback install-update();
    callback android-toggle();
}

export global Shell {
    // Boot animation (off in the web demo screenshots)
    in-out property <bool> show-splash: true;
    in-out property <ScreenId> screen: ScreenId.lock;
    // Power key: screen black (AMOLED pixels off) and touches ignored
    in property <bool> screen-off: false;
    // Charger plugged in: short full-screen animation
    in property <bool> charge-anim: false;
    in-out property <bool> controls-open: false;
    in-out property <bool> app-open: false;
    in-out property <string> app-id: "";
    in-out property <length> from-x: 152px;
    in-out property <length> from-y: 300px;
    in-out property <length> from-size: 56px;
    in-out property <bool> searching: false;
    in property <[AppEntry]> apps;
    in property <[AppEntry]> dock;
    in property <[RecentItem]> recents;
    callback open-app(string, length, length, length);
    callback close-app();
    // Power menu (long press on the power key or the button in Controls)
    in-out property <bool> power-menu: false;
    callback power-action(string);
    callback unlock();
    callback search(string);
    callback close-recent(string);
    callback close-all();
    // Modifica della home: riordino, dock, info app
    in-out property <bool> edit-mode: false;
    // Notifica a comparsa in alto e pannello volume
    in property <NotifItem> headsup;
    in-out property <bool> headsup-shown: false;
    in-out property <bool> volume-hud: false;
    in property <string> toast: "";
    in-out property <bool> toast-shown: false;
    callback open-notification(int);
    callback dismiss-notification(int);
    callback clear-notifications();
    callback volume-step(int);
    callback hud-touch();
    callback demo-call();
    callback demo-message();
    in-out property <length> close-drag: 0px;
    in-out property <length> controls-drag: 0px;
    in property <bool> dock-full: false;
    callback move-app(int, int);
    callback pin(string);
    callback unpin(string);
    callback app-info(string);
    callback uninstall(string);
}

export global Cal {
    in property <string> month-label: "November 2026";
    in property <[DayCell]> cells;
    in property <string> selected-label: "";
    in property <[EventItem]> events;
    callback prev-month();
    callback next-month();
    callback select(int);
    callback add-event(string, string);
}

export global Notes {
    in property <[NoteItem]> notes;
    in property <int> rows: 3;
    in-out property <int> filter: 0;
    callback set-filter(int);
    callback save(int, string, string);
    callback toggle-pin(int);
    callback remove(int);
}

export global Cam {
    in property <bool> available: false;
    in property <string> message: "Camera sensor not supported on this model yet";
}

export global Phone {
    in property <bool> modem-ok: false;
    in property <string> modem-label: "Modem not available";
    in-out property <int> tab: 0;
    in-out property <string> dial: "";
    in property <[CallRow]> recents;
    in property <[ContactRow]> contacts;
    in property <bool> in-call: false;
    in property <bool> incoming: false;
    in property <string> call-name: "";
    in property <string> call-initial: "";
    in property <string> call-number: "";
    in property <string> call-state: "";
    in property <string> call-time: "";
    callback call(string);
    callback answer();
    callback hangup();
    callback add-contact(string, string);
}

export global Msg {
    in property <bool> modem-ok: false;
    in property <[ThreadRow]> threads;
    in property <string> open-number: "";
    in property <string> open-name: "";
    in property <[Bubble]> messages;
    in property <string> status: "";
    callback open-thread(string);
    callback close-thread();
    callback send(string, string);
}

export global Web {
    in property <string> url: "";
    in property <string> title: "";
    in property <bool> loading: false;
    in property <string> error: "";
    in property <[WebBlock]> blocks;
    in property <[TabRow]> tabs;
    in property <int> current-tab: 0;
    in property <bool> bookmarked: false;
    in property <bool> can-back: false;
    in property <[TabRow]> bookmarks;
    in property <int> scroll-reset: 0;
    callback go(string);
    callback back();
    callback reload();
    callback new-tab();
    callback select-tab(int);
    callback close-tab(int);
    callback toggle-bookmark();
}

export global Files {
    in-out property <string> view: "home";
    in property <string> title: "Files";
    in property <[CatRow]> categories;
    in property <string> storage: "";
    in property <float> storage-ratio: 0;
    in property <bool> scanning: false;
    in property <string> path-label: "Home";
    in property <bool> can-up: false;
    in property <[FileRow]> entries;
    in property <string> count-label: "";
    // Visore: "", "image", "video", "pdf", "text", "none"
    in property <string> viewer: "";
    in property <string> viewer-title: "";
    in property <string> viewer-pos: "";
    in property <image> viewer-image;
    in property <string> viewer-text: "";
    // Lettore
    in property <bool> playing: false;
    in property <float> progress: 0;
    in property <string> pos-label: "0:00";
    in property <string> dur-label: "0:00";
    in property <bool> audio-active: false;
    in-out property <bool> audio-full: false;
    in property <string> track-title: "";
    in property <string> track-artist: "";
    in property <image> track-cover;
    in property <bool> has-cover: false;
    in property <string> status: "";
    // Installatore APK
    in-out property <bool> apk-shown: false;
    in property <string> apk-label: "";
    in property <string> apk-package: "";
    in property <string> apk-version: "";
    in property <string> apk-details: "";
    in property <bool> apk-compat: true;
    in property <string> apk-note: "";
    // "ready", "installing", "done", "error"
    in property <string> apk-state: "ready";
    in property <string> apk-msg: "";
    callback apk-install();
    callback apk-open();
    callback open-home();
    callback open-category(string);
    callback open-storage();
    callback open(int);
    callback up();
    callback mkdir(string);
    callback remove(int);
    callback close-viewer();
    callback next();
    callback prev();
    callback play-pause();
    callback seek(float);
    callback track-next();
    callback track-prev();
    callback stop-audio();
}

export global Settings {
    in-out property <string> page: "";
    in property <bool> wifi-on: true;
    in property <[WifiRow]> networks;
    in property <bool> wifi-busy: false;
    in property <string> wifi-msg: "";
    in property <bool> bt-on: false;
    in property <[string]> bt-devices;
    in property <string> storage-used: "";
    in property <string> storage-total: "";
    in property <float> storage-ratio: 0;
    in property <string> modem-operator: "";
    in property <string> modem-signal: "";
    in property <string> modem-state: "";
    in property <string> timezone: "Europe/Rome";
    in property <string> info-name: "";
    in property <string> info-kind: "";
    in property <string> info-id: "";
    in property <string> info-glyph: "";
    in property <bool> info-android: false;
    in property <[SRow]> rows;
    in property <string> title: "Settings";
    in property <int> depth: 0;
    callback open-page(string);
    callback back();
    callback row-clicked(string);
    callback row-toggled(string, bool);
    callback row-slid(string, float);
    callback wifi-scan();
    callback wifi-connect(string, string);
}

// Aspetto: tema, sfondo, colori, forme e pacchetto icone
export global Style {
    // 0 scuro, 1 chiaro, 2 automatico
    in-out property <int> theme-mode: 0;
    in-out property <int> wallpaper: 0;
    in property <[image]> wallpapers: [
        @image-url("wallpapers/petal.jpg"), @image-url("wallpapers/lagoon.jpg"), @image-url("wallpapers/dune.jpg"),
        @image-url("wallpapers/bloom.jpg"), @image-url("wallpapers/graphite.jpg")];
    in property <[string]> wallpaper-names: ["Petal", "Lagoon", "Dune", "Bloom", "Graphite"];
    // 0 cerchio, 1 squircle, 2 cookie, 3 trifoglio, 4 sole
    in-out property <int> icon-shape: 2;
    // 0 a tema, 1 colori, 2 mono, 3 contorno
    in-out property <int> icon-pack: 0;
    // Inchiostro sopra lo sfondo (chiaro o scuro secondo la luminosita) e accento per l'orologio
    in property <color> wp-ink: #ffffff;
    in property <color> wp-accent: #d3e3fd;
    in property <bool> wp-light: false;
    in property <[Swatch]> swatches;
    in-out property <int> palette: 0;
    // 0 tonal spot, 1 vibrante, 2 espressivo, 3 neutro, 4 monocromo
    in-out property <int> scheme: 0;
    in-out property <float> font-scale: 1.0;
    in-out property <bool> bold-text: false;
    callback set-theme(int);
    callback set-wallpaper(int);
    callback set-palette(int);
    callback set-scheme(int);
    callback set-icon-shape(int);
    callback set-icon-pack(int);
}

export global Clock {
    in-out property <int> tab: 0;
    in property <[AlarmRow]> alarms;
    in property <string> next-alarm: "";
    in property <[CityRow]> cities;
    in property <string> local-city: "Rome";
    // Timer: 0 fermo, 1 in corso, 2 in pausa, 3 finito
    in property <int> timer-state: 0;
    in property <string> timer-label: "00:00";
    in property <float> timer-progress: 0;
    in-out property <string> timer-input: "";
    // Cronometro
    in property <string> sw-label: "00:00.00";
    in property <bool> sw-running: false;
    in property <float> sw-sweep: 0;
    in property <[LapRow]> laps;
    // Sveglia che suona
    in property <bool> ringing: false;
    in property <string> ring-time: "";
    in property <string> ring-label: "";
    in property <string> ring-kind: "alarm";
    callback alarm-add(int, int, string);
    callback alarm-toggle(int, bool);
    callback alarm-delete(int);
    callback alarm-day(int, int);
    callback city-add();
    callback city-remove(int);
    callback timer-start();
    callback timer-pause();
    callback timer-resume();
    callback timer-reset();
    callback timer-plus();
    callback sw-toggle();
    callback sw-lap();
    callback sw-reset();
    callback ring-stop();
    callback ring-snooze();
}
