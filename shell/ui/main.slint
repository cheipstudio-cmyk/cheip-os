import { Theme } from "theme.slint";
import { Style, Clock, Sys, Shell, Cal, Notes, Cam, Phone, Msg, Web, Files, Settings, ScreenId, AppEntry, NotifItem, ToggleItem, RecentItem, DayCell, EventItem, NoteItem, CallRow, ContactRow, ThreadRow, Bubble, WebBlock, TabRow, FileRow, WifiRow, CatRow, AlarmRow, CityRow, LapRow, SRow, Swatch } from "data.slint";
import { LockScreen, HomeScreen, ControlsPanel, SwitcherScreen } from "screens.slint";
import { CalendarApp, NotesApp, CameraApp } from "apps.slint";
import { PhoneApp, CallOverlay } from "phone.slint";
import { MessagesApp } from "messages.slint";
import { BrowserApp } from "browser.slint";
import { FilesApp } from "files.slint";
import { SettingsApp } from "settings.slint";
import { ClockApp, AlarmOverlay } from "clock.slint";
import { Icon, Icons } from "components.slint";
import { BootSplash } from "splash.slint";
import { Keyboard, Kbd } from "keyboard.slint";

export { Kbd, Theme, Icons, Style, Clock, Sys, Shell, Cal, Notes, Cam, Phone, Msg, Web, Files, Settings, ScreenId, AppEntry, NotifItem, ToggleItem, RecentItem, DayCell, EventItem, NoteItem, CallRow, ContactRow, ThreadRow, Bubble, WebBlock, TabRow, FileRow, WifiRow, CatRow, AlarmRow, CityRow, LapRow, SRow, Swatch }

export component AppWindow inherits Window {
    title: "Cheip OS";
    preferred-width: 360px;
    preferred-height: 640px;
    background: Theme.surface;
    default-font-family: "Google Sans Flex";

    property <bool> unlocked: Shell.screen != ScreenId.lock;
    property <bool> system-app: Shell.app-id == "calendar" || Shell.app-id == "notes" || Shell.app-id == "camera" || Shell.app-id == "settings" || Shell.app-id == "phone" || Shell.app-id == "messages" || Shell.app-id == "browser" || Shell.app-id == "files" || Shell.app-id == "clock";

    // Avanzamento del gesto di chiusura (0 = app intera, 1 = scheda piccola)
    property <float> drag-p: min(1, max(0, Shell.close-drag / 420px));
    property <bool> dragging: Shell.close-drag > 0px;
    // On-screen keyboard: open while a text field has focus, apps shrink above it
    property <bool> kb-open: TextInputInterface.text-input-focused;
    property <length> kb-h: root.kb-open ? kb.height : 0px;

    home := HomeScreen {
        width: root.width; height: root.height;
        shown: Shell.screen == ScreenId.home && !Shell.app-open;
        opacity: (Shell.app-open || Shell.screen == ScreenId.switcher) ? 0.15 + 0.85 * root.drag-p : 1;
        transform-scale: (Shell.app-open || Shell.screen == ScreenId.switcher) ? 0.92 + 0.08 * root.drag-p : 1;
        animate opacity, transform-scale { duration: root.dragging ? 0ms : Theme.slow; easing: Theme.ease; }
    }

    // Finestra app: nasce dall'icona toccata e si espande a tutto schermo.
    // Col gesto dal basso si rimpicciolisce seguendo il dito.
    host := Rectangle {
        property <bool> live: Shell.app-open || self.width > Shell.from-size + 4px;
        property <length> card-w: root.width * (1 - 0.42 * root.drag-p);
        property <length> card-h: root.height * (1 - 0.42 * root.drag-p);
        x: Shell.app-open ? (root.width - self.card-w) / 2 : Shell.from-x;
        y: Shell.app-open ? (root.height - self.card-h) / 2 - Shell.close-drag * 0.35 : Shell.from-y;
        width: Shell.app-open ? self.card-w : Shell.from-size;
        height: Shell.app-open ? self.card-h : Shell.from-size;
        border-radius: Shell.app-open ? 32px * min(1, root.drag-p * 4) : Shell.from-size * 0.4;
        visible: self.live;
        clip: true;
        background: Theme.surface;
        animate x, y, width, height, border-radius { duration: root.dragging ? 0ms : Theme.slow; easing: Theme.ease; }

        Rectangle {
            x: 0; y: 0;
            width: root.width; height: root.height - root.kb-h;
            transform-origin: { x: 0px, y: 0px };
            transform-scale: host.width / root.width;
            opacity: Shell.app-open ? 1 : 0;
            animate opacity { duration: 240ms; delay: Shell.app-open ? 90ms : 0ms; easing: ease-out; }
            if Shell.app-id == "phone": PhoneApp { }
            if Shell.app-id == "messages": MessagesApp { }
            if Shell.app-id == "browser": BrowserApp { }
            if Shell.app-id == "files": FilesApp { }
            if Shell.app-id == "calendar": CalendarApp { }
            if Shell.app-id == "notes": NotesApp { }
            if Shell.app-id == "camera": CameraApp { }
            if Shell.app-id == "settings": SettingsApp { }
            if Shell.app-id == "clock": ClockApp { }
            if !root.system-app: Rectangle {
                background: Theme.surface;
                Icon { y: 240px; d: Icons.android-f; size: 64px; tint: Theme.tertiary; }
                Text {
                    y: 320px; x: 32px; width: parent.width - 64px;
                    text: "Android app windows arrive when the shell becomes a Wayland compositor.";
                    color: Theme.muted; font-family: Theme.body; font-size: 14px;
                    wrap: word-wrap; horizontal-alignment: center;
                }
            }
        }
    }

    switcher := SwitcherScreen {
        width: root.width; height: root.height;
        y: Shell.screen == ScreenId.switcher ? 0px : root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    // Bordo alto: i Controlli scendono seguendo il dito
    if root.unlocked && !Shell.controls-open: TouchArea {
        y: 0; height: 28px;
        moved => { Shell.controls-drag = max(0px, self.mouse-y - self.pressed-y); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                if (Shell.controls-drag > 110px) { Shell.controls-open = true; }
                Shell.controls-drag = 0px;
            }
        }
    }

    // Barra gesti: l'app segue il dito; corto = home, lungo = app aperte
    if root.unlocked: Rectangle {
        y: root.height - 28px; height: 28px;
        Rectangle {
            y: 18px; width: 108px + 24px * root.drag-p; height: 5px; border-radius: 2.5px;
            background: (Shell.app-open || Shell.controls-open) ? Theme.on-surface.with-alpha(0.6) : Style.wp-ink.with-alpha(0.75);
        }
        TouchArea {
            moved => { Shell.close-drag = max(0px, self.pressed-y - self.mouse-y); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    let d = Shell.close-drag;
                    if (d > 170px) {
                        Shell.close-app();
                        Shell.screen = ScreenId.switcher;
                    } else if (d > 40px) {
                        Shell.close-app();
                        Shell.searching = false;
                        Shell.edit-mode = false;
                        Shell.screen = ScreenId.home;
                    }
                    Shell.close-drag = 0px;
                }
            }
        }
    }

    controls := ControlsPanel {
        width: root.width; height: root.height;
        y: Shell.controls-open ? -self.lift : -root.height + min(root.height, Shell.controls-drag * 1.15);
        animate y { duration: (Shell.controls-drag > 0px || self.lift > 0px) ? 0ms : 380ms; easing: spring(0.15); }
    }

    // Notifica a comparsa: scende dall'alto, tocca per aprire, scorri su per chiudere
    headsup := Rectangle {
        property <length> lift: 0px;
        x: 8px; width: root.width - 16px; height: 80px;
        y: Shell.headsup-shown && Shell.screen != ScreenId.lock ? 8px - self.lift : -110px;
        transform-scale: Shell.headsup-shown ? 1 : 0.9;
        animate y { duration: self.lift > 0px ? 0ms : 520ms; easing: spring(0.3); }
        animate transform-scale { duration: 520ms; easing: spring(0.3); }
        border-radius: 28px; background: Theme.container-high;
        drop-shadow-blur: 18px; drop-shadow-offset-y: 6px; drop-shadow-color: #00000050;
        Rectangle {
            x: 14px; width: 44px; height: 44px; border-radius: 22px; background: Theme.primary-container;
            Icon { d: Shell.headsup.glyph; size: 24px; tint: Theme.on-primary-container; }
        }
        VerticalLayout {
            x: 70px; width: parent.width - 86px; alignment: center; spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: Shell.headsup.app; color: Theme.on-surface; font-family: Theme.body; font-size: 15px; font-weight: 600; overflow: elide; }
                Text { text: "· " + Shell.headsup.time; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; vertical-alignment: center; }
                Rectangle { }
            }
            Text { text: Shell.headsup.text; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
        }
        TouchArea {
            moved => { headsup.lift = max(0px, self.pressed-y - self.mouse-y); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up) {
                    if (headsup.lift > 24px) { Shell.headsup-shown = false; }
                    else if (headsup.lift < 4px) { Shell.headsup-shown = false; Shell.open-notification(Shell.headsup.id); }
                    headsup.lift = 0px;
                }
            }
        }
    }

    lock := LockScreen {
        width: root.width; height: root.height;
        y: Shell.screen == ScreenId.lock ? 0px : -root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    call := CallOverlay {
        width: root.width; height: root.height;
        y: (Phone.in-call || Phone.incoming) ? 0px : root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    // Snackbar
    snack := Rectangle {
        x: 16px; width: root.width - 32px; height: 52px;
        y: Shell.toast-shown ? root.height - 120px : root.height + 20px;
        animate y { duration: 460ms; easing: spring(0.3); }
        border-radius: 12px; background: Theme.inverse-surface;
        drop-shadow-blur: 10px; drop-shadow-color: #00000040;
        Text { x: 18px; width: parent.width - 36px; height: parent.height; text: Shell.toast; color: Theme.inverse-on-surface; font-family: Theme.body; font-size: 15px; vertical-alignment: center; overflow: elide; }
    }

    alarm := AlarmOverlay {
        width: root.width; height: root.height;
        y: Clock.ringing ? 0px : root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    // Pannello volume stile Android 16: suoneria sopra, cursore verticale spesso
    hud := Rectangle {
        property <float> level: Sys.volume;
        x: Shell.volume-hud ? root.width - 80px : root.width + 10px;
        y: root.height * 0.2;
        width: 64px; height: 340px;
        animate x { duration: 460ms; easing: spring(0.3); }
        Rectangle {
            y: 0; height: 64px; border-radius: 32px; background: Theme.container-high;
            drop-shadow-blur: 12px; drop-shadow-color: #00000040;
            Rectangle {
                width: 48px; height: 48px; border-radius: rt.pressed ? 14px : 24px;
                background: Sys.ringer == 2 ? Theme.container-highest : Theme.primary;
                animate background { duration: Theme.fast; }
                animate border-radius { duration: 320ms; easing: spring(0.3); }
                Icon { d: Sys.ringer == 0 ? Icons.bell-f : (Sys.ringer == 1 ? Icons.vibrate-f : Icons.bell-off-f); tint: Sys.ringer == 2 ? Theme.on-surface : Theme.on-primary; size: 24px; }
                rt := TouchArea { clicked => { Shell.hud-touch(); Sys.set-ringer(mod(Sys.ringer + 1, 3)); } }
            }
        }
        Rectangle {
            y: 72px; height: 268px; border-radius: 32px; background: Theme.container-high;
            drop-shadow-blur: 12px; drop-shadow-color: #00000040;
            Rectangle {
                x: 8px; y: 8px; width: 48px; height: parent.height - 64px; border-radius: 24px; background: Theme.secondary-container; clip: true;
                Rectangle {
                    y: parent.height - self.height;
                    height: max(48px, parent.height * hud.level);
                    border-radius: 24px;
                    background: Sys.ringer == 2 ? Theme.outline : Theme.primary;
                    animate height { duration: 140ms; }
                    Icon { y: parent.height - 36px; d: hud.level < 0.01 ? Icons.mute-f : Icons.speaker-f; size: 24px; tint: Theme.on-primary; }
                }
                TouchArea {
                    moved => {
                        Shell.hud-touch();
                        Sys.volume = max(0, min(1, 1 - self.mouse-y / self.height));
                        Sys.volume-changed(Sys.volume);
                    }
                }
            }
            Icon { y: parent.height - 44px; d: Icons.tune; size: 22px; tint: Theme.on-surface-variant; }
        }
    }

    kb := Keyboard {
        width: root.width;
        y: root.kb-open ? root.height - self.height : root.height;
        animate y { duration: 220ms; easing: Theme.ease; }
    }

    // Screen off: everything black, swallows touches until the power key is pressed again
    if Shell.screen-off: Rectangle {
        background: black;
        TouchArea { }
    }

    // Boot animation on top of everything, removes itself when done
    if Shell.show-splash: BootSplash { width: root.width; height: root.height; }
}
