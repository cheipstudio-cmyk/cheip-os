import { Theme } from "theme.slint";
import { Setup, Calc, Style, Clock, Sys, Shell, Cal, Notes, Cam, Phone, Msg, Web, Files, Settings, ScreenId, AppEntry, NotifItem, ToggleItem, RecentItem, DayCell, EventItem, NoteItem, CallRow, ContactRow, ThreadRow, Bubble, WebBlock, TabRow, LogSection, FileRow, WifiRow, CatRow, AlarmRow, CityRow, LapRow, SRow, Swatch } from "data.slint";
import { LockScreen, HomeScreen, ControlsPanel, SwitcherScreen } from "screens.slint";
import { CalendarApp, NotesApp, CameraApp } from "apps.slint";
import { PhoneApp, CallOverlay } from "phone.slint";
import { MessagesApp } from "messages.slint";
import { BrowserApp } from "browser.slint";
import { FilesApp } from "files.slint";
import { SettingsApp } from "settings.slint";
import { ClockApp, AlarmOverlay } from "clock.slint";
import { CalculatorApp } from "calculator.slint";
import { SetupScreen } from "setup.slint";
import { Icon, Icons, StatusBar, Shapes } from "components.slint";
import { BootSplash } from "splash.slint";
import { Keyboard, Kbd } from "keyboard.slint";

export { Setup, Calc, Kbd, Theme, Icons, Style, Clock, Sys, Shell, Cal, Notes, Cam, Phone, Msg, Web, Files, Settings, ScreenId, AppEntry, NotifItem, ToggleItem, RecentItem, DayCell, EventItem, NoteItem, CallRow, ContactRow, ThreadRow, Bubble, WebBlock, TabRow, FileRow, WifiRow, CatRow, AlarmRow, CityRow, LapRow, SRow, Swatch }

// System log: what the phone is doing (cores, clock, charger, USB, network, input)
component LogApp inherits Rectangle {
    background: Theme.surface;
    // Read only while the app is open; sections keep their place
    Timer { interval: 4s; running: true; triggered => { Sys.refresh-log(); } }
    init => { Sys.refresh-log(); }
    StatusBar { y: 0; width: parent.width; }
    Text { x: 24px; y: 40px; text: "Log"; color: Theme.on-surface; font-family: Theme.display; font-size: 30px; font-weight: 500; }
    Text { x: 24px; y: 80px; width: parent.width - 48px; text: "What the phone is doing, updated every few seconds"; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; }
    Flickable {
        x: 16px; y: 112px; width: parent.width - 32px; height: parent.height - 120px;
        viewport-height: col.preferred-height + 24px;
        col := VerticalLayout {
            width: parent.width;
            spacing: 10px;
            for sec in Sys.log-sections: Rectangle {
                border-radius: 24px;
                background: Theme.container-high;
                height: body.preferred-height + 56px;
                Text {
                    x: 18px; y: 14px; text: sec.title;
                    color: Theme.primary; font-family: Theme.body; font-size: 14px; font-weight: 700;
                }
                body := Text {
                    x: 18px; y: 40px; width: parent.width - 36px;
                    text: sec.body; wrap: word-wrap;
                    color: Theme.on-surface; font-family: Theme.body; font-size: 13px;
                }
            }
        }
    }
}

// Navigation key: Expressive round touch target, Android-style glyph
component NavKey inherits Rectangle {
    in property <int> kind; // 0 back, 1 home (Cheip OS cookie), 2 recents
    in property <color> tint;
    callback tap();
    horizontal-stretch: 1;
    // Pillola di pressione che si allarga
    Rectangle {
        width: nta.pressed ? 56px : 36px; height: 32px; border-radius: 16px;
        background: nta.pressed ? root.tint.with-alpha(0.16) : transparent;
        animate width { duration: 180ms; easing: ease-out; }
    }
    // Indietro: freccia con estremi arrotondati
    if root.kind == 0: Path {
        width: 16px; height: 16px;
        viewbox-width: 16; viewbox-height: 16;
        commands: "M 10.5 2.5 L 4.5 8 L 10.5 13.5";
        stroke: root.tint; stroke-width: 2.2px; stroke-line-cap: round; fill: transparent;
    }
    // Home: la forma "cookie" del logo Cheip OS
    if root.kind == 1: Path {
        width: nta.pressed ? 17px : 19px; height: self.width;
        viewbox-width: 100; viewbox-height: 100;
        commands: "M100.00 50.00 L99.70 52.17 L98.86 54.27 L97.57 56.26 L96.02 58.11 L94.40 59.84 L92.90 61.50 L91.68 63.14 L90.84 64.86 L90.38 66.73 L90.25 68.77 L90.34 71.00 L90.47 73.36 L90.47 75.78 L90.17 78.13 L89.47 80.29 L88.30 82.14 L86.68 83.61 L84.68 84.68 L82.42 85.38 L80.04 85.80 L77.68 86.08 L75.48 86.38 L73.48 86.86 L71.73 87.64 L70.18 88.77 L68.77 90.25 L67.40 92.02 L65.98 93.91 L64.43 95.76 L62.69 97.37 L60.77 98.57 L58.68 99.24 L56.49 99.33 L54.27 98.86 L52.09 97.94 L50.00 96.73 L48.02 95.43 L46.13 94.25 L44.30 93.33 L42.45 92.80 L40.54 92.67 L38.50 92.90 L36.32 93.37 L34.02 93.91 L31.64 94.33 L29.27 94.45 L27.03 94.13 L25.00 93.30 L23.27 91.96 L21.87 90.17 L20.79 88.07 L19.96 85.80 L19.28 83.53 L18.59 81.41 L17.78 79.53 L16.71 77.93 L15.32 76.61 L13.62 75.48 L11.64 74.43 L9.53 73.36 L7.44 72.16 L5.55 70.73 L4.04 69.04 L3.02 67.10 L2.55 64.96 L2.63 62.69 L3.16 60.38 L3.98 58.11 L4.91 55.94 L5.75 53.87 L6.33 51.91 L6.54 50.00 L6.33 48.09 L5.75 46.13 L4.91 44.06 L3.98 41.89 L3.16 39.62 L2.63 37.31 L2.55 35.04 L3.02 32.90 L4.04 30.96 L5.55 29.27 L7.44 27.84 L9.53 26.64 L11.64 25.57 L13.62 24.52 L15.32 23.39 L16.71 22.07 L17.78 20.47 L18.59 18.59 L19.28 16.47 L19.96 14.20 L20.79 11.93 L21.87 9.83 L23.27 8.04 L25.00 6.70 L27.03 5.87 L29.27 5.55 L31.64 5.67 L34.02 6.09 L36.32 6.63 L38.50 7.10 L40.54 7.33 L42.45 7.20 L44.30 6.67 L46.13 5.75 L48.02 4.57 L50.00 3.27 L52.09 2.06 L54.27 1.14 L56.49 0.67 L58.68 0.76 L60.77 1.43 L62.69 2.63 L64.43 4.24 L65.98 6.09 L67.40 7.98 L68.77 9.75 L70.18 11.23 L71.73 12.36 L73.48 13.14 L75.48 13.62 L77.68 13.92 L80.04 14.20 L82.42 14.62 L84.68 15.32 L86.68 16.39 L88.30 17.86 L89.47 19.71 L90.17 21.87 L90.47 24.22 L90.47 26.64 L90.34 29.00 L90.25 31.23 L90.38 33.27 L90.84 35.14 L91.68 36.86 L92.90 38.50 L94.40 40.16 L96.02 41.89 L97.57 43.74 L98.86 45.73 L99.70 47.83 Z";
        stroke: root.tint; stroke-width: 2.2px; fill: transparent;
        animate width { duration: 160ms; easing: ease-out; }
    }
    // Recenti: due schede sovrapposte
    if root.kind == 2: Rectangle {
        width: 18px; height: 16px;
        Rectangle { x: 5px; y: 0px; width: 11px; height: 11px; border-radius: 3px; border-width: 2px; border-color: root.tint.with-alpha(0.55); }
        Rectangle { x: 1px; y: 4px; width: 11px; height: 11px; border-radius: 3px; border-width: 2.2px; border-color: root.tint; background: transparent; }
    }
    nta := TouchArea { clicked => { Shell.haptic(); root.tap(); } }
}

export component AppWindow inherits Window {
    title: "Cheip OS";
    preferred-width: 360px;
    preferred-height: 640px;
    background: Theme.surface;
    default-font-family: "Google Sans Flex";

    property <bool> unlocked: Shell.screen != ScreenId.lock;
    property <bool> system-app: Shell.app-id == "calendar" || Shell.app-id == "notes" || Shell.app-id == "camera" || Shell.app-id == "settings" || Shell.app-id == "phone" || Shell.app-id == "messages" || Shell.app-id == "browser" || Shell.app-id == "files" || Shell.app-id == "clock" || Shell.app-id == "log" || Shell.app-id == "calculator";

    // Avanzamento del gesto di chiusura (0 = app intera, 1 = scheda piccola)
    property <float> drag-p: min(1, max(0, Shell.close-drag / 420px));
    property <bool> dragging: Shell.close-drag > 0px;
    // On-screen keyboard: open while a text field has focus, apps shrink above it
    property <bool> kb-open: TextInputInterface.text-input-focused;
    property <length> kb-h: root.kb-open ? kb.height : 0px;
    property <length> nav-h: Sys.nav-buttons ? 40px : 0px;
    // Space at the bottom taken by the keyboard or the navigation buttons
    property <length> bottom-h: root.kb-open ? root.kb-h : (root.unlocked ? root.nav-h : 0px);

    home := HomeScreen {
        width: root.width; height: root.height; inset: root.bottom-h;
        shown: Shell.screen == ScreenId.home && !Shell.app-open;
        // Lite: never paint the home behind a full-screen app (translucent layers cost a full redraw)
        visible: !(Theme.lite && Shell.app-open && !root.dragging);
        opacity: (Shell.app-open || Shell.screen == ScreenId.switcher) ? 0.15 + 0.85 * root.drag-p : 1;
        transform-scale: (Shell.app-open || Shell.screen == ScreenId.switcher) ? 0.92 + 0.08 * root.drag-p : 1;
        animate opacity, transform-scale { duration: root.dragging ? 0ms : Theme.slow; easing: Theme.ease; }
    }

    // Finestra app: nasce dall'icona toccata e si espande a tutto schermo.
    // Col gesto dal basso si rimpicciolisce seguendo il dito.
    host := Rectangle {
        property <bool> live: Shell.app-open || self.width > Shell.from-size + 4px;
        property <length> card-w: root.width * (1 - 0.42 * root.drag-p);
        property <length> card-h: root.height * (1 - 0.42 * root.drag-p);
        x: Shell.app-open ? (root.width - self.card-w) / 2 : Shell.from-x;
        y: Shell.app-open ? (root.height - self.card-h) / 2 - Shell.close-drag * 0.35 : Shell.from-y;
        width: Shell.app-open ? self.card-w : Shell.from-size;
        height: Shell.app-open ? self.card-h : Shell.from-size;
        border-radius: Shell.app-open ? 32px * min(1, root.drag-p * 4) : Shell.from-size * 0.4;
        visible: self.live;
        clip: true;
        background: Theme.surface;
        animate x, y, width, height, border-radius { duration: root.dragging ? 0ms : Theme.slow; easing: Theme.ease; }

        Rectangle {
            x: 0; y: 0;
            width: root.width; height: root.height - root.bottom-h;
            transform-origin: { x: 0px, y: 0px };
            transform-scale: host.width / root.width;
            opacity: Shell.app-open ? 1 : 0;
            animate opacity { duration: 240ms; delay: Shell.app-open ? 90ms : 0ms; easing: ease-out; }
            if Shell.app-id == "phone": PhoneApp { }
            if Shell.app-id == "messages": MessagesApp { }
            if Shell.app-id == "browser": BrowserApp { }
            if Shell.app-id == "files": FilesApp { }
            if Shell.app-id == "calendar": CalendarApp { }
            if Shell.app-id == "notes": NotesApp { }
            if Shell.app-id == "camera": CameraApp { }
            if Shell.app-id == "settings": SettingsApp { }
            if Shell.app-id == "clock": ClockApp { }
            if Shell.app-id == "log": LogApp { }
            if Shell.app-id == "calculator": CalculatorApp { }
            if !root.system-app: Rectangle {
                background: Theme.surface;
                Icon { y: 240px; d: Icons.android-f; size: 64px; tint: Theme.tertiary; }
                Text {
                    y: 320px; x: 32px; width: parent.width - 64px;
                    text: "Android app windows arrive when the shell becomes a Wayland compositor.";
                    color: Theme.muted; font-family: Theme.body; font-size: 14px;
                    wrap: word-wrap; horizontal-alignment: center;
                }
            }
        }
    }

    switcher := SwitcherScreen {
        width: root.width; height: root.height - root.bottom-h;
        y: Shell.screen == ScreenId.switcher ? 0px : root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    // Bordo alto: i Controlli scendono seguendo il dito
    if root.unlocked && !Shell.controls-open: TouchArea {
        y: 0; height: 28px;
        moved => {
            // Lite: no finger-following (each frame is a full redraw on one core), open at once
            if (Theme.lite) {
                if (self.mouse-y - self.pressed-y > 50px) { Shell.controls-open = true; }
            } else {
                Shell.controls-drag = max(0px, self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                if (Shell.controls-drag > 110px) { Shell.controls-open = true; }
                Shell.controls-drag = 0px;
            }
        }
    }

    // Gesture navigation (chosen in Settings): short swipe up = home, long = recents.
    // Lite: the app does not follow the finger, the gesture is judged on release
    if root.unlocked && !root.kb-open && !Sys.nav-buttons: gbar := Rectangle {
        y: root.height - 28px; height: 28px;
        property <length> d: 0px;
        Rectangle {
            y: 18px; width: 108px + 24px * min(1, gbar.d / 170px); height: 5px; border-radius: 2.5px;
            background: (Shell.app-open || Shell.controls-open) ? Theme.on-surface.with-alpha(0.6) : Style.wp-ink.with-alpha(0.75);
        }
        TouchArea {
            moved => {
                parent.d = max(0px, self.pressed-y - self.mouse-y);
                if (!Theme.lite) { Shell.close-drag = parent.d; }
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    let d = parent.d;
                    if (d > 170px) {
                        Shell.controls-open = false;
                        Shell.close-app();
                        Shell.screen = ScreenId.switcher;
                    } else if (d > 40px) {
                        Shell.controls-open = false;
                        Shell.close-app();
                        Shell.searching = false;
                        Shell.edit-mode = false;
                        Shell.screen = ScreenId.home;
                    }
                    Shell.close-drag = 0px;
                    parent.d = 0px;
                }
            }
        }
    }

    // Three-button navigation: back, home, recents
    if root.unlocked && !root.kb-open && Sys.nav-buttons: Rectangle {
        y: root.height - root.nav-h; height: root.nav-h;
        background: Shell.app-open ? Theme.surface : transparent;
        HorizontalLayout {
            padding-left: 36px; padding-right: 36px;
            NavKey {
                kind: 0;
                tint: Shell.app-open || Shell.controls-open ? Theme.on-surface : Style.wp-ink;
                tap => {
                    if (Shell.controls-open) { Shell.controls-open = false; }
                    else if (Shell.app-open && Shell.app-id == "settings" && Settings.page != "") { Settings.page = ""; }
                    else if (Shell.app-open) { Shell.close-app(); Shell.screen = ScreenId.home; }
                    else if (Shell.searching || Shell.edit-mode) { Shell.searching = false; Shell.edit-mode = false; }
                    else { Shell.screen = ScreenId.home; }
                }
            }
            NavKey {
                kind: 1;
                tint: Shell.app-open || Shell.controls-open ? Theme.on-surface : Style.wp-ink;
                tap => {
                    Shell.controls-open = false;
                    Shell.close-app();
                    Shell.searching = false;
                    Shell.edit-mode = false;
                    Shell.screen = ScreenId.home;
                }
            }
            NavKey {
                kind: 2;
                tint: Shell.app-open || Shell.controls-open ? Theme.on-surface : Style.wp-ink;
                tap => {
                    Shell.controls-open = false;
                    if (Shell.screen == ScreenId.switcher) { Shell.screen = ScreenId.home; }
                    else { Shell.close-app(); Shell.screen = ScreenId.switcher; }
                }
            }
        }
    }

    controls := ControlsPanel {
        width: root.width; height: root.height;
        y: Shell.controls-open ? -self.lift : -root.height + min(root.height, Shell.controls-drag * 1.15);
        animate y { duration: (Shell.controls-drag > 0px || self.lift > 0px) ? 0ms : (Theme.lite ? 260ms : 380ms); easing: Theme.lite ? ease-out : spring(0.15); }
    }

    // Notifica a comparsa: scende dall'alto, tocca per aprire, scorri su per chiudere
    headsup := Rectangle {
        property <length> lift: 0px;
        x: 8px; width: root.width - 16px; height: 80px;
        y: Shell.headsup-shown && Shell.screen != ScreenId.lock ? 8px - self.lift : -110px;
        transform-scale: Shell.headsup-shown ? 1 : 0.9;
        animate y { duration: self.lift > 0px ? 0ms : (Theme.lite ? 260ms : 520ms); easing: Theme.lite ? ease-out : spring(0.3); }
        animate transform-scale { duration: Theme.lite ? 0ms : 520ms; easing: spring(0.3); }
        border-radius: 28px; background: Theme.container-high;
        drop-shadow-blur: Theme.lite ? 0px : 18px; drop-shadow-offset-y: 6px; drop-shadow-color: #00000050;
        Rectangle {
            x: 14px; width: 44px; height: 44px; border-radius: 22px; background: Theme.primary-container;
            Icon { d: Shell.headsup.glyph; size: 24px; tint: Theme.on-primary-container; }
        }
        VerticalLayout {
            x: 70px; width: parent.width - 86px; alignment: center; spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: Shell.headsup.app; color: Theme.on-surface; font-family: Theme.body; font-size: 15px; font-weight: 600; overflow: elide; }
                Text { text: "· " + Shell.headsup.time; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; vertical-alignment: center; }
                Rectangle { }
            }
            Text { text: Shell.headsup.text; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
        }
        TouchArea {
            moved => { headsup.lift = max(0px, self.pressed-y - self.mouse-y); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up) {
                    if (headsup.lift > 24px) { Shell.headsup-shown = false; }
                    else if (headsup.lift < 4px) { Shell.headsup-shown = false; Shell.open-notification(Shell.headsup.id); }
                    headsup.lift = 0px;
                }
            }
        }
    }

    lock := LockScreen {
        width: root.width; height: root.height;
        y: Shell.screen == ScreenId.lock ? 0px : -root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    call := CallOverlay {
        width: root.width; height: root.height;
        y: (Phone.in-call || Phone.incoming) ? 0px : root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    // Snackbar
    snack := Rectangle {
        x: 16px; width: root.width - 32px; height: 52px;
        y: Shell.toast-shown ? root.height - 120px : root.height + 20px;
        animate y { duration: 460ms; easing: spring(0.3); }
        border-radius: 12px; background: Theme.inverse-surface;
        drop-shadow-blur: Theme.lite ? 0px : 10px; drop-shadow-color: #00000040;
        Text { x: 18px; width: parent.width - 36px; height: parent.height; text: Shell.toast; color: Theme.inverse-on-surface; font-family: Theme.body; font-size: 15px; vertical-alignment: center; overflow: elide; }
    }

    // Prima accensione: sopra a tutto
    if Setup.show: SetupScreen { width: root.width; height: root.height; }

    alarm := AlarmOverlay {
        width: root.width; height: root.height;
        y: Clock.ringing ? 0px : root.height;
        animate y { duration: Theme.slow; easing: Theme.ease; }
    }

    // Pannello volume stile Android 16: suoneria sopra, cursore verticale spesso
    hud := Rectangle {
        property <float> level: Sys.volume;
        x: Shell.volume-hud ? root.width - 80px : root.width + 10px;
        y: root.height * 0.2;
        width: 64px; height: 340px;
        animate x { duration: 460ms; easing: spring(0.3); }
        Rectangle {
            y: 0; height: 64px; border-radius: 32px; background: Theme.container-high;
            drop-shadow-blur: Theme.lite ? 0px : 12px; drop-shadow-color: #00000040;
            Rectangle {
                width: 48px; height: 48px; border-radius: rt.pressed ? 14px : 24px;
                background: Sys.ringer == 2 ? Theme.container-highest : Theme.primary;
                animate background { duration: Theme.fast; }
                animate border-radius { duration: 320ms; easing: spring(0.3); }
                Icon { d: Sys.ringer == 0 ? Icons.bell-f : (Sys.ringer == 1 ? Icons.vibrate-f : Icons.bell-off-f); tint: Sys.ringer == 2 ? Theme.on-surface : Theme.on-primary; size: 24px; }
                rt := TouchArea { clicked => { Shell.hud-touch(); Sys.set-ringer(mod(Sys.ringer + 1, 3)); } }
            }
        }
        Rectangle {
            y: 72px; height: 268px; border-radius: 32px; background: Theme.container-high;
            drop-shadow-blur: Theme.lite ? 0px : 12px; drop-shadow-color: #00000040;
            Rectangle {
                x: 8px; y: 8px; width: 48px; height: parent.height - 64px; border-radius: 24px; background: Theme.secondary-container; clip: true;
                Rectangle {
                    y: parent.height - self.height;
                    height: max(48px, parent.height * hud.level);
                    border-radius: 24px;
                    background: Sys.ringer == 2 ? Theme.outline : Theme.primary;
                    animate height { duration: 140ms; }
                    Icon { y: parent.height - 36px; d: hud.level < 0.01 ? Icons.mute-f : Icons.speaker-f; size: 24px; tint: Theme.on-primary; }
                }
                TouchArea {
                    moved => {
                        Shell.hud-touch();
                        Sys.volume = max(0, min(1, 1 - self.mouse-y / self.height));
                        Sys.volume-changed(Sys.volume);
                    }
                }
            }
            Icon { y: parent.height - 44px; d: Icons.tune; size: 22px; tint: Theme.on-surface-variant; }
        }
    }

    // Takes the focus away from text fields so the keyboard closes
    kb-sink := FocusScope { width: 0px; height: 0px; }
    // ...also by itself: going home, switching app, opening the switcher, locking
    property <bool> app-open-now: Shell.app-open;
    property <string> app-now: Shell.app-id;
    property <ScreenId> screen-now: Shell.screen;
    property <bool> off-now: Shell.screen-off;
    changed app-open-now => { kb-sink.focus(); }
    changed app-now => { kb-sink.focus(); }
    changed screen-now => { kb-sink.focus(); }
    changed off-now => { kb-sink.focus(); }
    kb := Keyboard {
        done => { kb-sink.focus(); }
        width: root.width;
        y: root.kb-open ? root.height - self.height : root.height;
        animate y { duration: Theme.fast; easing: Theme.ease; }
    }

    // No backlight control (UEFI framebuffer): dim with black on top. AMOLED: darker pixels are dimmer
    if !Sys.has-backlight && Sys.brightness < 0.98: Rectangle {
        background: #000000.with-alpha((1 - max(0.08, Sys.brightness)) * 0.9);
    }

    // Power menu: three big Expressive pills over a dimmed screen
    if Shell.power-menu: Rectangle {
        background: #000000b0;
        TouchArea { clicked => { Shell.power-menu = false; } }
        VerticalLayout {
            x: 28px; width: root.width - 56px;
            y: (root.height - self.preferred-height) / 2;
            spacing: 14px;
            for item in [
                { id: "off", label: "Power off", icon: Icons.power-f },
                { id: "reboot", label: "Restart", icon: Icons.restart-f },
                { id: "lock", label: "Lock", icon: Icons.lock-f },
            ]: Rectangle {
                height: 76px;
                border-radius: 38px;
                background: pta.pressed ? Theme.primary : (item.id == "off" ? Theme.primary-container : Theme.container-high);
                Icon { x: 26px; d: item.icon; size: 28px; tint: pta.pressed ? Theme.on-primary : (item.id == "off" ? Theme.on-primary-container : Theme.on-surface); }
                Text {
                    x: 74px; text: item.label;
                    color: pta.pressed ? Theme.on-primary : (item.id == "off" ? Theme.on-primary-container : Theme.on-surface);
                    font-family: Theme.display; font-size: 22px; font-weight: 500; vertical-alignment: center;
                }
                pta := TouchArea { clicked => { Shell.power-menu = false; Shell.power-action(item.id); } }
            }
        }
    }

    // Charger plugged in: Expressive pulse with the bolt, about two seconds
    if Shell.charge-anim: Rectangle {
        background: #000000e6;
        property <bool> grown: false;
        Timer { interval: 30ms; running: !parent.grown; triggered => { parent.grown = true; } }
        Path {
            width: 200px; height: 200px;
            commands: Shapes.cookie; viewbox-width: 100; viewbox-height: 100;
            fill: Theme.primary-container;
            transform-scale: parent.grown ? 1 : 0.2;
            transform-rotation: parent.grown ? 30deg : 0deg;
            animate transform-scale { duration: 700ms; easing: spring(0.35); }
            animate transform-rotation { duration: 1800ms; easing: Theme.decel; }
        }
        Icon { d: Icons.bolt-f; size: 72px; tint: Theme.on-primary-container; }
        Text {
            y: parent.height / 2 + 130px; width: parent.width;
            text: Sys.has-battery ? "Charging · " + Sys.battery + "%" : "Charging";
            color: white; font-family: Theme.display; font-size: 24px; font-weight: 500; horizontal-alignment: center;
        }
        TouchArea { }
    }

    // Screen off: everything black, swallows touches until the power key is pressed again
    if Shell.screen-off: Rectangle {
        background: black;
        TouchArea { }
    }

    // Boot animation on top of everything, removes itself when done
    if Shell.show-splash: BootSplash { width: root.width; height: root.height; }
}
