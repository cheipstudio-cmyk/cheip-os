import { Theme } from "theme.slint";
import { Msg } from "data.slint";
import { Icon, Icons, StatusBar, RoundButton, Title, Avatar, Field } from "components.slint";

export component MessagesApp inherits Rectangle {
    background: Theme.bg;
    property <bool> composing: false;
    property <string> to-number;
    property <bool> in-thread: Msg.open-number != "" || root.composing;

    StatusBar { y: 0; width: parent.width; }

    // Elenco conversazioni
    if !root.in-thread: Rectangle {
        Title { x: 16px; y: 34px; text: "Messaggi"; }
        RoundButton {
            x: parent.width - 60px; y: 32px; icon: Icons.plus; fill: Theme.accent; tint: #000; outlined: false;
            clicked => { root.composing = true; }
        }
        Flickable {
            x: 16px; y: 92px; width: parent.width - 32px; height: parent.height - 92px - 32px;
            content-height: Msg.threads.length * 72px;
            for t[i] in Msg.threads: Rectangle {
                y: i * 72px; height: 72px;
                background: ta.pressed ? Theme.raised : transparent;
                Avatar { x: 0; initial: t.initial; }
                VerticalLayout {
                    x: 56px; width: parent.width - 110px; alignment: center; spacing: 3px;
                    Text { text: t.name; color: Theme.text; font-family: Theme.body; font-size: 15px; font-weight: t.unread > 0 ? 600 : 400; overflow: elide; }
                    Text { text: t.last; color: t.unread > 0 ? Theme.text : Theme.muted; font-family: Theme.body; font-size: 13px; overflow: elide; }
                }
                Text { x: parent.width - self.width; y: 16px; text: t.when; color: Theme.faint; font-family: Theme.body; font-size: 11px; }
                if t.unread > 0: Rectangle {
                    x: parent.width - 18px; y: 40px; width: 18px; height: 18px; border-radius: 9px; background: Theme.accent;
                    Text { text: t.unread; color: #000; font-family: Theme.body; font-size: 10px; font-weight: 600; }
                }
                ta := TouchArea { clicked => { Msg.open-thread(t.number); } }
            }
        }
        if Msg.threads.length == 0: VerticalLayout {
            y: 220px; alignment: start; spacing: 12px;
            Icon { x: (parent.width - 48px) / 2; d: Icons.message; size: 48px; tint: Theme.faint; weight: 1.5px; }
            if Msg.status != "": Text { text: Msg.status; color: Theme.faint; font-family: Theme.body; font-size: 13px; horizontal-alignment: center; }
        }
    }

    // Conversazione
    if root.in-thread: Rectangle {
        RoundButton {
            x: 12px; y: 30px; icon: Icons.back; outlined: false;
            clicked => { root.composing = false; Msg.close-thread(); }
        }
        if !root.composing: Text {
            x: 64px; y: 30px; height: 44px; width: parent.width - 80px;
            text: Msg.open-name;
            color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 20px;
            vertical-alignment: center; overflow: elide;
        }
        if root.composing: Field {
            x: 64px; y: 30px; width: parent.width - 80px;
            text <=> root.to-number;
            placeholder: "Numero"; kind: InputType.number;
        }

        flick := Flickable {
            x: 12px; y: 84px; width: parent.width - 24px; height: parent.height - 84px - 76px;
            content-height: col.preferred-height;
            content-y: min(0px, self.height - col.preferred-height);
            col := VerticalLayout {
                width: flick.width;
                spacing: 6px;
                padding-bottom: 8px;
                for m in Msg.messages: HorizontalLayout {
                    alignment: m.out ? end : start;
                    Rectangle {
                        max-width: flick.width * 0.8;
                        border-radius: 18px;
                        background: m.out ? Theme.accent : Theme.raised;
                        VerticalLayout {
                            padding-left: 14px; padding-right: 14px; padding-top: 9px; padding-bottom: 7px;
                            spacing: 2px;
                            Text { text: m.text; color: m.out ? #000 : Theme.text; font-family: Theme.body; font-size: 15px; wrap: word-wrap; }
                            Text { text: m.when; color: m.out ? #00000099 : Theme.faint; font-family: Theme.body; font-size: 10px; horizontal-alignment: right; }
                        }
                    }
                }
            }
        }

        composer := Field {
            x: 12px; y: parent.height - 68px; width: parent.width - 80px; height: 48px;
            placeholder: "Messaggio";
        }
        RoundButton {
            x: parent.width - 60px; y: parent.height - 66px; size: 44px;
            icon: Icons.send; fill: Theme.accent; tint: #000; outlined: false;
            clicked => {
                if (composer.text != "") {
                    if (root.composing) {
                        Msg.send(root.to-number, composer.text);
                        root.to-number = "";
                        root.composing = false;
                    } else {
                        Msg.send(Msg.open-number, composer.text);
                    }
                    composer.clear();
                }
            }
        }
    }
}
