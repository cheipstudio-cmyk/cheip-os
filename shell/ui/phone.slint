import { Theme } from "theme.slint";
import { Phone, Sys } from "data.slint";
import { Icon, Icons, StatusBar, RoundButton, Card, Title, Avatar, Field, NavBar, Fab, EmptyState } from "components.slint";

// Tasto del tastierino: pillola tonale che si fa piu squadrata quando premuta
component Key inherits Rectangle {
    in property <string> digit;
    in property <string> letters;
    callback pressed-key(string);
    border-radius: ta.pressed ? 18px : self.height / 2;
    background: ta.pressed ? Theme.primary-container : Theme.container-high;
    animate border-radius { duration: 300ms; easing: spring(0.35); }
    animate background { duration: 120ms; }
    Text {
        y: root.letters == "" ? 0px : root.height * 0.12;
        height: root.letters == "" ? parent.height : parent.height * 0.6;
        width: parent.width;
        text: root.digit; color: ta.pressed ? Theme.on-primary-container : Theme.on-surface;
        font-family: Theme.display; font-weight: 500; font-size: 30px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.letters != "": Text {
        y: parent.height * 0.66; width: parent.width;
        text: root.letters; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 10px; font-weight: 600; letter-spacing: 1.5px;
        horizontal-alignment: center;
    }
    ta := TouchArea { clicked => { root.pressed-key(root.digit); } }
}

// Riga di elenco dentro un gruppo a schede
component PersonRow inherits Rectangle {
    in property <string> initial;
    in property <string> name;
    in property <string> detail;
    in property <string> trailing;
    in property <int> hue;
    in property <bool> alert;
    in property <string> glyph;
    callback clicked();
    height: 68px;
    background: ta.pressed ? Theme.container-highest : Theme.container-high;
    animate background { duration: 120ms; }
    Avatar { x: 16px; y: 12px; initial: root.initial; size: 44px; hue: root.hue; }
    if root.glyph != "": Rectangle {
        x: 44px; y: 40px; width: 20px; height: 20px; border-radius: 10px;
        background: root.alert ? Theme.error-container : Theme.surface;
        Icon { d: root.glyph; size: 12px; tint: root.alert ? Theme.on-error-container : Theme.on-surface-variant; }
    }
    VerticalLayout {
        x: 74px; width: parent.width - 74px - 72px; alignment: center; spacing: 2px;
        Text { text: root.name; color: root.alert ? Theme.error : Theme.on-surface; font-family: Theme.body; font-size: 16px; font-weight: 500; overflow: elide; }
        Text { text: root.detail; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; overflow: elide; }
    }
    Text {
        x: parent.width - self.width - 16px; height: parent.height;
        text: root.trailing; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 12px; vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component PhoneApp inherits Rectangle {
    background: Theme.surface;
    property <bool> adding: false;
    property <length> body-h: root.height - 96px - 80px;

    StatusBar { y: 0; width: parent.width; }
    Text {
        x: 24px; y: 40px;
        text: Phone.tab == 0 ? "Phone" : Phone.tab == 1 ? "Recents" : "Contacts";
        color: Theme.on-surface; font-family: Theme.display; font-size: 30px; font-weight: 500;
    }
    if !Phone.modem-ok: Rectangle {
        x: parent.width - self.width - 20px; y: 46px; height: 28px;
        width: warn.preferred-width + 24px;
        border-radius: 14px; background: Theme.container-high;
        warn := Text { text: Phone.modem-label; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 11px; }
    }

    // Tastierino
    if Phone.tab == 0: Rectangle {
        y: 96px; height: root.body-h;
        property <length> gap: 10px;
        property <length> key-w: (self.width - 48px - 2 * self.gap) / 3;
        property <length> key-h: min(60px, (self.height - 88px - 88px - 3 * self.gap) / 4);
        // Numero composto
        Rectangle {
            x: 16px; y: 0px; width: parent.width - 32px; height: 72px; border-radius: 28px;
            background: Theme.container;
            Text {
                x: 20px; width: parent.width - 84px; height: parent.height;
                text: Phone.dial != "" ? Phone.dial : "Enter a number";
                color: Phone.dial != "" ? Theme.on-surface : Theme.on-surface-variant;
                font-family: Phone.dial != "" ? Theme.display : Theme.body;
                font-size: Phone.dial == "" ? 16px : Phone.dial.character-count > 12 ? 26px : 34px;
                font-weight: Phone.dial != "" ? 500 : 400;
                vertical-alignment: center; overflow: elide;
            }
            if Phone.dial != "": RoundButton {
                x: parent.width - 56px; y: 14px; icon: Icons.back; tint: Theme.on-surface-variant;
                clicked => { Phone.dial = ""; }
            }
        }
        for k[i] in [
            {d: "1", l: ""}, {d: "2", l: "ABC"}, {d: "3", l: "DEF"},
            {d: "4", l: "GHI"}, {d: "5", l: "JKL"}, {d: "6", l: "MNO"},
            {d: "7", l: "PQRS"}, {d: "8", l: "TUV"}, {d: "9", l: "WXYZ"},
            {d: "*", l: ""}, {d: "0", l: "+"}, {d: "#", l: ""}
        ]: Key {
            x: 24px + mod(i, 3) * (parent.key-w + parent.gap);
            y: 88px + floor(i / 3) * (parent.key-h + parent.gap);
            width: parent.key-w; height: parent.key-h;
            digit: k.d; letters: k.l;
            pressed-key(d) => { Phone.dial += d; }
        }
        // Chiama: grande pulsante squadrato come quello dell'Orologio
        Rectangle {
            property <bool> ready: Phone.dial != "";
            x: (parent.width - self.width) / 2; y: parent.height - 80px;
            width: 136px; height: 68px;
            border-radius: cta.pressed ? 20px : 36px;
            background: ready ? Theme.primary : Theme.container-high;
            animate border-radius { duration: 300ms; easing: spring(0.35); }
            animate background { duration: 200ms; }
            accessible-role: button; accessible-label: "Call";
            Icon { d: Icons.phone-f; tint: ready ? Theme.on-primary : Theme.on-surface-variant; size: 30px; }
            cta := TouchArea { clicked => { if (Phone.dial != "") { Phone.call(Phone.dial); } } }
        }
    }

    // Recenti
    if Phone.tab == 1: Rectangle {
        y: 96px; height: root.body-h;
        Flickable {
            x: 16px; width: parent.width - 32px; height: parent.height;
            content-height: Phone.recents.length * 70px + 16px;
            for c[i] in Phone.recents: PersonRow {
                y: i * 70px; width: parent.width;
                border-top-left-radius: i == 0 ? 28px : 6px;
                border-top-right-radius: i == 0 ? 28px : 6px;
                border-bottom-left-radius: i == Phone.recents.length - 1 ? 28px : 6px;
                border-bottom-right-radius: i == Phone.recents.length - 1 ? 28px : 6px;
                initial: c.initial;
                name: c.name; detail: c.number; trailing: c.when; hue: i;
                alert: c.dir == "missed";
                glyph: c.dir == "out" ? Icons.out-arrow : c.dir == "missed" ? Icons.missed : Icons.in-arrow;
                clicked => { Phone.call(c.number); }
            }
        }
        if Phone.recents.length == 0: EmptyState {
            icon: Icons.history; title: "No calls yet"; hint: "Calls you make and receive show up here";
        }
    }

    // Contatti
    if Phone.tab == 2: Rectangle {
        y: 96px; height: root.body-h;
        if root.adding: Rectangle {
            x: 16px; width: parent.width - 32px; height: 236px; border-radius: 28px;
            background: Theme.container-high;
            VerticalLayout {
                padding: 16px; spacing: 10px; alignment: start;
                Text { text: "New contact"; color: Theme.on-surface; font-family: Theme.display; font-size: 20px; font-weight: 500; }
                name := Field { placeholder: "Name"; }
                num := Field { placeholder: "Number"; kind: InputType.number; }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    Rectangle {
                        width: 96px; height: 44px; border-radius: 22px; background: Theme.container-highest;
                        Text { text: "Cancel"; color: Theme.on-surface; font-family: Theme.body; font-size: 14px; font-weight: 600; }
                        TouchArea { clicked => { root.adding = false; } }
                    }
                    Rectangle {
                        width: 96px; height: 44px; border-radius: 22px; background: Theme.primary;
                        Text { text: "Save"; color: Theme.on-primary; font-family: Theme.body; font-size: 14px; font-weight: 600; }
                        TouchArea {
                            clicked => {
                                if (name.text != "" && num.text != "") {
                                    Phone.add-contact(name.text, num.text);
                                    root.adding = false;
                                }
                            }
                        }
                    }
                }
            }
        }
        if !root.adding: Flickable {
            x: 16px; width: parent.width - 32px; height: parent.height;
            content-height: Phone.contacts.length * 70px + 96px;
            for c[i] in Phone.contacts: PersonRow {
                y: i * 70px; width: parent.width;
                border-top-left-radius: i == 0 ? 28px : 6px;
                border-top-right-radius: i == 0 ? 28px : 6px;
                border-bottom-left-radius: i == Phone.contacts.length - 1 ? 28px : 6px;
                border-bottom-right-radius: i == Phone.contacts.length - 1 ? 28px : 6px;
                initial: c.initial; name: c.name; detail: c.number; hue: i;
                glyph: "";
                clicked => { Phone.call(c.number); }
            }
        }
        if !root.adding && Phone.contacts.length == 0: EmptyState {
            icon: Icons.user; title: "No contacts yet"; hint: "Tap Contact to add one";
        }
        if !root.adding: Fab {
            x: parent.width - self.width - 20px; y: parent.height - self.height - 16px;
            icon: Icons.plus; label: "Contact";
            clicked => { root.adding = true; }
        }
    }

    NavBar {
        y: parent.height - 80px; width: parent.width;
        selected <=> Phone.tab;
        items: [
            { label: "Keypad", icon: Icons.keypad, icon-f: Icons.keypad-f },
            { label: "Recents", icon: Icons.history, icon-f: Icons.history-f },
            { label: "Contacts", icon: Icons.user, icon-f: Icons.user-f },
        ];
    }
}

// Chiamata in corso o in arrivo: sopra a tutto, anche al blocco
export component CallOverlay inherits Rectangle {
    background: Theme.surface;
    TouchArea { }
    Avatar {
        x: (parent.width - 96px) / 2; y: 120px; size: 96px;
        initial: Phone.call-initial;
    }
    Text {
        y: 240px; width: parent.width;
        text: Phone.call-name;
        color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 30px;
        horizontal-alignment: center;
    }
    Text {
        y: 284px; width: parent.width;
        text: Phone.call-number;
        color: Theme.muted; font-family: Theme.body; font-size: 15px;
        horizontal-alignment: center;
    }
    Text {
        y: 314px; width: parent.width;
        text: Phone.incoming ? (Sys.ringer == 2 ? "Incoming call · silent" : "Incoming call") : (Phone.call-time != "" ? Phone.call-time : Phone.call-state);
        color: Theme.accent; font-family: Theme.body; font-size: 14px; font-weight: 600;
        horizontal-alignment: center;
    }
    if Phone.incoming: Rectangle {
        x: 64px; y: parent.height - 160px; width: 72px; height: 72px; border-radius: 36px;
        background: Theme.error;
        accessible-role: button; accessible-label: "Decline";
        Icon { d: Icons.hangup; tint: Theme.on-error; size: 28px; }
        TouchArea { clicked => { Phone.hangup(); } }
    }
    // Rispondi: pulsa mentre squilla
    if Phone.incoming: Rectangle {
        x: parent.width - 136px; y: parent.height - 160px; width: 72px; height: 72px; border-radius: 36px;
        background: Theme.accent.with-alpha(0.25);
        transform-scale: 1 + 0.35 * mod(animation-tick() / 1ms, 1400) / 1400;
        opacity: 1 - mod(animation-tick() / 1ms, 1400) / 1400;
    }
    if Phone.incoming: Rectangle {
        x: parent.width - 136px; y: parent.height - 160px; width: 72px; height: 72px; border-radius: 36px;
        background: Theme.accent;
        transform-rotation: sin(animation-tick() / 1ms * 0.02rad) * 8deg;
        accessible-role: button; accessible-label: "Answer";
        Icon { d: Icons.phone; tint: Theme.on-primary; size: 28px; }
        TouchArea { clicked => { Phone.answer(); } }
    }
    if !Phone.incoming: Rectangle {
        x: (parent.width - 72px) / 2; y: parent.height - 160px; width: 72px; height: 72px; border-radius: 36px;
        background: Theme.error;
        accessible-role: button; accessible-label: "End call";
        Icon { d: Icons.hangup; tint: Theme.on-error; size: 28px; }
        TouchArea { clicked => { Phone.hangup(); } }
    }
}
