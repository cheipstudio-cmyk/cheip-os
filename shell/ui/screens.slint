import { Theme } from "theme.slint";
import { Sys, Shell, AppEntry, RecentItem, ScreenId } from "data.slint";
import { Icon, Icons, StatusBar, Badge, RoundButton, PillButton, Card } from "components.slint";

// ---------- Blocco ----------
export component LockScreen inherits Rectangle {
    background: Theme.bg;
    property <length> drag: ta.pressed ? min(0px, ta.mouse-y - ta.pressed-y) : 0px;

    ta := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && self.pressed-y - self.mouse-y > 100px) {
                Shell.unlock();
            }
        }
    }

    Rectangle {
        y: root.drag;
        opacity: max(0, 1 + root.drag / 300px);
        animate y { duration: Theme.slow; easing: Theme.ease; }

        StatusBar { y: 0; width: parent.width; show-time: false; }

        Text {
            y: 88px; width: parent.width; height: 92px;
            text: Sys.hours;
            color: Theme.text;
            font-family: Theme.display; font-weight: 700; font-size: 96px; letter-spacing: -4px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            y: 180px; width: parent.width; height: 92px;
            text: Sys.minutes;
            color: Theme.accent;
            font-family: Theme.display; font-weight: 700; font-size: 96px; letter-spacing: -4px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            y: 282px; width: parent.width;
            text: Sys.date;
            color: Theme.muted; font-family: Theme.body; font-size: 15px;
            horizontal-alignment: center;
        }

        VerticalLayout {
            y: 330px;
            x: 16px;
            width: parent.width - 32px;
            height: 150px;
            spacing: 8px;
            alignment: start;
            for n in Sys.notifications: Card {
                height: 62px;
                VerticalLayout {
                    padding-left: 14px; padding-right: 14px; padding-top: 11px; padding-bottom: 11px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: n.app; color: Theme.muted; font-family: Theme.body; font-size: 12px; }
                        if n.android: Badge { }
                        Rectangle { }
                        Text { text: n.time; color: Theme.muted; font-family: Theme.body; font-size: 12px; }
                    }
                    Text { text: n.text; color: Theme.text; font-family: Theme.body; font-size: 14px; overflow: elide; }
                }
            }
        }

        Text {
            y: parent.height - 44px; width: parent.width;
            text: "Scorri in alto per sbloccare";
            color: Theme.muted; font-family: Theme.body; font-size: 13px;
            horizontal-alignment: center;
        }
    }

    RoundButton { x: 24px; y: root.height - 112px; size: 48px; icon: Icons.torch; clicked => { Sys.toggle("torcia"); } }
    RoundButton { x: root.width - 72px; y: root.height - 112px; size: 48px; icon: Icons.camera; clicked => { Shell.unlock(); Shell.open-app("camera", root.height - 112px); } }
}

// ---------- Home ----------
component AppRow inherits Rectangle {
    in property <AppEntry> app;
    callback activated(length);
    height: 44px;
    Text {
        x: 0;
        text: root.app.name;
        color: ta.pressed ? Theme.accent : Theme.text;
        font-family: Theme.display; font-weight: 500; font-size: 26px; letter-spacing: -0.5px;
        vertical-alignment: center;
        animate color { duration: Theme.fast; }
    }
    if root.app.android: Badge { x: parent.width - 14px; }
    ta := TouchArea { clicked => { root.activated(root.absolute-position.y); } }
}

export component HomeScreen inherits Rectangle {
    background: Theme.bg;

    StatusBar { y: 0; width: parent.width; }

    VerticalLayout {
        x: 24px; y: 48px; width: parent.width - 48px;
        spacing: 4px;
        alignment: start;
        Text {
            text: Sys.time;
            color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 68px; letter-spacing: -2px;
            height: 70px;
        }
        Text { text: Sys.date; color: Theme.muted; font-family: Theme.body; font-size: 15px; }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            alignment: start;
            Rectangle { width: 8px; height: 8px; y: 5px; border-radius: 4px; background: Theme.accent; }
            Text {
                text: Sys.notifications.length == 0 ? "Nessuna notifica" : (Sys.notifications.length == 1 ? "1 notifica" : Sys.notifications.length + " notifiche");
                color: Theme.text; font-family: Theme.body; font-size: 13px;
            }
        }
    }

    list := Flickable {
        x: 24px; y: 196px;
        width: parent.width - 48px;
        height: parent.height - 196px - 84px;
        content-height: Shell.apps.length * 44px;
        for a[i] in Shell.apps: AppRow {
            y: i * 44px;
            width: list.width;
            app: a;
            activated(ay) => { Shell.open-app(a.id, ay); }
        }
    }

    search := Rectangle {
        x: 16px; y: parent.height - 76px;
        width: parent.width - 32px; height: 44px;
        border-radius: 22px; border-width: 1px; border-color: Theme.line;
        Icon { x: 16px; d: Icons.search; size: 16px; tint: Theme.muted; }
        Text {
            x: 42px;
            text: "Cerca app, file, impostazioni";
            visible: input.text == "";
            color: Theme.muted; font-family: Theme.body; font-size: 14px;
            vertical-alignment: center; height: parent.height;
        }
        input := TextInput {
            x: 42px; width: parent.width - 58px; height: parent.height;
            color: Theme.text; font-family: Theme.body; font-size: 14px;
            vertical-alignment: center; single-line: true;
            edited => { Shell.search(self.text); }
        }
    }
}

// ---------- Controlli ----------
component ToggleTile inherits Rectangle {
    in property <string> label;
    in property <string> sub;
    in property <bool> on;
    callback clicked();
    height: 60px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line;
    background: root.on ? Theme.accent : Theme.bg;
    animate background, border-color { duration: Theme.fast; easing: Theme.ease; }
    VerticalLayout {
        padding-left: 14px;
        alignment: center;
        spacing: 2px;
        Text { text: root.label; color: root.on ? #000 : Theme.text; font-family: Theme.body; font-size: 14px; font-weight: 600; }
        Text { text: root.sub; color: root.on ? #000000c0 : Theme.muted; font-family: Theme.body; font-size: 12px; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component ControlsPanel inherits Rectangle {
    background: Theme.bg;

    StatusBar { y: 0; width: parent.width; }

    Text {
        x: 16px; y: 34px;
        text: "Controlli";
        color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 28px; letter-spacing: -0.5px;
    }

    for t[i] in Sys.toggles: ToggleTile {
        x: 16px + mod(i, 2) * ((root.width - 40px) / 2 + 8px);
        y: 84px + floor(i / 2) * 68px;
        width: (root.width - 40px) / 2;
        label: t.label; sub: t.sub; on: t.on;
        clicked => { Sys.toggle(t.id); }
    }

    // Luminosità
    Text { x: 16px; y: 298px; text: "Luminosità"; color: Theme.muted; font-family: Theme.body; font-size: 12px; }
    bright := Rectangle {
        x: 16px; y: 318px; width: parent.width - 32px; height: 28px;
        Rectangle {
            y: 10px; height: 8px; border-radius: 4px; background: #1c1c1c; clip: true;
            Rectangle { x: 0; width: parent.width * Sys.brightness; background: Theme.text; }
        }
        TouchArea {
            moved => {
                Sys.brightness = max(0.05, min(1.0, self.mouse-x / self.width));
                Sys.brightness-changed(Sys.brightness);
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    Sys.brightness = max(0.05, min(1.0, self.mouse-x / self.width));
                    Sys.brightness-changed(Sys.brightness);
                }
            }
        }
    }

    // Memoria
    Card {
        x: 16px; y: 360px; width: parent.width - 32px; height: 78px;
        Text { x: 14px; y: 12px; text: "Memoria"; color: Theme.text; font-family: Theme.body; font-size: 13px; font-weight: 600; }
        Text { x: parent.width - self.width - 14px; y: 12px; text: Sys.mem-used + " / " + Sys.mem-total + " MB"; color: Theme.muted; font-family: Theme.body; font-size: 13px; }
        Rectangle {
            x: 14px; y: 36px; width: parent.width - 28px; height: 6px; border-radius: 3px; background: #1c1c1c; clip: true;
            Rectangle { x: 0; width: parent.width * (Sys.mem-used - Sys.mem-android) / max(1, Sys.mem-total); background: Theme.text; animate width { duration: Theme.slow; easing: Theme.ease; } }
            Rectangle { x: parent.width * (Sys.mem-used - Sys.mem-android) / max(1, Sys.mem-total); width: parent.width * Sys.mem-android / max(1, Sys.mem-total); background: Theme.accent; }
        }
        Text { x: 14px; y: 52px; text: "Sistema " + (Sys.mem-used - Sys.mem-android) + " MB    App Android " + Sys.mem-android + " MB"; color: Theme.muted; font-family: Theme.body; font-size: 11px; }
    }

    // Livello Android
    Card {
        x: 16px; y: 446px; width: parent.width - 32px; height: 64px;
        VerticalLayout {
            x: 14px; width: parent.width - 120px;
            alignment: center; spacing: 2px;
            Text { text: "Livello Android"; color: Theme.text; font-family: Theme.body; font-size: 13px; font-weight: 600; }
            Text { text: Sys.android-state; color: Theme.muted; font-family: Theme.body; font-size: 12px; overflow: elide; }
        }
        PillButton {
            x: parent.width - self.width - 14px; y: 15px;
            label: Sys.android-running ? "Sospendi" : "Avvia";
            solid: true;
            clicked => { Sys.android-toggle(); }
        }
    }

    // Aggiornamenti
    Card {
        x: 16px; y: 518px; width: parent.width - 32px; height: 64px;
        VerticalLayout {
            x: 14px; width: parent.width - 120px;
            alignment: center; spacing: 2px;
            Text { text: Sys.update-available ? "Cheip OS " + Sys.update-version : "Cheip OS " + Sys.version; color: Theme.text; font-family: Theme.body; font-size: 13px; font-weight: 600; }
            Text { text: Sys.update-state; color: Theme.muted; font-family: Theme.body; font-size: 12px; overflow: elide; }
        }
        PillButton {
            x: parent.width - self.width - 14px; y: 15px;
            label: Sys.update-available ? "Installa" : "Controlla";
            solid: Sys.update-available;
            clicked => { if (Sys.update-available) { Sys.install-update(); } else { Sys.check-update(); } }
        }
    }

    // Maniglia: trascina su per chiudere
    Rectangle {
        y: parent.height - 24px; height: 24px;
        Rectangle { width: 96px; height: 4px; border-radius: 2px; background: #5a5a5a; }
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up) { Shell.controls-open = false; }
            }
        }
    }
}

// ---------- App aperte ----------
component RecentCard inherits Card {
    in property <RecentItem> item;
    callback open();
    callback close();
    height: 84px;
    Rectangle {
        x: 14px; width: 40px; height: 60px; border-radius: 6px; background: #141414;
        Rectangle { x: 6px; y: 10px; width: 28px; height: 4px; border-radius: 2px; background: #3a3a3a; }
        Rectangle { x: 6px; y: 18px; width: 20px; height: 4px; border-radius: 2px; background: #3a3a3a; }
        Rectangle { x: 6px; y: 26px; width: 24px; height: 4px; border-radius: 2px; background: #3a3a3a; }
    }
    TouchArea { clicked => { root.open(); } }
    VerticalLayout {
        x: 66px; width: parent.width - 120px;
        alignment: center; spacing: 4px;
        HorizontalLayout {
            spacing: 6px; alignment: start;
            Text { text: root.item.name; color: Theme.text; font-family: Theme.display; font-weight: 500; font-size: 18px; }
            if root.item.android: Badge { y: 5px; }
        }
        Text { text: root.item.mem > 0 ? root.item.mem + " MB · " + root.item.state : root.item.state; color: Theme.muted; font-family: Theme.body; font-size: 12px; }
    }
    RoundButton {
        x: parent.width - 52px; y: 20px;
        icon: Icons.close; outlined: false; tint: Theme.muted;
        clicked => { root.close(); }
    }
}

export component SwitcherScreen inherits Rectangle {
    background: Theme.bg;
    StatusBar { y: 0; width: parent.width; }
    Text {
        x: 16px; y: 34px;
        text: "App aperte";
        color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 28px; letter-spacing: -0.5px;
    }
    Text {
        x: parent.width - self.width - 16px; y: 46px;
        text: Shell.recents.length + " app";
        color: Theme.muted; font-family: Theme.body; font-size: 13px;
    }
    Flickable {
        x: 16px; y: 84px; width: parent.width - 32px; height: parent.height - 84px - 84px;
        content-height: Shell.recents.length * 92px;
        for r[i] in Shell.recents: RecentCard {
            y: i * 92px;
            width: parent.width;
            item: r;
            animate y { duration: Theme.slow; easing: Theme.ease; }
            open => { Shell.screen = ScreenId.home; Shell.open-app(r.id, 200px); }
            close => { Shell.close-recent(r.id); }
        }
    }
    if Shell.recents.length == 0: Text {
        y: 140px; width: parent.width;
        text: "Nessuna app aperta";
        color: Theme.faint; font-family: Theme.body; font-size: 14px;
        horizontal-alignment: center;
    }
    Rectangle {
        x: 16px; y: parent.height - 72px; width: parent.width - 32px; height: 48px;
        border-radius: 24px; background: ta.pressed ? #d0d0d0 : Theme.text;
        Text { text: "Chiudi tutto e libera memoria"; color: #000; font-family: Theme.body; font-size: 14px; font-weight: 600; }
        ta := TouchArea { clicked => { Shell.close-all(); } }
    }
}
