import { Theme } from "theme.slint";
import { Sys, Shell, Settings, AppEntry, RecentItem, ScreenId, NotifItem, Style, Clock } from "data.slint";
import { Icon, Icons, StatusBar, Badge, AppIcon, Dot, RoundButton, PillButton, Card, Title, Slider } from "components.slint";

// Sfondo con velo leggero per la leggibilita
export component Wallpaper inherits Rectangle {
    in property <float> dim: 0;
    clip: true;
    Image {
        width: root.width; height: root.height;
        source: Style.wallpapers[Style.wallpaper];
        image-fit: cover;
    }
    Rectangle { background: #000000.with-alpha(root.dim); animate background { duration: Theme.slow; } }
}

// ---------- Notifica: tocca per aprire, scorri di lato per eliminare ----------
export component NotifCard inherits Rectangle {
    in property <NotifItem> item;
    in property <bool> compact: false;
    in property <bool> first: true;
    in property <bool> last: true;
    callback open();
    callback dismiss();
    property <length> dx: 0px;
    property <bool> gone: false;
    height: 76px;
    Rectangle {
        x: root.gone ? (root.dx > 0 ? root.width * 1.2 : -root.width * 1.2) : root.dx;
        width: root.width; height: root.height;
        opacity: 1 - min(1, abs(self.x) / (root.width * 0.9));
        animate x { duration: nt.pressed ? 0ms : 420ms; easing: spring(0.25); }
        border-top-left-radius: root.first || abs(root.dx) > 2px ? 24px : 6px;
        border-top-right-radius: root.first || abs(root.dx) > 2px ? 24px : 6px;
        border-bottom-left-radius: root.last || abs(root.dx) > 2px ? 24px : 6px;
        border-bottom-right-radius: root.last || abs(root.dx) > 2px ? 24px : 6px;
        animate border-top-left-radius, border-top-right-radius, border-bottom-left-radius, border-bottom-right-radius { duration: 300ms; easing: spring(0.3); }
        background: nt.pressed && abs(root.dx) < 6px ? Theme.container-highest : Theme.container-high;
        animate background { duration: Theme.fast; }
        Rectangle {
            x: 14px; width: 40px; height: 40px; border-radius: 20px;
            background: root.item.android ? Theme.tertiary-container : Theme.primary-container;
            Icon { d: root.item.glyph; size: 22px; tint: root.item.android ? Theme.on-tertiary-container : Theme.on-primary-container; }
        }
        VerticalLayout {
            x: 66px; width: parent.width - 80px;
            alignment: center; spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.item.app; color: Theme.on-surface; font-family: Theme.body; font-size: 15px; font-weight: 600; overflow: elide; }
                Text { text: "· " + root.item.time; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; vertical-alignment: center; }
                Rectangle { }
            }
            Text { text: root.item.text; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
        }
        nt := TouchArea {
            moved => { root.dx = self.mouse-x - self.pressed-x; }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up) {
                    if (abs(root.dx) > 100px) { root.gone = true; root.dismiss(); }
                    else if (abs(root.dx) < 6px) { root.open(); }
                    root.dx = root.gone ? root.dx : 0px;
                }
            }
        }
    }
}

// ---------- Blocco: orologio grande stile Pixel sullo sfondo ----------
export component LockScreen inherits Rectangle {
    property <length> drag: ta.pressed ? min(0px, ta.mouse-y - ta.pressed-y) : 0px;
    property <float> p: min(1, -root.drag / 300px);

    Wallpaper { dim: (Style.wp-light ? 0 : 0.18) + 0.4 * root.p; }

    ta := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && self.pressed-y - self.mouse-y > 100px) {
                Shell.unlock();
            }
        }
    }

    Rectangle {
        y: root.drag * 0.6;
        opacity: max(0, 1 - root.p * 1.3);
        transform-scale: 1 - 0.06 * root.p;
        animate y { duration: Theme.slow; easing: Theme.ease; }

        StatusBar { y: 0; width: parent.width; show-time: false; fg: Style.wp-ink; }

        // Orologio impilato, cifre larghe e arrotondate
        Text {
            y: 70px; width: parent.width; height: 128px;
            text: Sys.hours;
            color: Style.wp-accent;
            font-family: Theme.display; font-weight: 500; font-size: 132px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            y: 182px; width: parent.width; height: 128px;
            text: Sys.minutes;
            color: Style.wp-accent;
            font-family: Theme.display; font-weight: 500; font-size: 132px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        HorizontalLayout {
            y: 318px; height: 24px;
            alignment: center; spacing: 8px;
            Text { text: Sys.date; color: Style.wp-ink; font-family: Theme.body; font-size: 16px; font-weight: 500; vertical-alignment: center; }
            if Clock.next-alarm != "": Icon { d: Icons.alarm-f; size: 16px; tint: Style.wp-ink; y: 4px; }
            if Clock.next-alarm != "": Text { text: Clock.next-alarm; color: Style.wp-ink; font-family: Theme.body; font-size: 16px; vertical-alignment: center; }
        }

        VerticalLayout {
            y: 362px;
            x: 12px;
            width: parent.width - 24px;
            height: 160px;
            spacing: 2px;
            alignment: start;
            for n[i] in Sys.notifications: NotifCard {
                height: 72px;
                item: n;
                first: i == 0; last: i == Sys.notifications.length - 1;
                open => { Shell.open-notification(n.id); }
                dismiss => { Shell.dismiss-notification(n.id); }
            }
        }

        Text {
            y: parent.height - 44px; width: parent.width;
            text: "Swipe up to unlock";
            color: Style.wp-ink.with-alpha(0.8); font-family: Theme.body; font-size: 13px;
            horizontal-alignment: center;
        }
    }

    // Scorciatoie in basso, pulsanti tonali che si allargano alla pressione
    for s[i] in [{ g: Icons.torch-f, id: "torcia" }, { g: Icons.camera-f, id: "camera" }]: Rectangle {
        x: i == 0 ? 28px : root.width - 28px - self.width;
        y: root.height - 104px;
        width: sta.pressed ? 76px : 60px; height: 60px;
        border-radius: 30px;
        background: Theme.container-high.with-alpha(0.9);
        animate width { duration: 380ms; easing: spring(0.35); }
        Icon { d: s.g; size: 24px; tint: Theme.on-surface; }
        sta := TouchArea {
            clicked => {
                if (s.id == "torcia") { Sys.toggle("torcia"); }
                else { Shell.unlock(); Shell.open-app("camera", self.absolute-position.x, self.absolute-position.y, 60px); }
            }
        }
    }
}

// ---------- Home ----------
component MenuRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: 48px;
    background: ta.pressed ? Theme.state-pressed : transparent;
    opacity: root.enabled ? 1 : 0.38;
    Icon { x: 16px; d: root.icon; size: 22px; tint: root.danger ? Theme.error : Theme.on-surface-variant; }
    Text { x: 52px; height: parent.height; text: root.label; color: root.danger ? Theme.error : Theme.on-surface; font-family: Theme.body; font-size: 15px; vertical-alignment: center; }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Widget tile: label, big value, Expressive progress bar (frac < 0 hides it)
component WTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub: "";
    in property <float> frac: 0;
    in property <float> frac2: 0;
    in property <bool> warn: false;
    horizontal-stretch: 1;
    border-radius: 24px;
    background: Theme.surface.with-alpha(0.86);
    Text { x: 14px; y: 12px; width: parent.width - 28px; text: root.label; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 12px; overflow: elide; }
    Text { x: 14px; y: 30px; width: parent.width - 28px; text: root.value; color: root.warn ? Theme.error : Theme.on-surface; font-family: Theme.display; font-size: 19px; font-weight: 500; overflow: elide; }
    if root.sub != "": Text { x: 14px; y: 60px; width: parent.width - 28px; text: root.sub; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 12px; overflow: elide; }
    if root.frac >= 0: Rectangle {
        x: 14px; y: parent.height - 24px; width: parent.width - 28px; height: 10px; border-radius: 5px;
        background: Theme.secondary-container; clip: true;
        Rectangle { x: 0; width: parent.width * max(0, min(1, root.frac - root.frac2)); border-radius: 5px; background: root.warn ? Theme.error : Theme.primary; }
        if root.frac2 > 0: Rectangle { x: parent.width * max(0, root.frac - root.frac2) + 2px; width: parent.width * root.frac2; border-radius: 5px; background: Theme.tertiary; }
    }
}

export component HomeScreen inherits Rectangle {
    in property <bool> shown: true;
    property <length> col-w: (root.width - 24px) / 4;
    property <length> row-h: 92px;
    property <length> icon: 60px;
    property <length> dock-y: root.height - 152px;
    property <bool> widget: Sys.w-show && (Sys.w-ram || Sys.w-bat || Sys.w-disk || Sys.w-weather) && !Shell.searching && !Shell.edit-mode;
    property <length> grid-y: self.widget ? 226px : 150px;
    property <int> n: Shell.apps.length;
    property <int> press-index: -1;
    property <int> drag-index: -1;
    property <int> target-index: -1;
    property <bool> long-fired: false;
    property <bool> moved-far: false;
    property <length> px; property <length> py;
    property <int> menu-index: -1;
    property <bool> menu-dock: false;
    property <AppEntry> menu-app;
    property <length> menu-x; property <length> menu-y;
    property <length> menu-anchor-y;
    property <length> menu-h: 44px + (root.menu-dock ? 2 : (root.menu-app.android ? 4 : 3)) * 48px;

    pure function index-at(x: length, y: length) -> int {
        if (x < 0 || y < 0) { return -1; }
        let col = min(3, floor(x / root.col-w));
        let i = floor(y / root.row-h) * 4 + col;
        return i < root.n ? i : -1;
    }
    pure function slot-of(i: int) -> int {
        if (root.drag-index < 0 || root.target-index < 0) { return i; }
        if (root.drag-index < root.target-index && i > root.drag-index && i <= root.target-index) { return i - 1; }
        if (root.drag-index > root.target-index && i >= root.target-index && i < root.drag-index) { return i + 1; }
        return i;
    }
    function open-menu(i: int, dock: bool, a: AppEntry, ax: length, ay: length) {
        root.menu-index = i;
        root.menu-dock = dock;
        root.menu-app = a;
        root.menu-anchor-y = ay;
        root.menu-x = max(12px, min(root.width - 236px, ax + root.icon / 2 - 112px));
        root.menu-y = ay > root.height * 0.55 ? ay - 12px - root.menu-h : ay + root.icon + 12px;
    }
    function close-menu() { root.menu-index = -1; }

    Wallpaper { dim: Shell.edit-mode || root.menu-index >= 0 ? 0.35 : (Theme.dark ? 0.12 : 0); }

    StatusBar { y: 0; width: parent.width; fg: Style.wp-ink; }

    // Colpo d'occhio: data e prossima sveglia
    Rectangle {
        y: 44px; height: 90px;
        opacity: (Shell.searching || Shell.edit-mode) ? 0 : 1;
        animate opacity { duration: Theme.fast; }
        Text {
            x: 24px; y: 4px;
            text: Sys.date;
            color: Style.wp-ink; font-family: Theme.display; font-weight: 500; font-size: 26px;
        }
        HorizontalLayout {
            x: 24px; y: 42px; height: 22px; spacing: 6px;
            Icon { d: Clock.next-alarm != "" ? Icons.alarm-f : Icons.bolt-f; size: 18px; tint: Style.wp-ink; y: 2px; }
            Text {
                text: Clock.next-alarm != "" ? "Alarm " + Clock.next-alarm : (!Sys.has-battery ? "Battery level not available" : (Sys.charging ? "Charging · " + Sys.battery + "%" : Sys.battery + "% battery"));
                color: Style.wp-ink; font-family: Theme.body; font-size: 15px; vertical-alignment: center;
            }
        }
    }

    // Customisable widget: memory, battery, storage, weather
    if root.widget: HorizontalLayout {
        x: 16px; y: 122px; width: root.width - 32px; height: 96px;
        spacing: 8px;
        if Sys.w-ram: WTile {
            label: "Memory"; value: Sys.mem-used + " / " + Sys.mem-total + " MB";
            frac: Sys.mem-used / max(1, Sys.mem-total); frac2: Sys.mem-android / max(1, Sys.mem-total);
        }
        if Sys.w-bat: WTile {
            label: Sys.charging ? "Charging" : "Battery";
            value: Sys.has-battery ? Sys.battery + "%" : "--";
            frac: Sys.has-battery ? Sys.battery / 100 : 0;
            warn: Sys.has-battery && Sys.battery <= 20 && !Sys.charging;
        }
        if Sys.w-disk: WTile { label: "Storage"; value: Sys.disk-used; frac: Sys.disk-frac; }
        if Sys.w-weather: WTile {
            label: Sys.weather-city == "" ? "Weather" : Sys.weather-city;
            value: Sys.weather-temp == "" ? (Sys.weather-city == "" ? "Set a city" : "No internet") : Sys.weather-temp;
            sub: Sys.weather-desc; frac: -1;
        }
    }

    if Sys.diag != "": Text {
        x: 24px; y: root.height - 150px; width: root.width - 48px;
        text: Sys.diag; wrap: word-wrap;
        color: Style.wp-ink; font-family: Theme.body; font-size: 12px;
    }

    // Modalita modifica
    Rectangle {
        x: (root.width - 110px) / 2; y: Shell.edit-mode ? 52px : 20px; width: 110px; height: 48px;
        border-radius: 24px; background: Theme.primary;
        opacity: Shell.edit-mode ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: 420ms; easing: spring(0.35); }
        Text { text: "Done"; color: Theme.on-primary; font-family: Theme.body; font-size: 16px; font-weight: 600; }
        TouchArea { clicked => { Shell.edit-mode = false; } }
    }
    Text {
        y: 112px; width: root.width;
        text: "Hold and drag to rearrange";
        color: Style.wp-ink; font-family: Theme.body; font-size: 14px; horizontal-alignment: center;
        opacity: Shell.edit-mode ? 1 : 0;
        animate opacity { duration: Theme.fast; }
    }

    grid := Flickable {
        x: 12px; y: root.grid-y;
        width: parent.width - 24px;
        height: root.dock-y - root.grid-y - 8px;
        content-height: max(self.height, ceil(root.n / 4) * root.row-h);
        interactive: root.drag-index < 0 && !root.long-fired;

        for a[i] in Shell.apps: Rectangle {
            property <int> slot: root.slot-of(i);
            x: mod(slot, 4) * root.col-w + (root.col-w - root.icon) / 2;
            y: floor(slot / 4) * root.row-h + 12px;
            width: root.icon; height: root.icon;
            animate x, y { duration: 380ms; easing: spring(0.3); }
            opacity: i == root.drag-index ? 0 : (root.shown ? 1 : 0);
            animate opacity { duration: 220ms; delay: root.shown ? min(i, 12) * 18ms : 0ms; easing: Theme.decel; }
            transform-scale: root.shown ? 1 : 0.7;
            animate transform-scale { duration: 520ms; delay: root.shown ? min(i, 12) * 18ms : 0ms; easing: spring(0.4); }
            transform-rotation: Shell.edit-mode ? sin((animation-tick() / 1ms + i * 97) * 0.012rad) * 2.4deg : 0deg;
            AppIcon {
                app: a; interactive: false; size: root.icon;
                pressed: root.press-index == i && root.drag-index < 0 && !root.moved-far;
            }
            Dot { x: root.icon - 16px; y: -2px; count: a.badge; }
            if Shell.edit-mode && a.android: Rectangle {
                x: -6px; y: -6px; width: 26px; height: 26px; border-radius: 13px; background: Theme.error;
                Icon { d: Icons.close; size: 16px; tint: Theme.on-error; }
                TouchArea { clicked => { Shell.uninstall(a.id); } }
            }
        }

        grid-touch := TouchArea {
            width: parent.width;
            height: grid.content-height;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.press-index = root.index-at(self.mouse-x, self.mouse-y);
                    root.long-fired = false;
                    root.moved-far = false;
                    root.px = self.mouse-x; root.py = self.mouse-y;
                    if (root.menu-index >= 0) { root.close-menu(); }
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    if (root.drag-index >= 0) {
                        if (root.target-index >= 0 && root.target-index != root.drag-index) {
                            Shell.move-app(root.drag-index, root.target-index);
                        }
                        root.drag-index = -1;
                        root.target-index = -1;
                    } else if (!root.long-fired && !root.moved-far && ev.kind == PointerEventKind.up) {
                        if (root.press-index >= 0 && !Shell.edit-mode) {
                            Shell.open-app(Shell.apps[root.press-index].id,
                                grid.absolute-position.x + mod(root.press-index, 4) * root.col-w + (root.col-w - root.icon) / 2,
                                grid.absolute-position.y + floor(root.press-index / 4) * root.row-h + 12px + grid.content-y, root.icon);
                        } else if (root.press-index < 0 && Shell.edit-mode) {
                            Shell.edit-mode = false;
                        }
                    }
                    root.press-index = -1;
                    root.long-fired = false;
                }
            }
            moved => {
                root.px = self.mouse-x; root.py = self.mouse-y;
                if (abs(self.mouse-x - self.pressed-x) > 10px || abs(self.mouse-y - self.pressed-y) > 10px) {
                    root.moved-far = true;
                }
                if (root.drag-index >= 0) {
                    let t = root.index-at(max(0, min(self.width - 1px, self.mouse-x)), max(0, self.mouse-y));
                    if (t >= 0) { root.target-index = t; }
                } else if (root.long-fired && root.moved-far && root.press-index >= 0) {
                    root.close-menu();
                    Shell.edit-mode = true;
                    root.drag-index = root.press-index;
                    root.target-index = root.press-index;
                }
            }
        }

        Timer {
            interval: 400ms;
            running: grid-touch.pressed && root.press-index >= 0 && !root.long-fired && !root.moved-far;
            triggered => {
                root.long-fired = true;
                if (Shell.edit-mode) {
                    root.drag-index = root.press-index;
                    root.target-index = root.press-index;
                } else {
                    root.open-menu(root.press-index, false, Shell.apps[root.press-index],
                        grid.absolute-position.x + mod(root.press-index, 4) * root.col-w + (root.col-w - root.icon) / 2,
                        grid.absolute-position.y + floor(root.press-index / 4) * root.row-h + 12px + grid.content-y);
                }
            }
        }

        if root.drag-index >= 0: Rectangle {
            x: root.px - root.icon / 2; y: root.py - root.icon * 0.7;
            width: root.icon; height: root.icon;
            transform-scale: 1.2;
            AppIcon { app: Shell.apps[root.drag-index]; interactive: false; size: root.icon; }
        }
    }

    // Dock: icone fisse come sui Pixel
    dock := Rectangle {
        x: 12px; width: root.width - 24px;
        y: root.dock-y; height: 76px;
        for a[i] in Shell.dock: Rectangle {
            x: i * (dock.width / 4) + (dock.width / 4 - root.icon) / 2;
            y: 8px;
            width: root.icon; height: root.icon;
            AppIcon { app: a; size: root.icon; interactive: false; pressed: dt.pressed && !dt.long; }
            Dot { x: root.icon - 16px; y: -2px; count: a.badge; }
            dt := TouchArea {
                property <bool> long: false;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) { self.long = false; if (root.menu-index >= 0) { root.close-menu(); } }
                }
                clicked => {
                    if (!self.long) { Shell.open-app(a.id, self.absolute-position.x, self.absolute-position.y, root.icon); }
                }
            }
            Timer {
                interval: 400ms;
                running: dt.pressed && !dt.long;
                triggered => {
                    dt.long = true;
                    root.open-menu(i, true, a, dt.absolute-position.x, dt.absolute-position.y);
                }
            }
        }
    }

    // Barra di ricerca in basso
    search := Rectangle {
        x: 16px; width: root.width - 32px;
        y: Shell.searching ? 44px : root.height - 70px;
        height: 56px;
        border-radius: 28px;
        background: Theme.container-high;
        animate y { duration: 460ms; easing: spring(0.3); }
        Icon { x: 18px; d: Icons.search; size: 24px; tint: Theme.on-surface-variant; }
        if !Shell.searching: Text {
            x: 54px; height: parent.height;
            text: "Search apps and web";
            color: Theme.on-surface-variant; font-family: Theme.body; font-size: 16px;
            vertical-alignment: center;
        }
        if !Shell.searching: Icon { x: parent.width - 42px; d: Icons.mic-f; size: 22px; tint: Theme.primary; }
        if !Shell.searching: TouchArea { clicked => { Shell.edit-mode = false; Shell.searching = true; } }
        if Shell.searching: q := TextInput {
            x: 54px; width: parent.width - 110px; height: parent.height;
            color: Theme.on-surface; font-family: Theme.body; font-size: 16px;
            vertical-alignment: center; single-line: true;
            edited => { Shell.search(self.text); }
            init => { self.focus(); }
        }
        if Shell.searching: RoundButton {
            x: parent.width - 50px; y: 6px; size: 44px;
            icon: Icons.close; tint: Theme.on-surface-variant;
            clicked => { Shell.search(""); Shell.searching = false; }
        }
    }

    // Menu contestuale
    if root.menu-index >= 0: Rectangle {
        TouchArea { clicked => { root.close-menu(); } }
    }
    menu := Rectangle {
        x: root.menu-x; y: root.menu-y;
        width: 224px; height: root.menu-h;
        border-radius: 24px; background: Theme.container;
        drop-shadow-blur: Theme.lite ? 0px : 16px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000040;
        opacity: root.menu-index >= 0 ? 1 : 0;
        visible: self.opacity > 0.01;
        transform-scale: root.menu-index >= 0 ? 1 : 0.8;
        transform-origin: { x: self.width / 2, y: root.menu-anchor-y > root.menu-y ? self.height : 0px };
        animate opacity { duration: 120ms; }
        animate transform-scale { duration: 420ms; easing: spring(0.35); }
        Rectangle {
            clip: true; border-radius: 24px;
            VerticalLayout {
                padding-top: 8px; padding-bottom: 8px;
                Text {
                    height: 28px;
                    text: "  " + root.menu-app.name; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; font-weight: 600;
                    vertical-alignment: center;
                }
                if !root.menu-dock: MenuRow {
                    icon: Icons.pin; label: Shell.dock-full ? "Dock is full" : "Add to dock"; enabled: !Shell.dock-full;
                    clicked => { Shell.pin(root.menu-app.id); root.close-menu(); }
                }
                if root.menu-dock: MenuRow {
                    icon: Icons.pin; label: "Remove from dock";
                    clicked => { Shell.unpin(root.menu-app.id); root.close-menu(); }
                }
                if !root.menu-dock: MenuRow {
                    icon: Icons.edit; label: "Edit home screen";
                    clicked => { root.close-menu(); Shell.edit-mode = true; }
                }
                MenuRow {
                    icon: Icons.info; label: "App info";
                    clicked => { root.close-menu(); Shell.app-info(root.menu-app.id); }
                }
                if !root.menu-dock && root.menu-app.android: MenuRow {
                    icon: Icons.trash; label: "Uninstall"; danger: true;
                    clicked => { root.close-menu(); Shell.uninstall(root.menu-app.id); }
                }
            }
        }
    }
}

// ---------- Impostazioni rapide stile Android 16/17 ----------
component BigTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> on;
    callback clicked();
    height: 68px;
    border-radius: ta.pressed ? 20px : 34px;
    background: root.on ? Theme.primary : Theme.container-high;
    animate background { duration: 240ms; }
    animate border-radius { duration: 360ms; easing: spring(0.3); }
    Rectangle {
        x: 8px; width: 44px; height: 44px; border-radius: 22px;
        background: root.on ? Theme.on-primary.with-alpha(0.12) : Theme.container-highest;
        Icon { d: root.glyph; tint: root.on ? Theme.on-primary : Theme.on-surface-variant; size: 24px; }
    }
    VerticalLayout {
        x: 60px; width: parent.width - 66px; alignment: center; spacing: 1px;
        Text { text: root.label; color: root.on ? Theme.on-primary : Theme.on-surface; font-family: Theme.body; font-size: 14px; font-weight: 600; overflow: elide; }
        Text { text: root.on ? "On" : "Off"; color: root.on ? Theme.on-primary.with-alpha(0.8) : Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SmallTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> on;
    callback clicked();
    height: 68px;
    border-radius: ta.pressed ? 20px : (root.on ? 24px : 34px);
    background: root.on ? Theme.primary : Theme.container-high;
    animate background { duration: 240ms; }
    animate border-radius { duration: 360ms; easing: spring(0.3); }
    accessible-role: button;
    accessible-label: root.label;
    Icon { d: root.glyph; tint: root.on ? Theme.on-primary : Theme.on-surface-variant; size: 26px; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component ControlsPanel inherits Rectangle {
    background: Theme.surface-dim;
    property <length> pad: 14px;
    property <length> gap: 8px;
    property <length> big-w: (root.width - 2 * root.pad - root.gap) / 2;
    property <length> small-w: (root.width - 2 * root.pad - 3 * root.gap) / 4;
    property <int> nbig: 4;
    out property <length> lift: 0px;
    TouchArea {
        moved => {
            if (Theme.lite) {
                if (self.pressed-y - self.mouse-y > 60px) { Shell.controls-open = false; }
            } else {
                root.lift = max(0px, self.pressed-y - self.mouse-y);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                if (root.lift > 90px) { Shell.controls-open = false; }
                root.lift = 0px;
            }
        }
    }

    StatusBar { y: 0; width: parent.width; show-time: false; }

    Text {
        x: 20px; y: 22px;
        text: Sys.time;
        color: Theme.on-surface; font-family: Theme.display; font-weight: 500; font-size: 32px;
    }
    Text {
        x: 21px; y: 60px;
        text: Sys.date; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px;
    }
    RoundButton {
        x: root.width - 102px; y: 28px; icon: Icons.power; fill: Theme.container-high;
        clicked => { Shell.controls-open = false; Shell.power-menu = true; }
    }
    RoundButton {
        x: root.width - 54px; y: 28px; icon: Icons.gear-f; fill: Theme.container-high;
        clicked => { Shell.controls-open = false; Settings.page = ""; Shell.open-app("settings", root.width - 54px, 30px, 44px); }
    }

    // Riquadri grandi (prime 4) e piccoli
    for t[i] in Sys.toggles: Rectangle {
        property <bool> big: i < root.nbig;
        property <int> j: i - root.nbig;
        x: self.big ? root.pad + mod(i, 2) * (root.big-w + root.gap) : root.pad + mod(self.j, 4) * (root.small-w + root.gap);
        y: self.big ? 90px + floor(i / 2) * (68px + root.gap) : 90px + 2 * (68px + root.gap) + floor(self.j / 4) * (68px + root.gap);
        width: self.big ? root.big-w : root.small-w;
        height: 68px;
        if big: BigTile { width: parent.width; glyph: t.glyph; label: t.label; on: t.on; clicked => { Sys.toggle(t.id); } }
        if !big: SmallTile { width: parent.width; glyph: t.glyph; label: t.label; on: t.on; clicked => { Sys.toggle(t.id); } }
    }

    property <length> sl-y: 90px + (2 + ceil((Sys.toggles.length - root.nbig) / 4)) * (68px + root.gap) + 4px;
    Slider {
        x: root.pad; y: root.sl-y; width: parent.width - 2 * root.pad; track: 52px;
        icon: Icons.brightness; value: Sys.brightness;
        changed(v) => { Sys.brightness = v; Sys.brightness-changed(v); }
    }

    // Notifiche
    Flickable {
        x: 12px; y: root.sl-y + 72px; width: parent.width - 24px; height: parent.height - self.y - 36px;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: parent.width;
            spacing: 2px;
            alignment: start;
            HorizontalLayout {
                height: 40px;
                padding-left: 8px;
                Text { text: Sys.notifications.length == 0 ? "No notifications" : "Notifications"; color: Theme.on-surface; font-family: Theme.body; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                Rectangle { }
                if Sys.notifications.length > 0: PillButton {
                    y: 4px; height: 32px; pad: 14px; label: "Clear all"; active: true;
                    clicked => { Shell.clear-notifications(); }
                }
            }
            for n[i] in Sys.notifications: NotifCard {
                item: n;
                first: i == 0; last: i == Sys.notifications.length - 1;
                open => { Shell.controls-open = false; Shell.open-notification(n.id); }
                dismiss => { Shell.dismiss-notification(n.id); }
            }
            Rectangle { height: 10px; }
            Rectangle {
                height: 64px; border-radius: 24px; background: Theme.container-high;
                Icon { x: 16px; d: Icons.update-f; size: 22px; tint: Sys.update-available ? Theme.primary : Theme.on-surface-variant; }
                VerticalLayout {
                    x: 50px; width: parent.width - 160px;
                    alignment: center; spacing: 1px;
                    Text { text: "Cheip OS " + (Sys.update-available ? Sys.update-version : Sys.version); color: Theme.on-surface; font-family: Theme.body; font-size: 14px; font-weight: 600; }
                    Text { text: Sys.update-state; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 12px; overflow: elide; }
                }
                PillButton {
                    x: parent.width - self.width - 12px; y: 16px; height: 32px; pad: 14px;
                    label: Sys.update-available ? "Install" : "Check";
                    solid: Sys.update-available; active: !Sys.update-available;
                    clicked => { if (Sys.update-available) { Sys.install-update(); } else { Sys.check-update(); } }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 30px; height: 30px;
        Rectangle { width: 40px; height: 4px; border-radius: 2px; background: Theme.on-surface-variant.with-alpha(0.5); }
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up) { Shell.controls-open = false; }
            }
        }
    }
}

// ---------- App recenti: schede orizzontali, su per chiudere ----------
component RecentCard inherits Rectangle {
    in property <RecentItem> item;
    callback open();
    callback close();
    property <length> dy: 0px;
    property <bool> gone: false;
    Rectangle {
        y: root.gone ? -root.height * 1.3 : min(0px, root.dy);
        width: root.width; height: root.height;
        opacity: 1 - min(1, abs(self.y) / (root.height * 0.9));
        animate y { duration: touch.pressed ? 0ms : 420ms; easing: spring(0.25); }
        // intestazione: icona e nome
        HorizontalLayout {
            y: 0; height: 40px; spacing: 10px; alignment: center;
            Rectangle {
                width: 34px; height: 34px; y: 3px; border-radius: 17px; background: Theme.primary-container;
                Icon { d: root.item.glyph; size: 20px; tint: Theme.on-primary-container; }
            }
            Text { text: root.item.name; color: Theme.on-surface; font-family: Theme.body; font-weight: 600; font-size: 16px; vertical-alignment: center; }
            if root.item.android: Badge { y: 13px; }
        }
        // anteprima
        Rectangle {
            y: 50px; height: parent.height - 50px;
            border-radius: 28px;
            background: touch.pressed && abs(root.dy) < 6px ? Theme.container-highest : Theme.container-high;
            Rectangle {
                width: 112px; height: 112px; border-radius: 56px; background: Theme.secondary-container;
                Icon { d: root.item.glyph; size: 56px; tint: Theme.on-secondary-container; }
            }
            Text {
                y: parent.height - 48px; width: parent.width;
                text: root.item.mem > 0 ? root.item.mem + " MB · " + root.item.state : root.item.state;
                color: Theme.on-surface-variant; font-family: Theme.body; font-size: 13px; horizontal-alignment: center;
            }
        }
        touch := TouchArea {
            moved => { root.dy = self.mouse-y - self.pressed-y; }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up) {
                    if (root.dy < -120px) { root.gone = true; root.close(); }
                    else if (abs(root.dy) < 6px) { root.open(); }
                    root.dy = root.gone ? root.dy : 0px;
                }
            }
        }
    }
}

export component SwitcherScreen inherits Rectangle {
    property <length> card-w: root.width * 0.72;
    property <length> card-h: root.height * 0.66;
    property <length> step: root.card-w + 16px;
    Wallpaper { dim: 0.55; }
    StatusBar { y: 0; width: parent.width; fg: #ffffff; }
    Flickable {
        y: 70px; width: parent.width; height: root.card-h + 20px;
        content-width: max(self.width, Shell.recents.length * root.step + (root.width - root.card-w) - 16px);
        for r[i] in Shell.recents: RecentCard {
            x: (root.width - root.card-w) / 2 + i * root.step;
            width: root.card-w; height: root.card-h;
            item: r;
            animate x { duration: 420ms; easing: spring(0.3); }
            open => { Shell.screen = ScreenId.home; Shell.open-app(r.id, (root.width - 56px) / 2, root.height / 2, 56px); }
            close => { Shell.close-recent(r.id); }
        }
    }
    if Shell.recents.length == 0: Text {
        y: root.height * 0.42; width: root.width;
        text: "No recent apps"; color: #ffffffcc; font-family: Theme.body; font-size: 16px; horizontal-alignment: center;
    }
    if Shell.recents.length > 0: PillButton {
        x: (root.width - self.width) / 2; y: root.height - 96px; height: 48px;
        label: "Clear all"; icon: Icons.close; active: true;
        clicked => { Shell.close-all(); }
    }
}
