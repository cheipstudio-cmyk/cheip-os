import { Theme } from "theme.slint";
import { Sys, Settings, Phone } from "data.slint";
import { Icon, Icons, StatusBar, RoundButton, PillButton, Card, Title, ListRow, Field } from "components.slint";

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 48px; height: 28px; border-radius: 14px;
    background: root.on ? Theme.accent : Theme.raised;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: root.on ? 22px : 2px; y: 2px; width: 24px; height: 24px; border-radius: 12px;
        background: root.on ? #000 : Theme.muted;
        animate x { duration: Theme.fast; easing: Theme.ease; }
    }
    TouchArea { clicked => { root.toggled(); } }
}

component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();
    height: 56px;
    Text { x: 0; height: parent.height; text: root.label; color: Theme.text; font-family: Theme.body; font-size: 15px; vertical-alignment: center; }
    Switch { x: parent.width - 48px; on: root.on; toggled => { root.toggled(); } }
}

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 44px;
    Text { x: 0; height: parent.height; text: root.label; color: Theme.muted; font-family: Theme.body; font-size: 14px; vertical-alignment: center; }
    Text { x: parent.width - self.width; height: parent.height; text: root.value; color: Theme.text; font-family: Theme.body; font-size: 14px; vertical-alignment: center; }
}

component Slider inherits Rectangle {
    in property <string> glyph;
    in-out property <float> value;
    callback changed(float);
    height: 40px; border-radius: 20px; background: Theme.raised; clip: true;
    Rectangle { x: 0; width: max(40px, parent.width * root.value); border-radius: 20px; background: Theme.text; }
    Icon { x: 12px; d: root.glyph; size: 18px; tint: #000; }
    TouchArea {
        moved => { root.value = max(0.02, min(1.0, self.mouse-x / self.width)); root.changed(root.value); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { root.value = max(0.02, min(1.0, self.mouse-x / self.width)); root.changed(root.value); }
        }
    }
}

component Page inherits Rectangle {
    in property <string> title;
    background: Theme.bg;
    StatusBar { y: 0; width: parent.width; }
    RoundButton { x: 8px; y: 30px; icon: Icons.back; outlined: false; clicked => { Settings.page = ""; } }
    Text {
        x: 56px; y: 30px; height: 44px;
        text: root.title; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 24px;
        vertical-alignment: center;
    }
    Flickable {
        x: 16px; y: 88px; width: parent.width - 32px; height: parent.height - 88px - 28px;
        content-height: body.preferred-height + 16px;
        body := VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: 4px;
            @children
        }
    }
}

export component SettingsApp inherits Rectangle {
    background: Theme.bg;
    property <string> pw-ssid;
    property <string> pw;

    if Settings.page == "": Rectangle {
        StatusBar { y: 0; width: parent.width; }
        Title { x: 16px; y: 34px; text: "Impostazioni"; }
        Flickable {
            x: 16px; y: 88px; width: parent.width - 32px; height: parent.height - 88px - 28px;
            content-height: list.preferred-height + 16px;
            list := VerticalLayout {
                width: parent.width; alignment: start;
                ListRow { icon: Icons.wifi; label: "Wi-Fi"; detail: Sys.wifi-on ? "Acceso" : "Spento"; clicked => { Settings.open-page("wifi"); } }
                ListRow { icon: Icons.bluetooth; label: "Bluetooth"; detail: Sys.bt-on ? "Acceso" : "Spento"; clicked => { Settings.open-page("bt"); } }
                ListRow { icon: Icons.data; label: "Rete mobile"; detail: Phone.modem-ok ? Settings.modem-operator : "Modem non disponibile"; clicked => { Settings.open-page("mobile"); } }
                ListRow { icon: Icons.sun; label: "Display"; detail: "Luminosità, colore accento"; clicked => { Settings.open-page("display"); } }
                ListRow { icon: Icons.speaker; label: "Suoni"; detail: round(Sys.volume * 100) + "%"; clicked => { Settings.open-page("sound"); } }
                ListRow { icon: Icons.battery; label: "Batteria"; detail: Sys.battery + "%" + (Sys.charging ? " in carica" : ""); clicked => { Settings.open-page("battery"); } }
                ListRow { icon: Icons.disk; label: "Archiviazione e memoria"; detail: Settings.storage-used + " di " + Settings.storage-total; clicked => { Settings.open-page("storage"); } }
                ListRow { icon: Icons.android; label: "App Android"; detail: Sys.android-running ? "Attive" : "Sospese"; clicked => { Settings.open-page("android"); } }
                ListRow { icon: Icons.clock; label: "Data e ora"; detail: Settings.timezone; clicked => { Settings.open-page("time"); } }
                ListRow { icon: Icons.update; label: "Aggiornamenti"; detail: Sys.update-available ? "Disponibile la " + Sys.update-version : "Versione " + Sys.version; clicked => { Settings.open-page("update"); } }
                ListRow { icon: Icons.info; label: "Info telefono"; detail: Sys.model; clicked => { Settings.open-page("about"); } }
            }
        }
    }

    if Settings.page == "wifi": Page {
        title: "Wi-Fi";
        SwitchRow { label: "Wi-Fi"; on: Sys.wifi-on; toggled => { Sys.toggle("wifi"); } }
        HorizontalLayout {
            height: 44px; spacing: 8px;
            Text { text: Settings.wifi-busy ? "Ricerca reti…" : Settings.wifi-msg; color: Theme.muted; font-family: Theme.body; font-size: 13px; vertical-alignment: center; }
            RoundButton { icon: Icons.refresh; outlined: false; clicked => { Settings.wifi-scan(); } }
        }
        for n in Settings.networks: Rectangle {
            height: root.pw-ssid == n.ssid ? 160px : 56px;
            animate height { duration: Theme.fast; easing: Theme.ease; }
            Rectangle {
                y: 6px; width: 36px; height: 36px; x: 0; border-radius: 18px;
                background: n.active ? Theme.accent : Theme.raised;
                Icon { d: Icons.wifi; size: 18px; tint: n.active ? #000 : (n.signal > 50 ? Theme.text : Theme.muted); }
            }
            Text { x: 50px; y: 6px; height: 36px; text: n.ssid; color: Theme.text; font-family: Theme.body; font-size: 15px; vertical-alignment: center; }
            if n.secure: Icon { x: parent.width - 20px; y: 15px; d: Icons.lock; size: 16px; tint: Theme.faint; }
            TouchArea {
                height: 48px; y: 0;
                clicked => {
                    if (n.active) { return; }
                    if (n.secure) { root.pw-ssid = root.pw-ssid == n.ssid ? "" : n.ssid; root.pw = ""; }
                    else { Settings.wifi-connect(n.ssid, ""); }
                }
            }
            if root.pw-ssid == n.ssid: VerticalLayout {
                y: 56px; height: 96px; spacing: 8px;
                Field { placeholder: "Password"; kind: InputType.password; text <=> root.pw; }
                HorizontalLayout {
                    alignment: end;
                    PillButton { label: "Connetti"; solid: true; clicked => { Settings.wifi-connect(n.ssid, root.pw); root.pw-ssid = ""; } }
                }
            }
        }
    }

    if Settings.page == "bt": Page {
        title: "Bluetooth";
        SwitchRow { label: "Bluetooth"; on: Sys.bt-on; toggled => { Sys.toggle("bt"); } }
        Text { text: "Dispositivi associati"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 32px; vertical-alignment: bottom; }
        for d in Settings.bt-devices: ListRow { icon: Icons.bluetooth; label: d; chevron: false; }
        if Settings.bt-devices.length == 0: Text { text: "Nessuno"; color: Theme.faint; font-family: Theme.body; font-size: 14px; height: 40px; vertical-alignment: center; }
    }

    if Settings.page == "mobile": Page {
        title: "Rete mobile";
        SwitchRow { label: "Dati mobili"; on: Sys.data-on; toggled => { Sys.toggle("dati"); } }
        InfoRow { label: "Operatore"; value: Phone.modem-ok ? Settings.modem-operator : "Nessuno"; }
        InfoRow { label: "Segnale"; value: Settings.modem-signal; }
        InfoRow { label: "Stato"; value: Phone.modem-ok ? Settings.modem-state : Phone.modem-label; }
    }

    if Settings.page == "display": Page {
        title: "Display";
        Text { text: "Luminosità"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 28px; vertical-alignment: bottom; }
        Slider { glyph: Icons.sun; value: Sys.brightness; changed(v) => { Sys.brightness = v; Sys.brightness-changed(v); } }
        Text { text: "Colore accento"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 40px; vertical-alignment: bottom; }
        HorizontalLayout {
            spacing: 12px; alignment: start; height: 56px; padding-top: 8px;
            for c in [#c6ff3d, #ff7a1a, #3da9ff, #ff4fa3, #b18cff]: Rectangle {
                width: 44px; height: 44px; border-radius: 22px;
                background: c;
                border-width: Theme.accent == c ? 3px : 0px;
                border-color: Theme.text;
                TouchArea { clicked => { Theme.accent = c; } }
            }
        }
        InfoRow { label: "Tema"; value: "Nero AMOLED"; }
    }

    if Settings.page == "sound": Page {
        title: "Suoni";
        Text { text: "Volume"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 28px; vertical-alignment: bottom; }
        Slider { glyph: Icons.speaker; value: Sys.volume; changed(v) => { Sys.volume = v; Sys.volume-changed(v); } }
    }

    if Settings.page == "battery": Page {
        title: "Batteria";
        Text { text: Sys.battery + "%"; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 56px; height: 72px; }
        Rectangle {
            height: 12px; border-radius: 6px; background: Theme.raised; clip: true;
            Rectangle { x: 0; width: parent.width * Sys.battery / 100; background: Sys.battery <= 15 ? #ff6b6b : Theme.accent; }
        }
        InfoRow { label: "Stato"; value: Sys.charging ? "In carica" : "In uso"; }
        SwitchRow { label: "Risparmio energetico"; on: Sys.eco-on; toggled => { Sys.toggle("eco"); } }
    }

    if Settings.page == "storage": Page {
        title: "Archiviazione";
        Text { text: Settings.storage-used + " di " + Settings.storage-total; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 26px; height: 44px; }
        Rectangle {
            height: 12px; border-radius: 6px; background: Theme.raised; clip: true;
            Rectangle { x: 0; width: parent.width * Settings.storage-ratio; background: Theme.text; }
        }
        Rectangle { height: 16px; }
        InfoRow { label: "Memoria RAM"; value: Sys.mem-used + " / " + Sys.mem-total + " MB"; }
        InfoRow { label: "Di cui app Android"; value: Sys.mem-android + " MB"; }
    }

    if Settings.page == "android": Page {
        title: "App Android";
        InfoRow { label: "Livello Android"; value: Sys.android-running ? "Attivo" : "Sospeso"; }
        Text { text: Sys.android-state; color: Theme.muted; font-family: Theme.body; font-size: 13px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start; padding-top: 12px; height: 46px;
            PillButton { label: Sys.android-running ? "Sospendi" : "Avvia"; solid: true; clicked => { Sys.android-toggle(); } }
        }
    }

    if Settings.page == "time": Page {
        title: "Data e ora";
        InfoRow { label: "Ora"; value: Sys.time; }
        InfoRow { label: "Data"; value: Sys.date; }
        InfoRow { label: "Fuso orario"; value: Settings.timezone; }
        Text { text: "Ora e data arrivano dalla rete in automatico."; color: Theme.faint; font-family: Theme.body; font-size: 12px; wrap: word-wrap; height: 40px; vertical-alignment: bottom; }
    }

    if Settings.page == "update": Page {
        title: "Aggiornamenti";
        Text { text: Sys.update-available ? "Cheip OS " + Sys.update-version : "Cheip OS " + Sys.version; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 26px; height: 44px; }
        Text { text: Sys.update-state; color: Theme.muted; font-family: Theme.body; font-size: 13px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start; padding-top: 16px; height: 50px;
            PillButton {
                label: Sys.update-available ? "Installa" : "Controlla";
                solid: true;
                clicked => { if (Sys.update-available) { Sys.install-update(); } else { Sys.check-update(); } }
            }
        }
    }

    if Settings.page == "about": Page {
        title: "Info telefono";
        InfoRow { label: "Modello"; value: Sys.model; }
        InfoRow { label: "Cheip OS"; value: Sys.version; }
        InfoRow { label: "Kernel"; value: Sys.kernel; }
        InfoRow { label: "Memoria"; value: Sys.mem-total + " MB"; }
    }
}
