import { Theme } from "theme.slint";
import { Sys, Settings, Phone, Shell, Style, SRow, Swatch } from "data.slint";
import { Icon, Icons, Shapes, StatusBar, RoundButton, PillButton, Card, Title, ListRow, Field, Switch, Slider, Segmented, AppIcon } from "components.slint";

// Gruppo espressivo: elementi staccati, angoli grandi in cima e in fondo
component GroupItem inherits Rectangle {
    in property <bool> first;
    in property <bool> last;
    in property <bool> pressed;
    border-top-left-radius: root.first ? 28px : 6px;
    border-top-right-radius: root.first ? 28px : 6px;
    border-bottom-left-radius: root.last ? 28px : 6px;
    border-bottom-right-radius: root.last ? 28px : 6px;
    background: root.pressed ? Theme.container-highest : Theme.container-high;
    animate background { duration: Theme.fast; }
}

// Voce del menu principale con icona colorata
component MainRow inherits GroupItem {
    in property <string> icon;
    in property <string> label;
    in property <string> detail;
    in property <int> hue;
    callback clicked();
    height: 76px;
    pressed: ta.pressed;
    Rectangle {
        x: 16px; width: 40px; height: 40px; border-radius: 20px;
        background: mod(root.hue, 3) == 0 ? Theme.primary-container : mod(root.hue, 3) == 1 ? Theme.tertiary-container : Theme.secondary-container;
        Icon { d: root.icon; size: 22px; tint: mod(root.hue, 3) == 0 ? Theme.on-primary-container : mod(root.hue, 3) == 1 ? Theme.on-tertiary-container : Theme.on-secondary-container; }
    }
    VerticalLayout {
        x: 72px; width: parent.width - 88px; alignment: center; spacing: 2px;
        Text { text: root.label; color: Theme.on-surface; font-family: Theme.body; font-size: 17px; font-weight: 500; overflow: elide; }
        if root.detail != "": Text { text: root.detail; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Header inherits Text {
    height: 44px;
    color: Theme.primary; font-family: Theme.body; font-size: 14px; font-weight: 600;
    vertical-alignment: bottom;
}

// Riga generica guidata dai dati
component GenRow inherits GroupItem {
    in property <SRow> item;
    callback picked();
    property <bool> has-sub: root.item.subtitle != "";
    height: root.item.kind == 4 ? 96px : (root.has-sub ? 76px : 60px);
    pressed: ta.pressed && root.item.kind != 4;
    opacity: root.item.kind == 8 ? 1 : 1;
    if root.item.glyph != "": Icon { x: 18px; d: root.item.glyph; size: 24px; tint: root.item.kind == 7 ? Theme.error : Theme.on-surface-variant; y: root.item.kind == 4 ? 16px : (parent.height - 24px) / 2; }
    property <length> tx: root.item.glyph != "" ? 58px : 20px;
    VerticalLayout {
        x: root.tx; y: root.item.kind == 4 ? 12px : 0px; height: root.item.kind == 4 ? 32px : parent.height;
        width: parent.width - root.tx - (root.item.kind == 2 || root.item.kind == 5 ? 76px : 16px);
        alignment: center; spacing: 2px;
        Text { text: root.item.title; color: root.item.kind == 7 ? Theme.error : Theme.on-surface; font-family: Theme.body; font-size: 17px; overflow: elide; wrap: root.item.kind == 8 ? word-wrap : no-wrap; }
        if root.has-sub && root.item.kind != 4: Text { text: root.item.subtitle; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
    }
    if root.item.kind == 2: Switch {
        x: parent.width - 68px; on: root.item.on;
        toggled(v) => { Settings.row-toggled(root.item.key, v); }
    }
    if root.item.kind == 5: Rectangle {
        x: parent.width - 48px; width: 24px; height: 24px; border-radius: 12px;
        border-width: 2px; border-color: root.item.on ? Theme.primary : Theme.on-surface-variant;
        Rectangle { width: root.item.on ? 12px : 0px; height: self.width; border-radius: self.width / 2; background: Theme.primary; animate width { duration: 260ms; easing: spring(0.35); } }
    }
    if root.item.kind == 4: Slider {
        x: 16px; y: 46px; width: parent.width - 32px;
        value: root.item.value;
        changed(v) => { Settings.row-slid(root.item.key, v); }
    }
    ta := TouchArea {
        enabled: root.item.kind != 4 && root.item.kind != 8;
        clicked => { root.picked(); }
    }
}

component Page inherits Rectangle {
    in property <string> title;
    background: Theme.surface;
    StatusBar { y: 0; width: parent.width; }
    RoundButton { x: 8px; y: 30px; icon: Icons.back; tint: Theme.on-surface; clicked => { Settings.back(); } }
    Text {
        x: 20px; y: 80px;
        text: root.title; color: Theme.on-surface; font-family: Theme.display; font-weight: 500; font-size: 34px;
        width: parent.width - 40px; overflow: elide;
    }
    Flickable {
        x: 12px; y: 132px; width: parent.width - 24px; height: parent.height - 132px - 20px;
        content-height: body.preferred-height + 24px;
        body := VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: 2px;
            @children
        }
    }
}

component RadioRow inherits GroupItem {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    height: 60px;
    pressed: ta.pressed;
    Text { x: 20px; height: parent.height; text: root.label; color: Theme.on-surface; font-family: Theme.body; font-size: 17px; vertical-alignment: center; }
    Rectangle {
        x: parent.width - 48px; width: 24px; height: 24px; border-radius: 12px;
        border-width: 2px; border-color: root.on ? Theme.primary : Theme.on-surface-variant;
        Rectangle { width: root.on ? 12px : 0px; height: self.width; border-radius: self.width / 2; background: Theme.primary; animate width { duration: 260ms; easing: spring(0.35); } }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SwitchItem inherits GroupItem {
    in property <string> label;
    in property <string> detail;
    in property <bool> on;
    callback toggled(bool);
    height: root.detail != "" ? 76px : 60px;
    VerticalLayout {
        x: 20px; width: parent.width - 100px; alignment: center; spacing: 2px;
        Text { text: root.label; color: Theme.on-surface; font-family: Theme.body; font-size: 17px; }
        if root.detail != "": Text { text: root.detail; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
    }
    Switch { x: parent.width - 68px; on: root.on; toggled(v) => { root.toggled(v); } }
}

component InfoItem inherits GroupItem {
    in property <string> label;
    in property <string> value;
    height: 76px;
    VerticalLayout {
        x: 20px; width: parent.width - 40px; alignment: center; spacing: 2px;
        Text { text: root.label; color: Theme.on-surface; font-family: Theme.body; font-size: 17px; }
        Text { text: root.value; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; overflow: elide; }
    }
}

export component SettingsApp inherits Rectangle {
    background: Theme.surface;
    property <string> pw-ssid;
    property <string> pw;
    property <bool> main: Settings.page == "";

    // Elenco principale: arretra quando entra una sottopagina
    Rectangle {
        x: root.main ? 0px : -root.width * 0.2;
        opacity: root.main ? 1 : 0;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        animate opacity { duration: 220ms; }
        StatusBar { y: 0; width: parent.width; }
        Flickable {
            y: 28px; height: parent.height - 28px;
            content-height: list.preferred-height + 24px;
            list := VerticalLayout {
                padding-left: 12px; padding-right: 12px; alignment: start; spacing: 2px;
                Text { height: 96px; text: "Settings"; color: Theme.on-surface; font-family: Theme.display; font-weight: 500; font-size: 40px; vertical-alignment: center; horizontal-alignment: center; }
                Rectangle {
                    height: 56px; border-radius: 28px; background: Theme.container-high;
                    Icon { x: 18px; d: Icons.search; size: 24px; tint: Theme.on-surface-variant; }
                    Text { x: 56px; height: parent.height; text: "Search settings"; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 16px; vertical-alignment: center; }
                }
                Rectangle { height: 14px; }
                MainRow { first: true; icon: Icons.wifi-f; hue: 0; label: "Network & internet"; detail: !Sys.has-wifi ? "No Wi-Fi hardware found" : (Sys.wifi-on ? "Wi-Fi, mobile data" : "Wi-Fi off"); clicked => { Settings.open-page("network"); } }
                MainRow { last: true; icon: Icons.devices; hue: 0; label: "Connected devices"; detail: "Bluetooth"; clicked => { Settings.open-page("devices"); } }
                Rectangle { height: 14px; }
                MainRow { first: true; icon: Icons.apps; hue: 1; label: "Apps"; detail: "Recent apps, default apps"; clicked => { Settings.open-page("apps"); } }
                MainRow { icon: Icons.bell-f; hue: 1; label: "Notifications"; detail: "Do Not Disturb"; clicked => { Settings.open-page("notifications"); } }
                MainRow { icon: Icons.battery-f; hue: 1; label: "Battery"; detail: !Sys.has-battery ? "Level not available" : Sys.battery + "%" + (Sys.charging ? " · Charging" : ""); clicked => { Settings.open-page("battery"); } }
                MainRow { last: true; icon: Icons.storage; hue: 1; label: "Storage"; detail: Settings.storage-used + " used of " + Settings.storage-total; clicked => { Settings.open-page("storage"); } }
                Rectangle { height: 14px; }
                MainRow { first: true; icon: Sys.ringer == 0 ? Icons.speaker-f : (Sys.ringer == 1 ? Icons.vibrate-f : Icons.bell-off-f); hue: 2; label: "Sound & vibration"; detail: (Sys.ringer == 0 ? "Ring" : (Sys.ringer == 1 ? "Vibrate" : "Silent")) + " · Volume " + round(Sys.volume * 100) + "%"; clicked => { Settings.open-page("sound"); } }
                MainRow { icon: Icons.brightness; hue: 2; label: "Display & touch"; detail: "Brightness, display size, screen timeout"; clicked => { Settings.open-page("display"); } }
                MainRow { icon: Icons.palette-f; hue: 2; label: "Wallpaper & style"; detail: "Colors, themed icons, app grid"; clicked => { Settings.open-page("style"); } }
                MainRow { last: true; icon: Icons.a11y; hue: 2; label: "Accessibility"; detail: "Remove animations"; clicked => { Settings.open-page("a11y"); } }
                Rectangle { height: 14px; }
                MainRow { first: true; icon: Icons.android-f; hue: 1; label: "Android apps"; detail: Sys.android-running ? "Running" : "Suspended"; clicked => { Settings.open-page("android"); } }
                MainRow { icon: Icons.phone-device; hue: 1; label: "System"; detail: "Languages, time, reset"; clicked => { Settings.open-page("system"); } }
                MainRow { icon: Icons.update-f; hue: 1; label: "System update"; detail: Sys.update-available ? "Update available: " + Sys.update-version : "Cheip OS " + Sys.version; clicked => { Settings.open-page("update"); } }
                MainRow { last: true; icon: Icons.info-f; hue: 1; label: "About phone"; detail: Sys.model; clicked => { Settings.open-page("about"); } }
                if Sys.demo: Header { text: "   Try it (demo only)"; }
                if Sys.demo: MainRow { first: true; icon: Icons.phone-f; hue: 2; label: "Simulate incoming call"; detail: "Rings in 2 seconds"; clicked => { Shell.demo-call(); } }
                if Sys.demo: MainRow { icon: Icons.message-f; hue: 2; label: "Simulate new message"; detail: "Arrives in 2 seconds"; clicked => { Shell.demo-message(); } }
                if Sys.demo: MainRow { last: true; icon: Icons.speaker-f; hue: 2; label: "Show volume panel"; detail: "Like pressing a volume key"; clicked => { Shell.volume-step(1); } }
            }
        }
    }

    // Pagina generica: elenco calcolato da Rust
    Page {
        x: Settings.page == "gen" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: Settings.title;
        for r[i] in Settings.rows: Rectangle {
            height: r.kind == 0 ? 48px : g.height;
            property <bool> first: i == 0 || Settings.rows[i - 1].kind == 0;
            property <bool> last: i == Settings.rows.length - 1 || Settings.rows[i + 1].kind == 0;
            if r.kind == 0: Header { x: 20px; width: parent.width - 20px; height: 48px; text: r.title; }
            g := GenRow {
                visible: r.kind != 0;
                item: r; first: parent.first; last: parent.last;
                picked => { Settings.row-clicked(r.key); }
            }
        }
    }

    Page {
        x: Settings.page == "wifi" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "Internet";
        Rectangle {
            height: 72px; border-radius: 36px; background: Sys.wifi-on ? Theme.primary-container : Theme.container-high;
            animate background { duration: 240ms; }
            Text { x: 24px; height: parent.height; text: "Use Wi-Fi"; color: Sys.wifi-on ? Theme.on-primary-container : Theme.on-surface; font-family: Theme.body; font-size: 19px; font-weight: 500; vertical-alignment: center; }
            Switch { x: parent.width - 76px; on: Sys.wifi-on; toggled => { Sys.toggle("wifi"); } }
        }
        HorizontalLayout {
            height: 48px; spacing: 8px; padding-left: 8px;
            Text { text: Settings.wifi-busy ? "Scanning…" : (Settings.wifi-msg != "" ? Settings.wifi-msg : "Available networks"); color: Theme.primary; font-family: Theme.body; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            RoundButton { icon: Icons.refresh; clicked => { Settings.wifi-scan(); } }
        }
        for n[i] in Settings.networks: GroupItem {
            first: i == 0; last: i == Settings.networks.length - 1;
            height: root.pw-ssid == n.ssid ? 184px : 68px;
            animate height { duration: 420ms; easing: spring(0.3); }
            clip: true;
            Rectangle {
                x: 14px; y: 12px; width: 44px; height: 44px; border-radius: 22px;
                background: n.active ? Theme.primary : Theme.secondary-container;
                Icon { d: Icons.wifi-f; size: 22px; tint: n.active ? Theme.on-primary : Theme.on-secondary-container; opacity: n.signal > 50 ? 1 : 0.6; }
            }
            VerticalLayout {
                x: 72px; y: 0; height: 68px; alignment: center; spacing: 2px;
                Text { text: n.ssid; color: Theme.on-surface; font-family: Theme.body; font-size: 17px; }
                if n.active: Text { text: "Connected"; color: Theme.primary; font-family: Theme.body; font-size: 14px; }
            }
            if n.secure: Icon { x: parent.width - 40px; y: 24px; d: Icons.lock-f; size: 20px; tint: Theme.on-surface-variant; }
            TouchArea {
                height: 68px; y: 0;
                clicked => {
                    if (n.active) { return; }
                    if (n.secure) { root.pw-ssid = root.pw-ssid == n.ssid ? "" : n.ssid; root.pw = ""; }
                    else { Settings.wifi-connect(n.ssid, ""); }
                }
            }
            if root.pw-ssid == n.ssid: VerticalLayout {
                x: 14px; y: 72px; width: parent.width - 28px; height: 104px; spacing: 10px;
                Field { placeholder: "Password"; kind: InputType.password; text <=> root.pw; }
                HorizontalLayout {
                    alignment: end;
                    PillButton { label: "Connect"; solid: true; clicked => { Settings.wifi-connect(n.ssid, root.pw); root.pw-ssid = ""; } }
                }
            }
        }
    }

    Page {
        x: Settings.page == "sound" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "Sound & vibration";
        Segmented { items: ["Ring", "Vibrate", "Silent"]; selected: Sys.ringer; height: 52px; picked(i) => { Sys.set-ringer(i); } }
        Header { text: "   Volume"; }
        GroupItem {
            first: true; last: true; height: 76px;
            Slider { x: 16px; width: parent.width - 32px; icon: Icons.speaker-f; value: Sys.volume; changed(v) => { Sys.volume = v; Sys.volume-changed(v); } }
        }
        Header { text: "   Phone ringtone"; }
        for r[i] in ["Lakeside", "Overtake", "Lumen"]: RadioRow {
            first: i == 0; last: i == 2;
            label: r; on: Sys.ringtone == i;
            clicked => { Sys.set-ringtone(i); }
        }
        Header { text: "   Notification sound"; }
        for r[i] in ["Pop", "Chime", "Drop"]: RadioRow {
            first: i == 0; last: i == 2;
            label: r; on: Sys.notif-tone == i;
            clicked => { Sys.pref("notif_tone", i); Sys.preview-tone(i); }
        }
        Rectangle { height: 14px; }
        SwitchItem { first: true; label: "Vibrate when ringing"; detail: "Also vibrate for calls"; on: Sys.vibrate-on-ring; toggled(v) => { Sys.vibrate-on-ring = v; } }
        SwitchItem { label: "Charging sound"; detail: "When you plug in the charger"; on: Sys.snd-charge; toggled(v) => { Sys.pref("snd_charge", v ? 1 : 0); } }
        SwitchItem { label: "Low battery alert"; detail: "Sound and notification at 15%"; on: Sys.snd-lowbat; toggled(v) => { Sys.pref("snd_lowbat", v ? 1 : 0); } }
        SwitchItem { label: "Screen lock sound"; detail: "Power key on and off"; on: Sys.snd-lock; toggled(v) => { Sys.pref("snd_lock", v ? 1 : 0); } }
        SwitchItem { last: true; label: "Keyboard vibration"; detail: "A light tick on every key"; on: Sys.kbd-vibrate; toggled(v) => { Sys.pref("kbd_vibrate", v ? 1 : 0); } }
    }

    Page {
        x: Settings.page == "display" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "Display & touch";
        Header { text: "   Brightness"; }
        GroupItem {
            first: true; last: true; height: 84px;
            Slider { x: 16px; width: parent.width - 32px; track: 52px; icon: Icons.brightness; value: Sys.brightness; changed(v) => { Sys.brightness = v; Sys.brightness-changed(v); } }
        }
        Header { text: "   Display size"; }
        Segmented { items: ["Small", "Default", "Large"]; selected: Sys.display-size; height: 52px; picked(i) => { Sys.set-display-size(i); } }
        Header { text: "   System navigation"; }
        RadioRow { first: true; label: "3-button navigation"; on: Sys.nav-buttons; clicked => { Sys.pref("nav_buttons", 1); } }
        RadioRow { last: true; label: "Gesture navigation"; on: !Sys.nav-buttons; clicked => { Sys.pref("nav_buttons", 0); } }
        Header { text: "   Screen timeout"; }
        for r[i] in ["15 seconds", "30 seconds", "1 minute", "2 minutes", "5 minutes", "Never"]: RadioRow {
            first: i == 0; last: i == 5;
            label: r; on: Sys.screen-timeout == i;
            clicked => { Sys.set-screen-timeout(i); }
        }
    }

    Page {
        x: Settings.page == "battery" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "Battery";
        GroupItem {
            first: true; last: true; height: 170px;
            Text { x: 24px; y: 18px; text: Sys.battery + "%"; color: Theme.on-surface; font-family: Theme.display; font-weight: 500; font-size: 64px; }
            Text { x: 26px; y: 96px; text: Sys.charging ? "Charging" : (Sys.eco-on ? "Battery Saver is on" : "Discharging"); color: Theme.on-surface-variant; font-family: Theme.body; font-size: 15px; }
            Rectangle {
                x: 24px; y: 134px; width: parent.width - 48px; height: 14px; border-radius: 7px; background: Theme.secondary-container; clip: true;
                Rectangle { x: 0; width: parent.width * Sys.battery / 100; border-radius: 7px; background: Sys.battery <= 20 ? Theme.error : Theme.primary; animate width { duration: 600ms; easing: Theme.ease; } }
            }
        }
        Rectangle { height: 14px; }
        SwitchItem { first: true; last: true; label: "Battery Saver"; detail: "Limits background work"; on: Sys.eco-on; toggled => { Sys.toggle("eco"); } }

    }

    Page {
        x: Settings.page == "storage" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "Storage";
        GroupItem {
            first: true; last: true; height: 140px;
            Text { x: 24px; y: 18px; text: Settings.storage-used; color: Theme.on-surface; font-family: Theme.display; font-weight: 500; font-size: 44px; }
            Text { x: 26px; y: 74px; text: "used of " + Settings.storage-total; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 15px; }
            Rectangle {
                x: 24px; y: 106px; width: parent.width - 48px; height: 14px; border-radius: 7px; background: Theme.secondary-container; clip: true;
                Rectangle { x: 0; width: parent.width * Settings.storage-ratio; border-radius: 7px; background: Theme.primary; }
            }
        }
        Rectangle { height: 14px; }
        InfoItem { first: true; label: "Memory (RAM)"; value: Sys.mem-used + " of " + Sys.mem-total + " MB in use"; }
        InfoItem { last: true; label: "Android apps"; value: Sys.mem-android + " MB"; }
    }

    Page {
        x: Settings.page == "android" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "Android apps";
        GroupItem {
            first: true; last: true; height: 160px;
            Rectangle {
                x: 20px; y: 20px; width: 56px; height: 56px; border-radius: 28px; background: Theme.tertiary-container;
                Icon { d: Icons.android-f; size: 30px; tint: Theme.on-tertiary-container; }
            }
            Text { x: 92px; y: 24px; text: Sys.android-running ? "Running" : "Suspended"; color: Theme.on-surface; font-family: Theme.display; font-size: 24px; font-weight: 500; }
            Text { x: 92px; y: 56px; width: parent.width - 110px; text: Sys.android-state; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; wrap: word-wrap; }
            PillButton { x: 20px; y: 104px; label: Sys.android-running ? "Suspend" : "Start"; solid: true; clicked => { Sys.android-toggle(); } }
        }
    }

    Page {
        x: Settings.page == "update" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "System update";
        GroupItem {
            first: true; last: true; height: 190px;
            Path {
                x: 20px; y: 20px; width: 64px; height: 64px;
                commands: Shapes.cookie; viewbox-width: 100; viewbox-height: 100;
                fill: Sys.update-available ? Theme.primary : Theme.secondary-container;
            }
            Icon { x: 36px; y: 36px; d: Icons.update-f; size: 32px; tint: Sys.update-available ? Theme.on-primary : Theme.on-secondary-container; }
            Text { x: 100px; y: 26px; text: "Cheip OS " + (Sys.update-available ? Sys.update-version : Sys.version); color: Theme.on-surface; font-family: Theme.display; font-size: 24px; font-weight: 500; }
            Text { x: 100px; y: 58px; width: parent.width - 120px; text: Sys.update-state; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; wrap: word-wrap; }
            PillButton {
                x: parent.width - self.width - 20px; y: 126px;
                label: Sys.update-available ? "Download and install" : "Check for update";
                solid: true;
                clicked => { if (Sys.update-available) { Sys.install-update(); } else { Sys.check-update(); } }
            }
        }
    }

    Page {
        x: Settings.page == "appinfo" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "App info";
        Rectangle {
            height: 170px;
            Path {
                x: (parent.width - 88px) / 2; y: 8px; width: 88px; height: 88px;
                commands: Shapes.cookie; viewbox-width: 100; viewbox-height: 100;
                fill: Theme.primary-container;
            }
            if Settings.info-glyph != "": Icon { x: (parent.width - 44px) / 2; y: 30px; d: Settings.info-glyph; size: 44px; tint: Theme.on-primary-container; }
            Text { y: 108px; width: parent.width; text: Settings.info-name; color: Theme.on-surface; font-family: Theme.display; font-weight: 500; font-size: 26px; horizontal-alignment: center; }
            Text { y: 142px; width: parent.width; text: Settings.info-kind; color: Theme.on-surface-variant; font-family: Theme.body; font-size: 14px; horizontal-alignment: center; }
        }
        HorizontalLayout {
            alignment: center; spacing: 10px; height: 64px; padding-bottom: 14px;
            PillButton { label: "Open"; icon: Icons.play-f; solid: true; clicked => { Shell.open-app(Settings.info-id, root.width / 2 - 28px, 300px, 56px); } }
            if Settings.info-android: PillButton { label: "Uninstall"; icon: Icons.trash; active: true; clicked => { Shell.uninstall(Settings.info-id); } }
        }
        InfoItem { first: true; label: "Storage"; value: Settings.info-android ? "Managed by Android" : "Part of Cheip OS"; }
        InfoItem { label: "Notifications"; value: "Allowed"; }
        InfoItem { last: true; label: "Version"; value: Settings.info-android ? "From Waydroid" : Sys.version; }
    }

    // Sfondo e stile, come sui Pixel
    Page {
        x: Settings.page == "style" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: Theme.spatial; easing: Theme.ease; }
        title: "Wallpaper & style";
        // Anteprima: blocco e home affiancati
        HorizontalLayout {
            height: 280px; spacing: 12px; alignment: center;
            for k[i] in 2: Rectangle {
                width: 138px; border-radius: 22px; clip: true;
                border-width: 1px; border-color: Theme.outline-variant;
                Image { width: parent.width; height: parent.height; source: Style.wallpapers[Style.wallpaper]; image-fit: cover; }
                if i == 0: Text { y: 40px; width: parent.width; text: Sys.hours + "\n" + Sys.minutes; color: Style.wp-accent; font-family: Theme.display; font-size: 50px; font-weight: 500; horizontal-alignment: center; }
                if i == 1: GridLayout {
                    x: 12px; y: 90px; width: parent.width - 24px; spacing: 8px;
                    Row { for a in [Icons.phone-f, Icons.message-f, Icons.camera-f]: Rectangle {
                        height: 32px;
                        Path { width: 32px; height: 32px; commands: Style.icon-shape == 0 ? Shapes.circle : Style.icon-shape == 1 ? Shapes.squircle : Style.icon-shape == 2 ? Shapes.cookie : Style.icon-shape == 3 ? Shapes.clover : Shapes.sunny; viewbox-width: 100; viewbox-height: 100; fill: Style.icon-pack == 2 ? Theme.container-highest : Theme.primary-container; }
                        Icon { d: a; size: 16px; tint: Style.icon-pack == 2 ? Theme.on-surface : Theme.on-primary-container; }
                    } }
                    Row { for a in [Icons.clock-f, Icons.gear-f, Icons.folder-f]: Rectangle {
                        height: 32px;
                        Path { width: 32px; height: 32px; commands: Style.icon-shape == 0 ? Shapes.circle : Style.icon-shape == 1 ? Shapes.squircle : Style.icon-shape == 2 ? Shapes.cookie : Style.icon-shape == 3 ? Shapes.clover : Shapes.sunny; viewbox-width: 100; viewbox-height: 100; fill: Style.icon-pack == 2 ? Theme.container-highest : Theme.primary-container; }
                        Icon { d: a; size: 16px; tint: Style.icon-pack == 2 ? Theme.on-surface : Theme.on-primary-container; }
                    } }
                }
            }
        }
        Header { text: "   Wallpaper"; }
        Flickable {
            height: 132px; content-width: Style.wallpapers.length * 92px + 8px;
            for w[i] in Style.wallpapers: Rectangle {
                x: 4px + i * 92px; y: 4px; width: 84px; height: 124px;
                border-radius: i == Style.wallpaper ? 28px : 16px; clip: true;
                border-width: i == Style.wallpaper ? 3px : 0px; border-color: Theme.primary;
                animate border-radius { duration: 380ms; easing: spring(0.3); }
                Image { width: parent.width; height: parent.height; source: w; image-fit: cover; }
                TouchArea { clicked => { Style.set-wallpaper(i); } }
            }
        }
        Header { text: "   Color palette"; }
        Flickable {
            height: 84px; content-width: Style.swatches.length * 76px + 8px;
            for s[i] in Style.swatches: Rectangle {
                x: 4px + i * 76px; y: 4px; width: 68px; height: 68px;
                border-radius: s.selected ? 22px : 34px;
                background: Theme.container-high;
                animate border-radius { duration: 380ms; easing: spring(0.3); }
                Rectangle {
                    width: 52px; height: 52px; border-radius: 26px; clip: true;
                    Rectangle { x: 0; y: 0; width: 52px; height: 26px; background: s.primary; }
                    Rectangle { x: 0; y: 26px; width: 26px; height: 26px; background: s.secondary; }
                    Rectangle { x: 26px; y: 26px; width: 26px; height: 26px; background: s.tertiary; }
                }
                if s.selected: Rectangle {
                    x: 44px; y: 44px; width: 22px; height: 22px; border-radius: 11px; background: Theme.primary;
                    Icon { d: Icons.check; size: 16px; tint: Theme.on-primary; }
                }
                TouchArea { clicked => { Style.set-palette(s.id); } }
            }
        }
        Header { text: "   Color style"; }
        Segmented { items: ["Tonal", "Vibrant", "Expressive", "Neutral", "Mono"]; selected: Style.scheme; height: 48px; picked(i) => { Style.set-scheme(i); } }
        Header { text: "   Theme"; }
        Segmented { items: ["Dark", "Light", "Auto"]; selected: Style.theme-mode; height: 48px; picked(i) => { Style.set-theme(i); } }
        Header { text: "   Icon shape"; }
        HorizontalLayout {
            height: 72px; spacing: 8px;
            for sh[i] in [Shapes.circle, Shapes.squircle, Shapes.cookie, Shapes.clover, Shapes.sunny]: Rectangle {
                border-radius: 20px;
                background: Style.icon-shape == i ? Theme.secondary-container : Theme.container-high;
                animate background { duration: 200ms; }
                Path {
                    width: 40px; height: 40px; commands: sh; viewbox-width: 100; viewbox-height: 100;
                    fill: Style.icon-shape == i ? Theme.primary : Theme.on-surface-variant;
                    transform-rotation: Style.icon-shape == i ? 0deg : -30deg;
                    animate transform-rotation { duration: 500ms; easing: spring(0.4); }
                }
                TouchArea { clicked => { Style.set-icon-shape(i); } }
            }
        }
        Header { text: "   Icon pack"; }
        for p[i] in [{ l: "Themed", d: "Icons follow your wallpaper colors" }, { l: "Colorful", d: "Each app with its own color" }, { l: "Monochrome", d: "Neutral icons, no color" }, { l: "Outline", d: "Thin outline, transparent" }]: RadioRow {
            first: i == 0; last: i == 3;
            label: p.l; on: Style.icon-pack == i;
            clicked => { Style.set-icon-pack(i); }
        }
    }
}
