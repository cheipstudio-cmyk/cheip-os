import { Theme } from "theme.slint";
import { Sys, Settings, Phone, Shell } from "data.slint";
import { Icon, Icons, StatusBar, RoundButton, PillButton, Card, Title, ListRow, Field } from "components.slint";

component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 48px; height: 28px; border-radius: 14px;
    background: root.on ? Theme.accent : Theme.raised;
    animate background { duration: Theme.fast; }
    Rectangle {
        x: root.on ? 22px : 2px; y: 2px; width: 24px; height: 24px; border-radius: 12px;
        background: root.on ? #000 : Theme.muted;
        animate x { duration: Theme.fast; easing: Theme.ease; }
    }
    TouchArea { clicked => { root.toggled(); } }
}

component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();
    height: 56px;
    Text { x: 0; height: parent.height; text: root.label; color: Theme.text; font-family: Theme.body; font-size: 15px; vertical-alignment: center; }
    Switch { x: parent.width - 48px; on: root.on; toggled => { root.toggled(); } }
}

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 44px;
    Text { x: 0; height: parent.height; text: root.label; color: Theme.muted; font-family: Theme.body; font-size: 14px; vertical-alignment: center; }
    Text { x: parent.width - self.width; height: parent.height; text: root.value; color: Theme.text; font-family: Theme.body; font-size: 14px; vertical-alignment: center; }
}

component Slider inherits Rectangle {
    in property <string> glyph;
    in-out property <float> value;
    callback changed(float);
    height: 40px; border-radius: 20px; background: Theme.raised; clip: true;
    Rectangle { x: 0; width: max(40px, parent.width * root.value); border-radius: 20px; background: Theme.text; }
    Icon { x: 12px; d: root.glyph; size: 18px; tint: #000; }
    TouchArea {
        moved => { root.value = max(0.02, min(1.0, self.mouse-x / self.width)); root.changed(root.value); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { root.value = max(0.02, min(1.0, self.mouse-x / self.width)); root.changed(root.value); }
        }
    }
}

component Page inherits Rectangle {
    in property <string> title;
    background: Theme.bg;
    StatusBar { y: 0; width: parent.width; }
    RoundButton { x: 8px; y: 30px; icon: Icons.back; outlined: false; clicked => { Settings.page = ""; } }
    Text {
        x: 56px; y: 30px; height: 44px;
        text: root.title; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 24px;
        vertical-alignment: center;
    }
    Flickable {
        x: 16px; y: 88px; width: parent.width - 32px; height: parent.height - 88px - 28px;
        content-height: body.preferred-height + 16px;
        body := VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: 4px;
            @children
        }
    }
}

export component SettingsApp inherits Rectangle {
    background: Theme.bg;
    property <string> pw-ssid;
    property <string> pw;

    Rectangle {
        // Elenco principale: arretra e si scurisce quando entra una sottopagina
        x: Settings.page == "" ? 0px : -root.width * 0.25;
        opacity: Settings.page == "" ? 1 : 0.0;
        animate x { duration: 380ms; easing: Theme.ease; }
        animate opacity { duration: 260ms; }
        StatusBar { y: 0; width: parent.width; }
        Title { x: 16px; y: 34px; text: "Settings"; }
        Flickable {
            x: 16px; y: 88px; width: parent.width - 32px; height: parent.height - 88px - 28px;
            content-height: list.preferred-height + 16px;
            list := VerticalLayout {
                width: parent.width; alignment: start;
                ListRow { icon: Icons.wifi; label: "Wi-Fi"; detail: Sys.wifi-on ? "On" : "Off"; clicked => { Settings.open-page("wifi"); } }
                ListRow { icon: Icons.bluetooth; label: "Bluetooth"; detail: Sys.bt-on ? "On" : "Off"; clicked => { Settings.open-page("bt"); } }
                ListRow { icon: Icons.data; label: "Mobile network"; detail: Phone.modem-ok ? Settings.modem-operator : "Modem not available"; clicked => { Settings.open-page("mobile"); } }
                ListRow { icon: Icons.sun; label: "Display"; detail: "Brightness, accent color"; clicked => { Settings.open-page("display"); } }
                ListRow { icon: Icons.speaker; label: "Sound"; detail: round(Sys.volume * 100) + "%"; clicked => { Settings.open-page("sound"); } }
                ListRow { icon: Icons.battery; label: "Battery"; detail: Sys.battery + "%" + (Sys.charging ? " charging" : ""); clicked => { Settings.open-page("battery"); } }
                ListRow { icon: Icons.disk; label: "Storage and memory"; detail: Settings.storage-used + " of " + Settings.storage-total; clicked => { Settings.open-page("storage"); } }
                ListRow { icon: Icons.android; label: "Android apps"; detail: Sys.android-running ? "Running" : "Suspended"; clicked => { Settings.open-page("android"); } }
                ListRow { icon: Icons.clock; label: "Date and time"; detail: Settings.timezone; clicked => { Settings.open-page("time"); } }
                ListRow { icon: Icons.update; label: "Updates"; detail: Sys.update-available ? "Available: " + Sys.update-version : "Version " + Sys.version; clicked => { Settings.open-page("update"); } }
                ListRow { icon: Icons.info; label: "About phone"; detail: Sys.model; clicked => { Settings.open-page("about"); } }
            }
        }
    }

    Page {
        x: Settings.page == "wifi" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Wi-Fi";
        SwitchRow { label: "Wi-Fi"; on: Sys.wifi-on; toggled => { Sys.toggle("wifi"); } }
        HorizontalLayout {
            height: 44px; spacing: 8px;
            Text { text: Settings.wifi-busy ? "Scanning…" : Settings.wifi-msg; color: Theme.muted; font-family: Theme.body; font-size: 13px; vertical-alignment: center; }
            RoundButton { icon: Icons.refresh; outlined: false; clicked => { Settings.wifi-scan(); } }
        }
        for n in Settings.networks: Rectangle {
            height: root.pw-ssid == n.ssid ? 160px : 56px;
            animate height { duration: Theme.fast; easing: Theme.ease; }
            Rectangle {
                y: 6px; width: 36px; height: 36px; x: 0; border-radius: 18px;
                background: n.active ? Theme.accent : Theme.raised;
                Icon { d: Icons.wifi; size: 18px; tint: n.active ? #000 : (n.signal > 50 ? Theme.text : Theme.muted); }
            }
            Text { x: 50px; y: 6px; height: 36px; text: n.ssid; color: Theme.text; font-family: Theme.body; font-size: 15px; vertical-alignment: center; }
            if n.secure: Icon { x: parent.width - 20px; y: 15px; d: Icons.lock; size: 16px; tint: Theme.faint; }
            TouchArea {
                height: 48px; y: 0;
                clicked => {
                    if (n.active) { return; }
                    if (n.secure) { root.pw-ssid = root.pw-ssid == n.ssid ? "" : n.ssid; root.pw = ""; }
                    else { Settings.wifi-connect(n.ssid, ""); }
                }
            }
            if root.pw-ssid == n.ssid: VerticalLayout {
                y: 56px; height: 96px; spacing: 8px;
                Field { placeholder: "Password"; kind: InputType.password; text <=> root.pw; }
                HorizontalLayout {
                    alignment: end;
                    PillButton { label: "Connect"; solid: true; clicked => { Settings.wifi-connect(n.ssid, root.pw); root.pw-ssid = ""; } }
                }
            }
        }
    }

    Page {
        x: Settings.page == "bt" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Bluetooth";
        SwitchRow { label: "Bluetooth"; on: Sys.bt-on; toggled => { Sys.toggle("bt"); } }
        Text { text: "Paired devices"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 32px; vertical-alignment: bottom; }
        for d in Settings.bt-devices: ListRow { icon: Icons.bluetooth; label: d; chevron: false; }
        if Settings.bt-devices.length == 0: Text { text: "None"; color: Theme.faint; font-family: Theme.body; font-size: 14px; height: 40px; vertical-alignment: center; }
    }

    Page {
        x: Settings.page == "mobile" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Mobile network";
        SwitchRow { label: "Dati mobili"; on: Sys.data-on; toggled => { Sys.toggle("dati"); } }
        InfoRow { label: "Carrier"; value: Phone.modem-ok ? Settings.modem-operator : "None"; }
        InfoRow { label: "Signal"; value: Settings.modem-signal; }
        InfoRow { label: "Status"; value: Phone.modem-ok ? Settings.modem-state : Phone.modem-label; }
    }

    Page {
        x: Settings.page == "display" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Display";
        Text { text: "Brightness"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 28px; vertical-alignment: bottom; }
        Slider { glyph: Icons.sun; value: Sys.brightness; changed(v) => { Sys.brightness = v; Sys.brightness-changed(v); } }
        Text { text: "Accent color"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 40px; vertical-alignment: bottom; }
        HorizontalLayout {
            spacing: 12px; alignment: start; height: 56px; padding-top: 8px;
            for c in [#c6ff3d, #ff7a1a, #3da9ff, #ff4fa3, #b18cff]: Rectangle {
                width: 44px; height: 44px; border-radius: 22px;
                background: c;
                border-width: Theme.accent == c ? 3px : 0px;
                border-color: Theme.text;
                TouchArea { clicked => { Theme.accent = c; } }
            }
        }
        InfoRow { label: "Theme"; value: "AMOLED black"; }
    }

    Page {
        x: Settings.page == "sound" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Sound";
        Text { text: "Volume"; color: Theme.muted; font-family: Theme.body; font-size: 12px; height: 28px; vertical-alignment: bottom; }
        Slider { glyph: Icons.speaker; value: Sys.volume; changed(v) => { Sys.volume = v; Sys.volume-changed(v); } }
    }

    Page {
        x: Settings.page == "battery" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Battery";
        Text { text: Sys.battery + "%"; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 56px; height: 72px; }
        Rectangle {
            height: 12px; border-radius: 6px; background: Theme.raised; clip: true;
            Rectangle { x: 0; width: parent.width * Sys.battery / 100; background: Sys.battery <= 15 ? #ff6b6b : Theme.accent; }
        }
        InfoRow { label: "Status"; value: Sys.charging ? "Charging" : "Discharging"; }
        SwitchRow { label: "Battery saver"; on: Sys.eco-on; toggled => { Sys.toggle("eco"); } }
    }

    Page {
        x: Settings.page == "storage" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Storage";
        Text { text: Settings.storage-used + " of " + Settings.storage-total; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 26px; height: 44px; }
        Rectangle {
            height: 12px; border-radius: 6px; background: Theme.raised; clip: true;
            Rectangle { x: 0; width: parent.width * Settings.storage-ratio; background: Theme.text; }
        }
        Rectangle { height: 16px; }
        InfoRow { label: "RAM"; value: Sys.mem-used + " / " + Sys.mem-total + " MB"; }
        InfoRow { label: "Used by Android apps"; value: Sys.mem-android + " MB"; }
    }

    Page {
        x: Settings.page == "android" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Android apps";
        InfoRow { label: "Android layer"; value: Sys.android-running ? "Running" : "Suspended"; }
        Text { text: Sys.android-state; color: Theme.muted; font-family: Theme.body; font-size: 13px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start; padding-top: 12px; height: 46px;
            PillButton { label: Sys.android-running ? "Suspend" : "Start"; solid: true; clicked => { Sys.android-toggle(); } }
        }
    }

    Page {
        x: Settings.page == "time" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Date and time";
        InfoRow { label: "Time"; value: Sys.time; }
        InfoRow { label: "Date"; value: Sys.date; }
        InfoRow { label: "Time zone"; value: Settings.timezone; }
        Text { text: "Time and date are set automatically from the network."; color: Theme.faint; font-family: Theme.body; font-size: 12px; wrap: word-wrap; height: 40px; vertical-alignment: bottom; }
    }

    Page {
        x: Settings.page == "update" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "Updates";
        Text { text: Sys.update-available ? "Cheip OS " + Sys.update-version : "Cheip OS " + Sys.version; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 26px; height: 44px; }
        Text { text: Sys.update-state; color: Theme.muted; font-family: Theme.body; font-size: 13px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start; padding-top: 16px; height: 50px;
            PillButton {
                label: Sys.update-available ? "Install" : "Check";
                solid: true;
                clicked => { if (Sys.update-available) { Sys.install-update(); } else { Sys.check-update(); } }
            }
        }
    }

    Page {
        x: Settings.page == "appinfo" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "App info";
        Rectangle {
            height: 150px;
            Rectangle {
                x: (parent.width - 80px) / 2; y: 8px; width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
                if Settings.info-glyph != "": Icon { d: Settings.info-glyph; size: 34px; weight: 1.8px; }
            }
            Text { y: 100px; width: parent.width; text: Settings.info-name; color: Theme.text; font-family: Theme.display; font-weight: 700; font-size: 22px; horizontal-alignment: center; }
            Text { y: 128px; width: parent.width; text: Settings.info-kind; color: Theme.muted; font-family: Theme.body; font-size: 13px; horizontal-alignment: center; }
        }
        HorizontalLayout {
            alignment: center; spacing: 10px; height: 52px; padding-top: 8px;
            PillButton { label: "Open"; solid: true; clicked => { Shell.open-app(Settings.info-id, root.width / 2 - 28px, 300px, 56px); } }
            if Settings.info-android: PillButton { label: "Uninstall"; clicked => { Shell.uninstall(Settings.info-id); } }
        }
        InfoRow { label: "Storage"; value: Settings.info-android ? "Managed by Android" : "Part of Cheip OS"; }
        InfoRow { label: "Version"; value: Settings.info-android ? "From Waydroid" : Sys.version; }
    }

    Page {
        x: Settings.page == "about" ? 0px : root.width;
        visible: self.x < root.width;
        animate x { duration: 380ms; easing: Theme.ease; }
        title: "About phone";
        InfoRow { label: "Model"; value: Sys.model; }
        InfoRow { label: "Cheip OS"; value: Sys.version; }
        InfoRow { label: "Kernel"; value: Sys.kernel; }
        InfoRow { label: "Memory"; value: Sys.mem-total + " MB"; }
    }
}
