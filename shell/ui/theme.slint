import "../fonts/Inter-Regular.ttf";
import "../fonts/Inter-SemiBold.ttf";
import "../fonts/SpaceGrotesk-Medium.ttf";
import "../fonts/SpaceGrotesk-Bold.ttf";

export global Theme {
    in-out property <color> accent: #c6ff3d;
    out property <color> bg: #000000;
    out property <color> surface: #0d0d0d;
    out property <color> raised: #1a1a1a;
    out property <color> line: #2a2a2a;
    out property <color> text: #ffffff;
    out property <color> muted: #9a9a9a;
    out property <color> faint: #5f5f5f;
    out property <string> body: "Inter";
    out property <string> display: "Space Grotesk";
    // Una sola curva per tutto il sistema
    out property <easing> ease: cubic-bezier(0.2, 0.9, 0.1, 1);
    out property <duration> slow: 420ms;
    out property <duration> fast: 180ms;
}
