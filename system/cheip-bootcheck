#!/sbin/openrc-run
# Se la shell non resta su, scrive sullo schermo cosa e' andato storto
# (sul Lumia l'USB non c'e' ancora: lo schermo e' l'unico modo di vederlo).

description="Cheip OS boot check"

depend() {
	after cheip-shell
}

start() {
	(
		sleep 25
		if pidof cheip-shell >/dev/null 2>&1 && [ "$(grep -c 'panicked\|Error' /var/log/cheip-shell.log 2>/dev/null)" = 0 ]; then
			exit 0
		fi
		{
			printf '\033[2J\033[H\033[?25h'
			echo "CHEIP OS: the interface did not start. Take a photo of this screen."
			echo
			echo "== service =="; rc-service cheip-shell status 2>&1 | tail -3
			echo "== shell log =="; tail -n 22 /var/log/cheip-shell.log 2>&1
			echo "== screen/input =="; ls -l /dev/dri 2>&1 | tail -3; ls /dev/input 2>&1 | tr '\n' ' '; echo
			echo "== user =="; id "$(getent group wheel | cut -d: -f4 | cut -d, -f1)" 2>&1
			echo "== kernel =="; dmesg 2>/dev/null | grep -iE 'drm|simple|fb|panic|cheip' | tail -n 6
		} > /dev/tty1 2>&1
	) >/dev/null 2>&1 &
	return 0
}
