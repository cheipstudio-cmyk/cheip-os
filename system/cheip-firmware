#!/bin/sh
# Lumia 735: the Wi-Fi firmware is not free to redistribute, but the phone
# already has it in its Windows Phone partition. Copy it once from MainOS
# (read only) and start the Wi-Fi core. Everything goes to the Log app.
FW=/lib/firmware/qcom/msm8926/microsoft/superman
NV=/lib/firmware/wlan/prima/WCNSS_qcom_wlan_nv.bin
LOG=/var/log/cheip-firmware.txt
exec >"$LOG" 2>&1

partdev() {
	for u in /sys/class/block/*/uevent; do
		if grep -qx "PARTNAME=$1" "$u"; then
			echo "/dev/$(grep '^DEVNAME=' "$u" | cut -d= -f2)"
			return
		fi
	done
}

if [ ! -s "$FW/wcnss.mbn" ] || [ ! -s "$NV" ]; then
	modprobe ntfs3 2>/dev/null
	modprobe vfat 2>/dev/null
	mkdir -p /mnt/wp "$FW" "$(dirname "$NV")"
	: > /tmp/cheip-fw.txt
	# The Windows Phone partitions that can hold subsystem firmware
	for part in MainOS PLAT EFIESP DPP; do
		DEV=$(partdev "$part")
		echo "$part: ${DEV:-not found}"
		[ -n "$DEV" ] || continue
		mount -o ro "$DEV" /mnt/wp 2>/dev/null || mount -t ntfs3 -o ro "$DEV" /mnt/wp || { echo "$part: mount failed"; continue; }
		echo "$part top: $(ls /mnt/wp | head -n 12 | tr '\n' ' ')"
		# Folder names differ in case between Windows builds: whole partition, any case
		find /mnt/wp \( -iname '*wcnss*' -o -iname '*pronto*' -o -iname '*wlan*nv*' -o -iname '*qcwlan*' -o -iname '*riva*' \) 2>/dev/null | tee -a /tmp/cheip-fw.txt | head -n 12
		# Every firmware image on the partition, to find the Wi-Fi one if the name differs
		echo "$part firmware images: $(find /mnt/wp \( -iname '*.mbn' -o -iname '*.mdt' -o -iname '*.b00' \) 2>/dev/null | sed 's#.*/##' | sort -u | head -n 40 | tr '\n' ' ')"
		mbn=$(grep -iE '(wcnss|pronto|riva)[^/]*\.(mbn|mdt)$' /tmp/cheip-fw.txt | head -n 1)
		nv=$(grep -iE 'wlan[^/]*nv[^/]*\.bin$' /tmp/cheip-fw.txt | head -n 1)
		[ -n "$mbn" ] && [ ! -s "$FW/wcnss.mbn" ] && cp "$mbn" "$FW/wcnss.mbn" && echo "copied $mbn"
		[ -n "$nv" ] && [ ! -s "$NV" ] && cp "$nv" "$NV" && echo "copied $nv"
		umount /mnt/wp
	done
	echo "candidates found: $(wc -l < /tmp/cheip-fw.txt)"
fi

modprobe qcom_wcnss_pil 2>/dev/null
modprobe wcn36xx 2>/dev/null
for r in /sys/class/remoteproc/remoteproc*; do
	[ -e "$r/name" ] || continue
	echo "remoteproc $(cat "$r/name"): $(cat "$r/state")"
	if grep -q pronto "$r/name" 2>/dev/null || grep -qi wcnss "$r/firmware" 2>/dev/null; then
		[ "$(cat "$r/state")" = offline ] && echo start > "$r/state"
	fi
done
sleep 15
for r in /sys/class/remoteproc/remoteproc*; do
	[ -e "$r/name" ] && echo "after start: $(cat "$r/name"): $(cat "$r/state")"
done
dmesg | grep -iE "wcnss|pronto|wcn36xx|remoteproc|scm" | tail -n 15
ip -o link | cut -d: -f2 | tr '\n' ' '
echo
