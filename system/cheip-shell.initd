#!/sbin/openrc-run
# Servizio OpenRC della shell. supervise-daemon la riavvia se crasha.

name="Cheip OS shell"
description="Interfaccia di sistema di Cheip OS"

: ${cheip_user:=$(getent group wheel | cut -d: -f4 | cut -d, -f1)}

supervisor=supervise-daemon
command="/usr/libexec/cheip/cheip-session"
command_user="${cheip_user}"
output_log="/var/log/cheip-shell.log"
error_log="/var/log/cheip-shell.log"
respawn_delay=2
respawn_max=0

depend() {
	need localmount
	after udev networkmanager
}

start_pre() {
	if [ -z "$cheip_user" ]; then
		eerror "Nessun utente nel gruppo wheel: imposta cheip_user in /etc/conf.d/cheip-shell"
		return 1
	fi
	# Schermo, tocco e tasti: la shell disegna direttamente su DRM e legge evdev
	for g in video input audio tty; do addgroup "$cheip_user" "$g" >/dev/null 2>&1; done
	chmod 666 /dev/dri/card* /dev/input/event* /dev/tty0 /dev/tty1 2>/dev/null
	# Il login testuale su tty1 non deve contendere lo schermo alla shell
	if grep -q '^tty1::' /etc/inittab 2>/dev/null; then
		sed -i 's/^tty1::/#tty1::/' /etc/inittab
		kill -HUP 1 2>/dev/null
	fi
	pkill -f 'getty.*tty1' 2>/dev/null
	printf '\033[2J\033[H\033[?25l' > /dev/tty1 2>/dev/null
	# Charger, battery ADC and power key drivers (no-op if built in or missing)
	for m in qcom_smbb qcom_spmi_vadc pm8941_pwrkey; do modprobe "$m" 2>/dev/null; done
	# Charging: the charger may start with the 100 mA USB default, less than the
	# phone uses. Allow 1 A from USB/wall and 1 A into the 2220 mAh battery (0.45 C)
	# The PMIC goes back to its low default limit every time the cable is plugged
	# in, so the limits are applied again every 10 s, not only at boot
	( sleep 8
	  while :; do
		for p in smbb-usbin smbb-dcin; do
			f=/sys/class/power_supply/$p/charge_control_limit
			[ -w "$f" ] && [ "$(cat "$f" 2>/dev/null)" != 1000000 ] && echo 1000000 > "$f"
		done
		f=/sys/class/power_supply/smbb-bif/current_max
		[ -w "$f" ] && [ "$(cat "$f" 2>/dev/null)" != 1000000 ] && echo 1000000 > "$f"
		for p in /sys/class/power_supply/smbb-*; do
			echo "$(basename "$p"): limit $(cat "$p"/charge_control_limit 2>/dev/null) max $(cat "$p"/current_max 2>/dev/null) status $(cat "$p"/status 2>/dev/null) health $(cat "$p"/health 2>/dev/null) type $(cat "$p"/charge_type 2>/dev/null) online $(cat "$p"/online 2>/dev/null)"
		done > /var/log/cheip-charger.txt
		# Stop voltage really in use (the PMIC clamps it to its safe limit) and
		# the charger driver's own messages
		echo "stop voltage $(cat /sys/class/power_supply/smbb-bif/voltage_max 2>/dev/null) uV, present $(cat /sys/class/power_supply/smbb-bif/present 2>/dev/null)" >> /var/log/cheip-charger.txt
		dmesg 2>/dev/null | grep -i smbb | tail -n 3 | cut -c1-110 >> /var/log/cheip-charger.txt
		# PMIC charger registers (CHGR 0x10xx, BAT_IF 0x12xx, USB 0x13xx): what the
		# hardware itself thinks, read through the regmap debugfs
		if [ ! -s /var/log/cheip-charger-regs.txt ]; then
			mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
			for r in /sys/kernel/debug/regmap/*/registers; do
				grep -qE "^1049:" "$r" 2>/dev/null || continue
				grep -E "^(1008|1009|100a|1010|1040|1041|1044|1045|1047|1049|104a|1052|105d|1208|1209|1210|1249|1308|1309|1310|1340|1342|1344|1346|1347):" "$r" | tr '\n' ' ' > /var/log/cheip-charger-regs.txt
				break
			done
		fi
		echo "regs $(cat /var/log/cheip-charger-regs.txt 2>/dev/null)" >> /var/log/cheip-charger.txt
		sleep 10
	  done ) >/dev/null 2>&1 &
	# Fastest CPU clock available: the UI renders on the CPU. cpufreq-dt may load
	# late, so try again in the background for a minute
	( for i in 1 2 3 4 5 6; do
		for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
			# schedutil: full speed while drawing or loading, low clock when idle,
			# so the charger is not eaten by four cores pinned at maximum
			[ -w "$f" ] && { echo schedutil > "$f" 2>/dev/null || echo ondemand > "$f"; }
		done
		# 787 MHz: the highest speed with a known-safe voltage on this chip
		max=787200; rm -f /etc/cheip/boost 2>/dev/null
		for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
			[ -w "$f" ] && echo "$max" > "$f"
		done
		sleep 10
	done ) >/dev/null 2>&1 &
	# Why only one core: kernel lines about the secondary CPUs, shown in the diagnostics
	dmesg 2>/dev/null | grep -iE "smp|secondary|cpu[123]|scm|boot address" | tail -n 3 | cut -c1-90 | tr '\n' ' ' > /var/log/cheip-smp.txt
	chmod 644 /var/log/cheip-smp.txt
	# First boot: the root partition is as big as the image (about 600 MB).
	# Grow it to the whole microSD or the whole internal partition, once
	if [ ! -e /var/lib/cheip/grown ]; then
		( root=$(findmnt -no SOURCE /)
		  disk=/dev/$(lsblk -no PKNAME "$root")
		  part=$(cat /sys/class/block/$(basename "$root")/partition)
		  growpart "$disk" "$part" && resize2fs "$root" && mkdir -p /var/lib/cheip && touch /var/lib/cheip/grown
		) > /var/log/cheip-grow.txt 2>&1 &
	fi
	# GPU (render only, the screen stays on simpledrm): once per boot, after the
	# shell has had time to start
	if [ ! -e /run/cheip-gpu-started ]; then
		touch /run/cheip-gpu-started
		( sleep 15; /usr/libexec/cheip/cheip-gpu ) >/dev/null 2>&1 &
	fi
	# Log page for the PC over the USB network: http://172.16.42.1
	# Plain files only (no CGI): a report rebuilt every 20 s in the background,
	# so a slow command can never leave the browser waiting
	if [ ! -e /run/cheip-httpd-started ]; then
		touch /run/cheip-httpd-started
		mkdir -p /run/cheip-www
		cp /usr/share/cheip/www/index.html /run/cheip-www/
		( /usr/libexec/cheip/cheip-report >/dev/null 2>&1 & 
		for i in $(seq 1 60); do
			ip -4 addr show 2>/dev/null | grep -q "172.16.42.1/" && break
			sleep 2
		done
		httpd -p 172.16.42.1:80 -h /run/cheip-www ) >/dev/null 2>&1 &
	fi
	uid=$(id -u "$cheip_user")
	mkdir -p "/run/user/$uid"
	chown "$cheip_user" "/run/user/$uid"
	chmod 700 "/run/user/$uid"
	touch /var/log/cheip-shell.log
	chown "$cheip_user" /var/log/cheip-shell.log
	return 0
}
