#!/bin/sh
# Cheip OS USB link to the PC: one composite gadget with
#  - a serial port (CDC ACM): the installer site reads it with Web Serial and
#    saves what the phone prints (kernel log, Cheip logs) to Downloads
#  - a network port (CDC NCM): the phone is 172.16.42.1, the PC gets an address
LOG=/var/log/cheip-usb.txt
exec >"$LOG" 2>&1
set -x
modprobe libcomposite; modprobe usb_f_acm; modprobe usb_f_ncm
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
G=/sys/kernel/config/usb_gadget

# Wait for the USB controller (it needs the charger driver for cable detection)
i=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 60 ]; do sleep 1; i=$((i+1)); done
UDC=$(ls /sys/class/udc | head -n 1)
echo "udc: ${UDC:-none} after ${i}s"
[ -n "$UDC" ] || exit 0

# Free the controller from the gadget left by the initramfs
for g in "$G"/*; do
	[ -f "$g/UDC" ] && [ "$(basename "$g")" != cheip ] && echo "" > "$g/UDC" 2>/dev/null
done

if [ ! -d "$G/cheip" ]; then
	mkdir -p "$G/cheip" && cd "$G/cheip" || exit 1
	echo 0x1d6b > idVendor
	echo 0x0104 > idProduct
	echo 0x0200 > bcdUSB
	# Composite with interface association (Windows binds each function)
	echo 0xEF > bDeviceClass; echo 0x02 > bDeviceSubClass; echo 0x01 > bDeviceProtocol
	mkdir -p strings/0x409
	echo "cheip-735" > strings/0x409/serialnumber
	echo "Cheip Studio" > strings/0x409/manufacturer
	echo "Cheip OS" > strings/0x409/product
	mkdir -p configs/c.1/strings/0x409
	echo "Serial + network" > configs/c.1/strings/0x409/configuration
	echo 500 > configs/c.1/MaxPower
	mkdir -p functions/acm.GS0 functions/ncm.cheip
	ln -s functions/acm.GS0 configs/c.1/
	ln -s functions/ncm.cheip configs/c.1/
fi
echo "$UDC" > "$G/cheip/UDC"
cat "/sys/class/udc/$UDC/state"

IF=$(cat "$G/cheip/functions/ncm.cheip/ifname")
ip addr add 172.16.42.1/24 dev "$IF" 2>/dev/null
ip link set "$IF" up
cat > /run/cheip-udhcpd.conf <<CONF
start 172.16.42.2
end 172.16.42.20
interface $IF
option subnet 255.255.255.0
CONF
udhcpd -f /run/cheip-udhcpd.conf &

# Every 15 s: what the phone is doing, on the serial port
while true; do
	{
		echo "===== Cheip OS $(cat /etc/cheip-version 2>/dev/null) $(date) ====="
		echo "cpus online: $(cat /sys/devices/system/cpu/online)"
		for f in /var/log/cheip-*.txt; do echo "--- $f"; tail -n 30 "$f"; done
		echo "--- dmesg"
		dmesg | tail -n 120
	} > /dev/ttyGS0 2>/dev/null
	sleep 15
done
